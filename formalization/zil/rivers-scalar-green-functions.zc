RULE verified_claim:
IF ?claim#kind@entity:theorem AND ?claim#formalized_by@?proof AND ?proof#verification@state:kernel_checked
THEN ?claim#status@status:proved.

RULE pending_claim:
IF ?claim#kind@entity:theorem AND ?claim#formalized_by@?proof AND ?proof#verification@state:pending_ci
THEN ?claim#status@status:pending.

RULE boundary_claim:
IF ?claim#kind@entity:theorem AND ?claim#target_state@?boundary
THEN ?claim#status@?boundary.

QUERY claim_statuses:
FIND ?claim ?status WHERE ?claim#status@?status.

QUERY proof_registry:
FIND ?claim ?proof WHERE ?claim#formalized_by@?proof.

QUERY dependency_edges:
FIND ?claim ?dependency WHERE ?claim#requires@?dependency.

QUERY reused_components:
FIND ?claim ?component WHERE ?claim#uses@?component.

QUERY source_traceability:
FIND ?claim ?source WHERE ?claim#supported_by@?source.

QUERY open_boundaries:
FIND ?claim ?boundary WHERE ?claim#target_state@?boundary.
