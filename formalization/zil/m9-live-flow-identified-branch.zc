MODULE physlib.m9.live_flow_identified_branch.

criterion:particle_stability#kind@entity:criterion.
claim:free_h_one_schrodinger_group#kind@entity:theorem.
claim:free_h_one_schrodinger_group#formalized_by@proof:Physlib.QuantumMechanics.ComplexAction.EntropicTime.CubicQuinticConstructedCertificates.freeHOneStrongUnitaryGroupCertificate.
claim:compact_uniformly_stable_minimizing_orbit#kind@entity:theorem.
claim:compact_uniformly_stable_minimizing_orbit#formalized_by@proof:Physlib.QuantumMechanics.ComplexAction.EntropicTime.CubicQuinticMildFlow.exists_minimizingOrbit_uniformlyStable.
claim:identified_minimizing_branch_constructor#kind@entity:theorem.
claim:identified_minimizing_branch_constructor#formalized_by@proof:Physlib.QuantumMechanics.ComplexAction.EntropicTime.CubicQuinticConstructedCertificates.exists_identifiedStableMinimizingBranch.
criterion:particle_stability#supported_by@claim:free_h_one_schrodinger_group.
criterion:particle_stability#supported_by@claim:compact_uniformly_stable_minimizing_orbit.
criterion:particle_stability#supported_by@claim:identified_minimizing_branch_constructor.
criterion:particle_stability#requires@evidence:openwave_constructed_target_flow.
criterion:particle_stability#requires@evidence:openwave_mass_energy_perturbation_tube.
criterion:particle_stability#requires@evidence:openwave_standing_wave_branch_orbit.
criterion:particle_stability#boundary@obligation:physical_particle_identity_and_calibration.
criterion:particle_stability#boundary@obligation:external_experimental_validation.

QUERY particle_stability_support:
FIND ?claim WHERE criterion:particle_stability#supported_by@?claim.

QUERY retained_boundaries:
FIND ?obligation WHERE criterion:particle_stability#boundary@?obligation.
