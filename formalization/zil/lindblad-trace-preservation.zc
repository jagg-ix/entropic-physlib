MODULE physlib.quantum.open_systems.lindblad_trace_preservation.

// Trace-preservation proof graph for the finite Hilbert--Schmidt LDDL
// generator. Lean is the proof authority; ZIL tracks dependencies and impact.

component:linear_map_trace#kind@entity:component.
component:linear_map_trace#provided_by@api:LinearMap.trace.
component:trace_mul_comm#kind@entity:component.
component:trace_mul_comm#provided_by@api:LinearMap.trace_mul_comm.
component:trace_mul_cycle#kind@entity:component.
component:trace_mul_cycle#provided_by@api:LinearMap.trace_mul_cycle.
component:hilbert_schmidt_linear_equiv#kind@entity:component.
component:hilbert_schmidt_linear_equiv#provided_by@api:HilbertSchmidtOperatorSpace.hsLinearMapEquiv.

source:schwarz2016_eq36#kind@entity:source.
source:schwarz2016_eq40#kind@entity:source.

claim:hilbert_schmidt_trace_functional#kind@entity:definition.
claim:hilbert_schmidt_trace_functional#uses@component:linear_map_trace.
claim:hilbert_schmidt_trace_functional#uses@component:hilbert_schmidt_linear_equiv.
claim:hilbert_schmidt_trace_functional#formalized_by@lean:QuantumMechanics.LindbladDrivenLeads.hsTrace.

claim:hamiltonian_part_trace_zero#kind@entity:theorem.
claim:hamiltonian_part_trace_zero#supported_by@source:schwarz2016_eq40.
claim:hamiltonian_part_trace_zero#requires@claim:hilbert_schmidt_trace_functional.
claim:hamiltonian_part_trace_zero#uses@component:trace_mul_comm.
claim:hamiltonian_part_trace_zero#formalized_by@proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_hamiltonianPartHS.

claim:gksl_dissipator_trace_zero#kind@entity:theorem.
claim:gksl_dissipator_trace_zero#supported_by@source:schwarz2016_eq36.
claim:gksl_dissipator_trace_zero#requires@claim:hilbert_schmidt_trace_functional.
claim:gksl_dissipator_trace_zero#uses@component:trace_mul_comm.
claim:gksl_dissipator_trace_zero#uses@component:trace_mul_cycle.
claim:gksl_dissipator_trace_zero#formalized_by@proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_lindbladDissipatorHS.

claim:lddl_generator_trace_zero#kind@entity:theorem.
claim:lddl_generator_trace_zero#supported_by@source:schwarz2016_eq40.
claim:lddl_generator_trace_zero#requires@claim:hamiltonian_part_trace_zero.
claim:lddl_generator_trace_zero#requires@claim:gksl_dissipator_trace_zero.
claim:lddl_generator_trace_zero#formalized_by@proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_lddlGeneratorHS.
claim:lddl_generator_trace_zero#formalized_by@proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_comp_lddlGeneratorHS.

proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_hamiltonianPartHS#verification@state:pending_ci.
proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_lindbladDissipatorHS#verification@state:pending_ci.
proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_lddlGeneratorHS#verification@state:pending_ci.
proof:QuantumMechanics.LindbladDrivenLeads.hsTrace_comp_lddlGeneratorHS#verification@state:pending_ci.

RULE verified_claim:
IF ?claim#kind@entity:theorem AND ?claim#formalized_by@?proof AND ?proof#verification@state:kernel_checked
THEN ?claim#status@status:proved.

RULE pending_claim:
IF ?claim#kind@entity:theorem AND ?claim#formalized_by@?proof AND ?proof#verification@state:pending_ci
THEN ?claim#status@status:pending.

QUERY claim_statuses:
FIND ?claim ?status WHERE ?claim#status@?status.

QUERY proof_registry:
FIND ?claim ?proof WHERE ?claim#formalized_by@?proof.

QUERY dependency_edges:
FIND ?claim ?dependency WHERE ?claim#requires@?dependency.

QUERY reused_components:
FIND ?claim ?component WHERE ?claim#uses@?component.

QUERY source_traceability:
FIND ?claim ?source WHERE ?claim#supported_by@?source.
