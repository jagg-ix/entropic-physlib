{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jagg-ix/entropic-physlib-private/benchmarks/open-system-one-level/ohmic-rate-source.schema.json",
  "title": "Finite Ohmic source for one-level LDDL rate derivation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "ohmic_coupling",
    "equilibrium",
    "initial_condition",
    "source_observation_ids",
    "independent_of_target"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ohmic_coupling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable",
        "formula_id",
        "unit_contract",
        "coupling_strength_sq",
        "cutoff",
        "shape_sum",
        "rate_unit"
      ],
      "properties": {
        "observable": {
          "const": "finite_ohmic_coupling"
        },
        "formula_id": {
          "const": "gamma_eq_pi_coupling_sq_shape_over_4_cutoff_cubed"
        },
        "unit_contract": {
          "const": "coupling_sq_times_shape_over_cutoff_cubed_is_rate"
        },
        "coupling_strength_sq": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cutoff": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape_sum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rate_unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "equilibrium": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "beta_energy_gap"],
      "properties": {
        "method": {
          "const": "fermi_dirac_beta_gap"
        },
        "beta_energy_gap": {
          "type": "number",
          "minimum": -700,
          "maximum": 700
        },
        "expected_occupation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "initial_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occupation"],
      "properties": {
        "occupation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "source_observation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independent_of_target": {
      "const": true
    }
  }
}
