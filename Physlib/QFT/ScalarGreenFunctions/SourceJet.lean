module

public import Physlib.QFT.ScalarGreenFunctions.Basic

/-!
# Formal source jets and Green-function extraction

Rivers Eq. (1.17) recovers an `m`-point Green function from the `m`th source
derivative of `Z[J]` at zero:

`G_m = (-i hbar)^m delta^m Z / delta J^m |_(J=0)`.

This file represents the full source jet at zero as a multiset-indexed family.
Multisets encode the commutativity of source derivatives and Bose symmetry.
The jet associated with a Green hierarchy has coefficient
`(i/hbar)^m G_m`; multiplying by `(-i hbar)^m` recovers `G_m` exactly.

This is a formal coefficient statement and deliberately does not assert
convergence of the infinite generating series.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.QFT.ScalarGreenFunctions

/-- Formal source jet at zero, indexed by the multiset of differentiated
source coordinates. -/
abbrev SourceJet (X : Type*) := Multiset X → ℂ

/-- One formal source derivative prepends an insertion to the multiset. -/
def formalSourceDerivative {X : Type*}
    (x : X) (Z : SourceJet X) : SourceJet X :=
  fun xs => Z (x ::ₘ xs)

/-- Formal source derivatives commute. -/
lemma formalSourceDerivative_comm {X : Type*}
    (x y : X) (Z : SourceJet X) :
    formalSourceDerivative x (formalSourceDerivative y Z) =
      formalSourceDerivative y (formalSourceDerivative x Z) := by
  funext xs
  simp [formalSourceDerivative, Multiset.cons_swap]

/-- Source jet generated by a Bose-symmetric multiset Green hierarchy. -/
def greenSourceJet {X : Type*}
    (hbar : ℝ) (G : Multiset X → ℂ) : SourceJet X :=
  fun xs => (Complex.I / (hbar : ℂ)) ^ xs.card * G xs

@[simp] lemma greenSourceJet_empty {X : Type*}
    (hbar : ℝ) (G : Multiset X → ℂ) :
    greenSourceJet hbar G 0 = G 0 := by
  simp [greenSourceJet]

/-- Exact coefficient extraction formula corresponding to Rivers Eq. (1.17). -/
lemma recoverGreenFromSourceJet {X : Type*}
    (hbar : ℝ) (hhbar : hbar ≠ 0)
    (G : Multiset X → ℂ) (xs : Multiset X) :
    ((-Complex.I) * (hbar : ℂ)) ^ xs.card * greenSourceJet hbar G xs = G xs := by
  unfold greenSourceJet
  rw [← mul_assoc, ← mul_pow]
  have hhbarC : (hbar : ℂ) ≠ 0 := by exact_mod_cast hhbar
  have hfactor :
      ((-Complex.I) * (hbar : ℂ)) * (Complex.I / (hbar : ℂ)) = 1 := by
    field_simp [hhbarC]
    simp [Complex.I_mul_I]
  rw [hfactor, one_pow, one_mul]

/-- The one-source derivative of the Green jet is the jet shifted by one field
insertion. -/
lemma formalSourceDerivative_greenSourceJet {X : Type*}
    (hbar : ℝ) (G : Multiset X → ℂ) (x : X) (xs : Multiset X) :
    formalSourceDerivative x (greenSourceJet hbar G) xs =
      (Complex.I / (hbar : ℂ)) ^ (xs.card + 1) * G (x ::ₘ xs) := by
  simp [formalSourceDerivative, greenSourceJet, pow_succ']

/-- Formal `m`-fold derivative coefficient, written directly with a multiset
of insertion points. -/
def formalSourceDerivativeCoefficient {X : Type*}
    (Z : SourceJet X) (xs : Multiset X) : ℂ :=
  Z xs

/-- Extraction of any multiderivative coefficient from the Green jet. -/
lemma recoverGreenFromDerivativeCoefficient {X : Type*}
    (hbar : ℝ) (hhbar : hbar ≠ 0)
    (G : Multiset X → ℂ) (xs : Multiset X) :
    ((-Complex.I) * (hbar : ℂ)) ^ xs.card *
        formalSourceDerivativeCoefficient (greenSourceJet hbar G) xs =
      G xs :=
  recoverGreenFromSourceJet hbar hhbar G xs

end Physlib.QFT.ScalarGreenFunctions

end
