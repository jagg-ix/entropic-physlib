/-!
# Continuum periodic potentials and Bloch quasiperiodicity

This file connects the paper's pointwise periodic Schrödinger data to
Physlib's existing continuum Hilbert-space and maximal-domain multiplication
operator APIs.

The kinetic operator is deliberately not reimplemented. Downstream modules
may supply the repository's chosen Laplacian or another self-adjoint kinetic
operator. The periodic potential acts through the existing
`SpaceDHilbertSpace.mulOperator`.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.QuantumMechanics.PeriodicSchrodinger

open MeasureTheory
open QuantumMechanics
open scoped BigOperators

/-- Euclidean pairing on `Space d`. -/
def momentumPairing {d : ℕ}
    (k x : Space d) : ℝ :=
  ∑ i, k i * x i

/-- Bloch phase `exp(i⟨t,ω⟩)`. -/
def blochPhase {d : ℕ}
    (t ω : Space d) : ℂ :=
  Complex.exp (Complex.I * momentumPairing t ω)

/-- Pointwise periodicity relative to a family of lattice periods. -/
def IsPeriodicPotential {d : ℕ} {Ω : Type*}
    (period : Ω → Space d) (q : Space d → ℂ) : Prop :=
  ∀ ω x, q (x + period ω) = q x

/-- Bloch quasiperiodicity with quasimomentum `t`. -/
def IsBlochQuasiperiodic {d : ℕ} {Ω : Type*}
    (period : Ω → Space d)
    (t : Space d) (ψ : Space d → ℂ) : Prop :=
  ∀ ω x,
    ψ (x + period ω) = blochPhase t (period ω) * ψ x

/-- A periodic potential preserves Bloch quasiperiodicity under pointwise
multiplication. -/
theorem periodic_mul_preserves_bloch
    {d : ℕ} {Ω : Type*}
    (period : Ω → Space d)
    (q ψ : Space d → ℂ) (t : Space d)
    (hq : IsPeriodicPotential period q)
    (hψ : IsBlochQuasiperiodic period t ψ) :
    IsBlochQuasiperiodic period t (fun x => q x * ψ x) := by
  intro ω x
  change q (x + period ω) * ψ (x + period ω) =
    blochPhase t (period ω) * (q x * ψ x)
  rw [hq ω x, hψ ω x]
  ring

/-- Sum of two Bloch-quasiperiodic functions with the same quasimomentum is
Bloch quasiperiodic. -/
theorem blochQuasiperiodic_add
    {d : ℕ} {Ω : Type*}
    (period : Ω → Space d)
    (ψ φ : Space d → ℂ) (t : Space d)
    (hψ : IsBlochQuasiperiodic period t ψ)
    (hφ : IsBlochQuasiperiodic period t φ) :
    IsBlochQuasiperiodic period t (ψ + φ) := by
  intro ω x
  simp only [Pi.add_apply, hψ ω x, hφ ω x]
  ring

/-- Scalar multiples preserve Bloch quasiperiodicity. -/
theorem blochQuasiperiodic_smul
    {d : ℕ} {Ω : Type*}
    (period : Ω → Space d)
    (ψ : Space d → ℂ) (t : Space d) (c : ℂ)
    (hψ : IsBlochQuasiperiodic period t ψ) :
    IsBlochQuasiperiodic period t (c • ψ) := by
  intro ω x
  simp only [Pi.smul_apply, hψ ω x]
  ring

/-- Existing `L²(Space d,ℂ)` carrier used for periodic Schrödinger states. -/
abbrev PeriodicSchrodingerHilbertSpace (d : ℕ) :=
  _root_.QuantumMechanics.SpaceDHilbertSpace d

/-- Maximal-domain continuum multiplication operator generated by a periodic
potential. -/
def periodicPotentialOperator {d : ℕ}
    (q : Space d → ℂ) :
    PeriodicSchrodingerHilbertSpace d →ₗ.[ℂ]
      PeriodicSchrodingerHilbertSpace d :=
  _root_.QuantumMechanics.SpaceDHilbertSpace.mulOperator volume q

/-- An almost-everywhere strongly measurable periodic potential gives a
densely defined operator. -/
theorem periodicPotentialOperator_hasDenseDomain
    {d : ℕ} {q : Space d → ℂ}
    (hq : AEStronglyMeasurable q) :
    (periodicPotentialOperator q).HasDenseDomain := by
  simpa [periodicPotentialOperator] using
    _root_.QuantumMechanics.SpaceDHilbertSpace.mulOperator_hasDenseDomain hq

/-- The continuum potential operator acts by pointwise multiplication almost
everywhere. -/
theorem periodicPotentialOperator_apply_ae
    {d : ℕ} {q : Space d → ℂ}
    (ψ : (periodicPotentialOperator q).domain) :
    periodicPotentialOperator q ψ =ᵐ[volume] q • ψ := by
  simpa [periodicPotentialOperator] using
    _root_.QuantumMechanics.SpaceDHilbertSpace.mulOperator_apply_ae (f := q) ψ

/-- A real-valued measurable periodic potential defines a self-adjoint
multiplication operator through the existing repository theorem. -/
theorem periodicPotentialOperator_isSelfAdjoint
    {d : ℕ} {q : Space d → ℂ}
    (hqmeas : AEStronglyMeasurable q)
    (hqreal : ∀ x, star (q x) = q x) :
    _root_.IsSelfAdjoint (periodicPotentialOperator q) := by
  apply _root_.QuantumMechanics.SpaceDHilbertSpace.mulOperator_isSelfAdjoint_ofReal hqmeas
  funext x
  exact hqreal x

/-! ## Finite-to-continuum Fourier isometric equivalence

The integer reciprocal-mode `ℓ²` carrier is not a measured continuum `L²` by
name; the relationship is a proved isometric equivalence, via the Fourier Hilbert
basis, to `L²(circle, Haar)` — discharging the Fourier–Bloch obligation. -/

open AddCircle in
/-- **The integer-mode `ℓ²` carrier is isometrically equivalent to the measured
continuum `L²(circle, Haar)`** via the Fourier Hilbert basis. -/
noncomputable def modeCircleEquiv (T : ℝ) [Fact (0 < T)] :
    ↥(lp (fun _ : ℤ => ℂ) 2) ≃ₗᵢ[ℂ] Lp ℂ 2 (haarAddCircle (T := T)) :=
  (fourierBasis (T := T)).repr.symm

open AddCircle in
/-- **The continuum bridge preserves the Hilbert norm** — the total Born weight
agrees across the two carriers. -/
@[zil_level bridge_theorem]
theorem modeCircleEquiv_norm (T : ℝ) [Fact (0 < T)] (ψ : ↥(lp (fun _ : ℤ => ℂ) 2)) :
    ‖modeCircleEquiv T ψ‖ = ‖ψ‖ :=
  (modeCircleEquiv T).norm_map ψ

open AddCircle in
/-- **The continuum bridge preserves the Hilbert inner product** — correlations and
expectations agree across the two carriers. -/
@[zil_level bridge_theorem]
theorem modeCircleEquiv_inner (T : ℝ) [Fact (0 < T)]
    (ψ φ : ↥(lp (fun _ : ℤ => ℂ) 2)) :
    inner ℂ (modeCircleEquiv T ψ) (modeCircleEquiv T φ) = inner ℂ ψ φ :=
  (modeCircleEquiv T).inner_map_map ψ φ

zil attach modeCircleEquiv_norm where
  formalizes @ "claim:the-integer-mode-l2-carrier-is-isometrically-equivalent-to-the-measured-continuum-l2-circle-haar-via-the-fourier-basis",
  represents @ "lean:Physlib.QuantumMechanics.PeriodicSchrodinger.modeCircleEquiv",
  supported_by @ "mathlib:fourierBasis"

zil attach modeCircleEquiv_inner where
  formalizes @ "claim:the-continuum-bridge-preserves-the-hilbert-inner-product-so-correlations-and-expectations-agree-across-carriers",
  preserves_probability @ "lean:Physlib.QuantumMechanics.PeriodicSchrodinger.modeCircleEquiv",
  supported_by @ "mathlib:HilbertBasis.repr"

zil_file_contract physlib.periodicSchrodingerContinuumBridge where
  promises "A proved finite-to-continuum relationship for the periodic reciprocal-mode carrier: the integer-mode l2 carrier is isometrically equivalent to the measured continuum L2 of the circle with normalized Haar measure, via the Fourier Hilbert basis. The equivalence preserves the Hilbert norm and inner product, so total Born weight, correlations, and expectations agree across the two carriers - an isometric equivalence to a genuine measure space, not a bare naming."
  at_level bridge_theorem
  contract_status satisfied
  requires_objects [
    "lean:Physlib.QuantumMechanics.PeriodicSchrodinger.modeCircleEquiv"
  ]
  forbids_substitutes [
    "calling the reciprocal-mode l2 carrier a continuum L2 without this bridge",
    "claiming an equivalence for a non-integer or unnormalized mode index",
    "promoting the isometric equivalence to a pointwise physical-space identification"
  ]
  witnessed_by [
    modeCircleEquiv_norm,
    modeCircleEquiv_inner
  ]

/- ZIL-END -/

#zil_formalization_lint physlib.periodicSchrodingerContinuumBridge


end Physlib.QuantumMechanics.PeriodicSchrodinger

