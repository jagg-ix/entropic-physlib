module

public import Physlib.QuantumMechanics.PeriodicSchrodinger.Simplicity

/-!
# Directional potentials and resonant binding formulas

Near a single diffraction hyperplane associated with a reciprocal vector
`δ`, Veliev splits the periodic potential into the directional part supported
on integer multiples of `δ` and the transverse remainder.

The directional Schrödinger operator is then used as the unperturbed operator.
Projecting the full eigenvalue equation onto one of its eigenfunctions yields
the resonant binding formula

`(Λ - λ_a) b_a = Σ_c V_ac b_c`.

This file formalizes the support split and this reference-basis binding system
for arbitrary, possibly infinite, mode types with finite coupling truncations.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.QuantumMechanics.PeriodicSchrodinger

open scoped BigOperators

variable {Γ : Type*} [AddCommGroup Γ] [DecidableEq Γ]

/-- A reciprocal mode lies on the integer line generated by `δ`. -/
def IsDirectionalMode (δ γ : Γ) : Prop :=
  ∃ n : ℤ, γ = n • δ

@[simp] theorem zero_isDirectionalMode (δ : Γ) :
    IsDirectionalMode δ 0 := by
  exact ⟨0, by simp⟩

/-- The direction vector itself belongs to its directional line. -/
theorem self_isDirectionalMode (δ : Γ) :
    IsDirectionalMode δ δ := by
  exact ⟨1, by simp⟩

/-- Directional Fourier part of a periodic potential. -/
def directionalPart (δ : Γ) (q : Γ → ℂ) : Γ → ℂ :=
  fun γ => by
    classical
    exact if IsDirectionalMode δ γ then q γ else 0

/-- Fourier remainder transverse to the selected diffraction direction. -/
def transverseRemainder (δ : Γ) (q : Γ → ℂ) : Γ → ℂ :=
  fun γ => q γ - directionalPart δ q γ

/-- Exact directional/transverse decomposition. -/
theorem directionalPart_add_transverseRemainder
    (δ : Γ) (q : Γ → ℂ) :
    directionalPart δ q + transverseRemainder δ q = q := by
  funext γ
  simp [transverseRemainder]

/-- The transverse remainder vanishes on every directional mode. -/
theorem transverseRemainder_eq_zero_of_directional
    (δ : Γ) (q : Γ → ℂ) {γ : Γ}
    (hγ : IsDirectionalMode δ γ) :
    transverseRemainder δ q γ = 0 := by
  simp [transverseRemainder, directionalPart, hγ]

/-- Away from the directional line, the directional part vanishes. -/
theorem directionalPart_eq_zero_of_not_directional
    (δ : Γ) (q : Γ → ℂ) {γ : Γ}
    (hγ : ¬ IsDirectionalMode δ γ) :
    directionalPart δ q γ = 0 := by
  simp [directionalPart, hγ]

/-- Away from the directional line, the transverse remainder equals the full
potential coefficient. -/
theorem transverseRemainder_eq_of_not_directional
    (δ : Γ) (q : Γ → ℂ) {γ : Γ}
    (hγ : ¬ IsDirectionalMode δ γ) :
    transverseRemainder δ q γ = q γ := by
  simp [transverseRemainder, directionalPart, hγ]

/-- Directional coefficient indexed directly by the integer harmonic. -/
def directionalCoefficient (δ : Γ) (q : Γ → ℂ) (n : ℤ) : ℂ :=
  q (n • δ)

/-- Finite directional Fourier convolution. -/
def directionalConvolution
    (harmonics : Finset ℤ) (δ : Γ)
    (q : Γ → ℂ) (b : Γ → ℂ) (γ : Γ) : ℂ :=
  ∑ n ∈ harmonics,
    directionalCoefficient δ q n * b (γ - n • δ)

/-- Finite transverse Fourier convolution. -/
def transverseConvolution
    (support : Finset Γ) (δ : Γ)
    (q b : Γ → ℂ) (γ : Γ) : ℂ :=
  potentialConvolution support (transverseRemainder δ q) b γ

/-! ## Binding formula in a directional reference basis -/

variable {A : Type*} [DecidableEq A]

/-- Coupling action in an arbitrary reference eigenbasis. -/
def referenceCoupling
    (support : Finset A)
    (V : A → A → ℂ) (b : A → ℂ) (a : A) : ℂ :=
  ∑ c ∈ support, V a c * b c

/-- Binding equation relative to a nontrivial reference operator, such as the
operator with directional potential `q^δ`. -/
def ReferenceBindingEquation
    (support : Finset A)
    (V : A → A → ℂ)
    (referenceEnergy : A → ℝ)
    (b : A → ℂ) (Λ : ℂ) (a : A) : Prop :=
  (Λ - referenceEnergy a) * b a =
    referenceCoupling support V b a

/-- Reference-basis binding system for all labels. -/
def SatisfiesReferenceBindingSystem
    (support : Finset A)
    (V : A → A → ℂ)
    (referenceEnergy : A → ℝ)
    (b : A → ℂ) (Λ : ℂ) : Prop :=
  ∀ a, ReferenceBindingEquation support V referenceEnergy b Λ a

/-- Away from a reference spectral denominator, the coefficient is recovered
by division. This is the exact algebraic content of the paper's formula (53). -/
theorem referenceCoefficient_eq
    (support : Finset A)
    (V : A → A → ℂ)
    (referenceEnergy : A → ℝ)
    (b : A → ℂ) (Λ : ℂ) (a : A)
    (hbind : ReferenceBindingEquation support V referenceEnergy b Λ a)
    (hgap : Λ - referenceEnergy a ≠ 0) :
    b a = referenceCoupling support V b a /
      (Λ - referenceEnergy a) := by
  rw [eq_div_iff hgap]
  simpa [ReferenceBindingEquation, mul_comm] using hbind

/-- A positive reference denominator gap excludes zero denominators. -/
theorem referenceDenominator_ne_zero
    (referenceEnergy : A → ℝ) (Λ : ℂ)
    {gap : ℝ} (hgap : 0 < gap) (a : A)
    (hden : gap ≤ ‖Λ - referenceEnergy a‖) :
    Λ - referenceEnergy a ≠ 0 := by
  intro hz
  rw [hz, norm_zero] at hden
  linarith

/-- Norm estimate for one coefficient in the directional reference basis. -/
theorem norm_referenceCoefficient_le
    (support : Finset A)
    (V : A → A → ℂ)
    (referenceEnergy : A → ℝ)
    (b : A → ℂ) (Λ : ℂ) (a : A)
    (hbind : ReferenceBindingEquation support V referenceEnergy b Λ a)
    {gap : ℝ} (hgap : 0 < gap)
    (hden : gap ≤ ‖Λ - referenceEnergy a‖) :
    ‖b a‖ ≤ ‖referenceCoupling support V b a‖ / gap := by
  have hne := referenceDenominator_ne_zero
    referenceEnergy Λ hgap a hden
  rw [referenceCoefficient_eq support V referenceEnergy b Λ a hbind hne,
    norm_div]
  exact div_le_div_of_nonneg_left (norm_nonneg _)
    hgap hden

end Physlib.QuantumMechanics.PeriodicSchrodinger

end
