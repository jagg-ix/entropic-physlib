/-!
# Direct-limit gluing of Cauchy developments with different carriers

Wald's maximal-development argument cannot take the set-theoretic union of
spacetimes whose point types differ.  This file supplies that missing
carrier-level construction.  A directed family of developments is glued by
Mathlib's generic `DirectLimit`: the disjoint union of all point carriers is
quotiented by eventual equality under the extension embeddings.

The construction descends:

* the causal relation;
* the pointwise Einstein equation;
* the common Cauchy embedding;
* the final topology generated by the canonical component maps.

The canonical maps are injective and continuous.  Causal convexity of every
extension image then shows that a causal diamond whose endpoints come from
one component is exactly the continuous image of that component's diamond.
Consequently compact causal diamonds, and hence the causal-compact form of
global hyperbolicity used by `MaximalCauchyDevelopment`, survive the quotient
gluing.

This is the arbitrary-carrier counterpart of the literal common-ambient chain
union.  It is deliberately a topological/causal/Einstein gluing theorem, not a
claim that Mathlib already has a quotient atlas theorem for Lorentzian
manifolds.  To instantiate it with smooth spacetimes, the transition maps must
come from the repository's fixed-Cauchy local isometries; smooth atlas and
metric descent remain explicit geometric obligations.

## Reuse

The quotient, equivalence relation, common-stage representative lemmas, and
universal lifting operations are reused from
`Mathlib.Order.DirectedInverseSystem`.  No second direct-limit quotient is
implemented here.

## References

* R. M. Wald, *General Relativity*, pp. 263--264, Theorem 10.2.2.
* Y. Choquet-Bruhat and R. Geroch, *Global aspects of the Cauchy
  problem in general relativity*, Commun. Math. Phys. 14 (1969).
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

open Set

namespace Physlib.QuantumMechanics.ComplexAction.CanonicalTetradGravity

namespace DevelopmentDirectLimit

universe u v w

/-- A directed system of globally hyperbolic Einstein Cauchy developments.

`causalConvex_map` is the geometric input saying that the image of a smaller
development is causally convex in every larger one.  It is precisely what
allows compact diamonds to descend through the quotient: a point between two
old endpoints cannot first appear in a later extension.
-/
structure DirectedDevelopmentSystem
    (ι : Type u) [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
    (S : Type v) where
  /-- The point carrier of each development. -/
  Point : ι → Type w
  /-- The topology of each spacetime carrier. -/
  topology : ∀ i, TopologicalSpace (Point i)
  /-- Fixed-Cauchy extension embeddings. -/
  map : ∀ i j, i ≤ j → Point i ↪ Point j
  map_self : ∀ i x, map i i le_rfl x = x
  map_map : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k) x,
    map j k hjk (map i j hij x) = map i k (hij.trans hjk) x
  map_continuous : ∀ i j (hij : i ≤ j),
    @Continuous (Point i) (Point j) (topology i) (topology j) (map i j hij)
  /-- The causal order in each development. -/
  causal : ∀ i, Point i → Point i → Prop
  causal_refl : ∀ i p, causal i p p
  causal_trans : ∀ i {p q r}, causal i p q → causal i q r → causal i p r
  causal_antisymm : ∀ i {p q}, causal i p q → causal i q p → p = q
  causal_map : ∀ i j (hij : i ≤ j) p q,
    causal j (map i j hij p) (map i j hij q) ↔ causal i p q
  /-- The pointwise (real or complex) Einstein equation. -/
  EinsteinAt : ∀ i, Point i → Prop
  einstein_on : ∀ i p, EinsteinAt i p
  einstein_map : ∀ i j (hij : i ≤ j) p,
    EinsteinAt j (map i j hij p) ↔ EinsteinAt i p
  /-- The common initial-data hypersurface. -/
  cauchyEmbedding : ∀ i, S → Point i
  cauchyEmbedding_injective : ∀ i, Function.Injective (cauchyEmbedding i)
  cauchy_map : ∀ i j (hij : i ≤ j) σ,
    map i j hij (cauchyEmbedding i σ) = cauchyEmbedding j σ
  /-- Each component has compact causal diamonds. -/
  diamond_compact : ∀ i p q,
    @IsCompact (Point i) (topology i)
      {r | causal i p r ∧ causal i r q}
  /-- Images of earlier developments are causally convex in later ones. -/
  causalConvex_map : ∀ i j (hij : i ≤ j) p q r,
    causal j (map i j hij p) r →
    causal j r (map i j hij q) →
    ∃ r₀, map i j hij r₀ = r

namespace DirectedDevelopmentSystem

variable {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
variable {S : Type v} (D : DirectedDevelopmentSystem ι S)

/-- The transition maps form the `DirectedSystem` required by Mathlib's
generic direct-limit quotient. -/
instance directedSystem :
    DirectedSystem D.Point (fun ⦃i j⦄ h => D.map i j h) where
  map_self {i} x := D.map_self i x
  map_map {k j i} hij hjk x := D.map_map i j k hij hjk x

/-- The genuine quotient gluing of the varying spacetime point carriers. -/
def GluedCarrier :=
  DirectLimit D.Point (fun i j h => D.map i j h)

/-- The canonical injection of one development into the glued carrier. -/
def of (i : ι) : D.Point i ↪ D.GluedCarrier where
  toFun x := (⟦⟨i, x⟩⟧ :
    DirectLimit D.Point (fun i j h => D.map i j h))
  inj' := DirectLimit.mk_injective
    (fun i j h => D.map i j h)
    (fun i j hij => (D.map i j hij).injective) i

@[simp]
theorem of_apply (i : ι) (x : D.Point i) :
    D.of i x =
      (⟦⟨i, x⟩⟧ :
        DirectLimit D.Point (fun i j h => D.map i j h)) :=
  rfl

/-- Canonical injections commute with extension embeddings. -/
@[simp]
theorem of_map {i j : ι} (hij : i ≤ j) (x : D.Point i) :
    D.of j (D.map i j hij x) = D.of i x :=
  DirectLimit.mk_apply i j x hij

/-- The final topology generated by all canonical component maps. -/
@[reducible] def gluedTopology : TopologicalSpace D.GluedCarrier :=
  ⨆ i, TopologicalSpace.coinduced (D.of i) (D.topology i)

noncomputable instance instTopologicalSpaceGluedCarrier :
    TopologicalSpace D.GluedCarrier :=
  D.gluedTopology

/-- Every canonical component injection is continuous for the final
direct-limit topology. -/
theorem continuous_of (i : ι) :
    @Continuous (D.Point i) D.GluedCarrier
      (D.topology i) D.instTopologicalSpaceGluedCarrier (D.of i) := by
  rw [continuous_iff_coinduced_le]
  exact le_iSup (fun j =>
    TopologicalSpace.coinduced (D.of j) (D.topology j)) i

/-- The causal relation descended through the directed quotient. -/
def gluedCausal : D.GluedCarrier → D.GluedCarrier → Prop :=
  DirectLimit.lift₂
    (fun i j h => D.map i j h)
    (fun i j h => D.map i j h)
    D.causal
    (fun i j hij p q => propext (D.causal_map i j hij p q).symm)

/-- The Einstein predicate descended through the directed quotient. -/
def gluedEinsteinAt : D.GluedCarrier → Prop :=
  DirectLimit.lift
    (fun i j h => D.map i j h)
    D.EinsteinAt
    (fun i j hij p => propext (D.einstein_map i j hij p).symm)

/-- The common Cauchy surface in the quotient.  `DirectLimit.map₀` makes the
choice of component independent by `cauchy_map`. -/
def gluedCauchyEmbedding (σ : S) : D.GluedCarrier :=
  DirectLimit.map₀
    (fun i j h => D.map i j h)
    (fun i => D.cauchyEmbedding i σ)

@[simp]
theorem gluedCausal_of (i : ι) (p q : D.Point i) :
    D.gluedCausal (D.of i p) (D.of i q) ↔ D.causal i p q := by
  change
    DirectLimit.lift₂
      (fun i j h => D.map i j h)
      (fun i j h => D.map i j h)
      D.causal _ ⟦⟨i, p⟩⟧ ⟦⟨i, q⟩⟧ ↔ _
  rw [DirectLimit.lift₂_def]

@[simp]
theorem gluedEinsteinAt_of (i : ι) (p : D.Point i) :
    D.gluedEinsteinAt (D.of i p) ↔ D.EinsteinAt i p := by
  rfl

@[simp]
theorem gluedCauchyEmbedding_eq_of (i : ι) (σ : S) :
    D.gluedCauchyEmbedding σ = D.of i (D.cauchyEmbedding i σ) := by
  exact DirectLimit.map₀_def
    (fun i j h => D.map i j h)
    (fun i => D.cauchyEmbedding i σ)
    (fun i j hij => D.cauchy_map i j hij σ) i

/-- The glued Cauchy embedding is injective. -/
theorem gluedCauchyEmbedding_injective :
    Function.Injective D.gluedCauchyEmbedding := by
  intro σ τ hστ
  let i : ι := Classical.arbitrary ι
  have hOf :
      D.of i (D.cauchyEmbedding i σ) =
        D.of i (D.cauchyEmbedding i τ) := by
    rw [← D.gluedCauchyEmbedding_eq_of i σ,
      ← D.gluedCauchyEmbedding_eq_of i τ]
    exact hστ
  exact D.cauchyEmbedding_injective i ((D.of i).injective hOf)

/-- The descended causal relation is reflexive. -/
theorem gluedCausal_refl (p : D.GluedCarrier) :
    D.gluedCausal p p := by
  refine DirectLimit.induction
    (f := fun i j h => D.map i j h) (fun i p => ?_) p
  exact (D.gluedCausal_of i p p).2 (D.causal_refl i p)

/-- The descended causal relation is transitive. -/
theorem gluedCausal_trans {p q r : D.GluedCarrier} :
    D.gluedCausal p q → D.gluedCausal q r → D.gluedCausal p r := by
  refine DirectLimit.induction₃
    (f := fun i j h => D.map i j h) (fun i p q r hpq hqr => ?_) p q r
  exact (D.gluedCausal_of i p r).2 <|
    D.causal_trans i
      ((D.gluedCausal_of i p q).1 hpq)
      ((D.gluedCausal_of i q r).1 hqr)

/-- The descended causal relation is antisymmetric. -/
theorem gluedCausal_antisymm {p q : D.GluedCarrier} :
    D.gluedCausal p q → D.gluedCausal q p → p = q := by
  refine DirectLimit.induction₂
    (f := fun i j h => D.map i j h) (fun i p q hpq hqp => ?_) p q
  exact congrArg (D.of i) <| D.causal_antisymm i
    ((D.gluedCausal_of i p q).1 hpq)
    ((D.gluedCausal_of i q p).1 hqp)

/-- The descended Einstein equation holds at every glued point. -/
theorem gluedEinstein_on (p : D.GluedCarrier) :
    D.gluedEinsteinAt p := by
  refine DirectLimit.induction
    (f := fun i j h => D.map i j h) (fun i p => ?_) p
  exact (D.gluedEinsteinAt_of i p).2 (D.einstein_on i p)

/-- Two glued points have representatives in one common component. -/
theorem exists_of₂ (p q : D.GluedCarrier) :
    ∃ i p₀ q₀, p = D.of i p₀ ∧ q = D.of i q₀ := by
  change
    ∃ i p₀ q₀,
      p =
        (⟦⟨i, p₀⟩⟧ :
          DirectLimit D.Point (fun i j h => D.map i j h)) ∧
      q =
        (⟦⟨i, q₀⟩⟧ :
          DirectLimit D.Point (fun i j h => D.map i j h))
  exact DirectLimit.exists_eq_mk₂
    (f := fun i j h => D.map i j h) p q

/-- A causal diamond in the glued carrier with endpoints in one component is
exactly the image of that component's causal diamond.  The difficult reverse
inclusion is `causalConvex_map`: a later representative between the old
endpoints descends to the earlier component. -/
@[zil_level physical_theorem]
theorem gluedCausalDiamond_eq_image (i : ι) (p q : D.Point i) :
    {r : D.GluedCarrier |
        D.gluedCausal (D.of i p) r ∧
          D.gluedCausal r (D.of i q)}
      =
    D.of i '' {r : D.Point i |
      D.causal i p r ∧ D.causal i r q} := by
  ext z
  constructor
  · intro hz
    obtain ⟨j, r, rfl⟩ :=
      DirectLimit.exists_eq_mk
        (f := fun i j h => D.map i j h) z
    obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
    have hpr :
        D.causal k (D.map i k hik p) (D.map j k hjk r) := by
      apply (D.gluedCausal_of k _ _).1
      rw [D.of_map hik p, D.of_map hjk r]
      exact hz.1
    have hrq :
        D.causal k (D.map j k hjk r) (D.map i k hik q) := by
      apply (D.gluedCausal_of k _ _).1
      rw [D.of_map hjk r, D.of_map hik q]
      exact hz.2
    obtain ⟨r₀, hr₀⟩ :=
      D.causalConvex_map i k hik p q (D.map j k hjk r) hpr hrq
    have hpr₀ : D.causal i p r₀ := by
      apply (D.causal_map i k hik p r₀).1
      simpa [hr₀] using hpr
    have hr₀q : D.causal i r₀ q := by
      apply (D.causal_map i k hik r₀ q).1
      simpa [hr₀] using hrq
    refine ⟨r₀, ⟨hpr₀, hr₀q⟩, ?_⟩
    calc
      D.of i r₀ = D.of k (D.map i k hik r₀) :=
        (D.of_map hik r₀).symm
      _ = D.of k (D.map j k hjk r) := congrArg (D.of k) hr₀
      _ = D.of j r := D.of_map hjk r
  · rintro ⟨r, ⟨hpr, hrq⟩, rfl⟩
    exact ⟨(D.gluedCausal_of i p r).2 hpr,
      (D.gluedCausal_of i r q).2 hrq⟩

/-- **Compact causal diamonds survive arbitrary-carrier direct-limit
gluing.** -/
@[zil_level physical_theorem]
theorem gluedCausalDiamond_isCompact
    (p q : D.GluedCarrier) :
    IsCompact {r | D.gluedCausal p r ∧ D.gluedCausal r q} := by
  obtain ⟨i, p₀, q₀, rfl, rfl⟩ := D.exists_of₂ p q
  rw [D.gluedCausalDiamond_eq_image i p₀ q₀]
  letI : TopologicalSpace (D.Point i) := D.topology i
  have hcompact :
      IsCompact {r : D.Point i |
        D.causal i p₀ r ∧ D.causal i r q₀} :=
    D.diamond_compact i p₀ q₀
  exact hcompact.image (D.continuous_of i)

open MaximalCauchyDevelopment

/-- The common causal/Einstein ambient structure carried by the quotient. -/
def gluedAmbient :
    MaximalCauchyDevelopment.CausalEinsteinAmbient D.GluedCarrier S where
  causal := D.gluedCausal
  causal_refl := D.gluedCausal_refl
  causal_trans := D.gluedCausal_trans
  causal_antisymm := D.gluedCausal_antisymm
  cauchyEmbedding := D.gluedCauchyEmbedding
  cauchyEmbedding_injective := D.gluedCauchyEmbedding_injective
  EinsteinAt := D.gluedEinsteinAt

/-- The direct limit itself is a globally hyperbolic Einstein Cauchy
development.  Thus a directed family of different spacetime carriers has a
genuine common upper development, not merely a declared upper-bound
certificate. -/
@[zil_level physical_theorem]
noncomputable def gluedDevelopment :
    MaximalCauchyDevelopment.CausalEinsteinAmbient.Development
      D.gluedAmbient where
  region := Set.univ
  isOpen_region := isOpen_univ
  cauchy_mem := fun _ => Set.mem_univ _
  einstein_on := fun p _ => D.gluedEinstein_on p
  globallyHyperbolic := by
    constructor
    · intro _ _ _ _ _ _ _
      exact Set.mem_univ _
    · intro p _ q _
      exact D.gluedCausalDiamond_isCompact p q

