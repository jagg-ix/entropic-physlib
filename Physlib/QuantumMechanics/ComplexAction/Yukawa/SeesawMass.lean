module

public import Physlib.QuantumMechanics.ComplexAction.ComplexEinstein.EinsteinFieldEquationsPhysLean

/-!
# Yukawa couplings: fermion masses and the Type-I seesaw

Formalizes the **exact** Yukawa-coupling content of the particle-physics development: the fermion mass from
a Yukawa coupling and the **Type-I seesaw** mass matrix and its eigenvalue relations.

* a Yukawa coupling `𝓛_Y = −y_f ψ̄_L φ ψ_R + h.c.` to a symmetry-breaking scalar `φ` gives, at its vacuum
  value `v`, the fermion mass
  `m_f = y_f v/√2` (`yukawaMass`), linear in the coupling (`yukawaMass_smul`);
* the **Type-I seesaw** adds a right-handed neutrino with Majorana mass `M_N`, giving the symmetric mass
  matrix `𝓜 = [[0, m_D], [m_D, M_N]]` (`seesawMatrix`, `m_D = y_ν v/√2` the Dirac mass from the Yukawa
  coupling), with trace `M_N` (`seesawMatrix_trace`) and determinant `−m_D²` (`seesawMatrix_det`);
* its eigenvalues are the exact roots of the characteristic polynomial `x² − M_N x − m_D²`
  (`seesawMatrix_charpoly`, `seesawEigenPlus`, `seesawEigenMinus`, `seesawEigenPlus_root`,
  `seesawEigenMinus_root`), with sum `M_N` (`seesaw_eigen_sum`) and product `−m_D²` (`seesaw_eigen_prod`);
* the **seesaw lever relation** is then exact: the heavy and light masses multiply to the Dirac mass
  squared, `m_heavy · m_light = m_D²` (`seesaw_lever`), so the light neutrino mass is suppressed
  `m_light = m_D²/m_heavy` by the heavy scale — the seesaw. With `m_D = y_ν v/√2` this is
  `m_heavy · m_light = y_ν² v²/2` (`yukawa_seesaw`).

Here `m_heavy = seesawEigenPlus > 0` and `m_light = −seesawEigenMinus > 0` (the negative eigenvalue is a
Majorana phase); the seesaw lever `m_heavy · m_light = m_D²` is **exact** (the determinant), while the usual
`m_heavy ≈ M_N`, `m_light ≈ m_D²/M_N` is the large-`M_N` limit. (The note's "entropic seesaw"
`M_N^eff = Λ e^Θ` is a separate fitted ansatz, not formalized.)

* **§A — the Yukawa mass** (`yukawaMass`, `yukawaMass_smul`, `yukawaMass_sq`).
* **§B — the seesaw matrix and its invariants** (`seesawMatrix`, `seesawMatrix_symm`,
  `seesawMatrix_trace`, `seesawMatrix_det`, `seesawMatrix_charpoly`).
* **§C — the seesaw eigenvalues and the lever relation** (`seesawEigenPlus`, `seesawEigenMinus`,
  `seesaw_eigen_sum`, `seesaw_eigen_prod`, `seesawEigenPlus_root`, `seesawEigenMinus_root`,
  `seesaw_lever`, `yukawa_seesaw`).

## References

* Standard Model Yukawa sector and the Type-I seesaw (P. Minkowski, Phys. Lett. B 67 (1977) 421; Gell-Mann–
  Ramond–Slansky; Yanagida). Source note: `complex_action_particle_physics_reference.md` (`m_f = y_f v/√2`,
  `𝓜 = [[0,m_D],[m_D,M_N]]`, `m_light ≈ m_D²/M_N`).


-/

set_option autoImplicit false

@[expose] public section

namespace Physlib.QuantumMechanics.ComplexAction.Yukawa.SeesawMass

open Matrix


/-- **The Yukawa mass** `m_f = y_f v/√2` — the fermion mass generated by a Yukawa coupling `y_f` at the
vacuum value `v` of a symmetry-breaking scalar (from `𝓛_Y = −y_f ψ̄_L φ ψ_R + h.c.`). -/
noncomputable def yukawaMass (y v : ℝ) : ℝ := y * v / Real.sqrt 2

/-- **[The mass is linear in the Yukawa coupling] `m(cy) = c·m(y)`.** -/
lemma yukawaMass_smul (c y v : ℝ) : yukawaMass (c * y) v = c * yukawaMass y v := by
  unfold yukawaMass; ring

/-- **[The squared Yukawa mass] `m_f² = y_f² v²/2`.** -/
lemma yukawaMass_sq (y v : ℝ) : yukawaMass y v ^ 2 = y ^ 2 * v ^ 2 / 2 := by
  unfold yukawaMass
  rw [div_pow, Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 2)]
  ring


/-- **The Type-I seesaw mass matrix** `𝓜 = [[0, m_D], [m_D, M_N]]` — the Dirac mass `m_D` (off-diagonal,
from the Yukawa coupling) and the right-handed Majorana mass `M_N` (diagonal). -/
def seesawMatrix (m_D M_N : ℝ) : Matrix (Fin 2) (Fin 2) ℝ := !![0, m_D; m_D, M_N]

/-- **The seesaw mass matrix is symmetric** `𝓜ᵀ = 𝓜` (a Majorana mass matrix). -/
lemma seesawMatrix_symm (m_D M_N : ℝ) : (seesawMatrix m_D M_N)ᵀ = seesawMatrix m_D M_N := by
  ext i j; fin_cases i <;> fin_cases j <;> rfl

/-- **[Trace] `tr 𝓜 = M_N`.** -/
lemma seesawMatrix_trace (m_D M_N : ℝ) : (seesawMatrix m_D M_N).trace = M_N := by
  simp [seesawMatrix, Matrix.trace_fin_two]

/-- **[Determinant] `det 𝓜 = −m_D²`.** The seesaw determinant is minus the Dirac mass squared. -/
lemma seesawMatrix_det (m_D M_N : ℝ) : (seesawMatrix m_D M_N).det = -m_D ^ 2 := by
  rw [seesawMatrix, Matrix.det_fin_two_of]; ring

/-- **[The characteristic polynomial] `x² − M_N x − m_D²`.** The eigenvalues of the seesaw matrix are the
roots of `x² − (tr 𝓜) x + det 𝓜 = x² − M_N x − m_D²`. -/
lemma seesawMatrix_charpoly (m_D M_N x : ℝ) :
    x ^ 2 - (seesawMatrix m_D M_N).trace * x + (seesawMatrix m_D M_N).det
      = x ^ 2 - M_N * x - m_D ^ 2 := by
  rw [seesawMatrix_trace, seesawMatrix_det]; ring


/-- **The heavy seesaw eigenvalue** `m_+ = (M_N + √(M_N² + 4m_D²))/2`. -/
noncomputable def seesawEigenPlus (m_D M_N : ℝ) : ℝ :=
  (M_N + Real.sqrt (M_N ^ 2 + 4 * m_D ^ 2)) / 2

/-- **The light seesaw eigenvalue** `m_− = (M_N − √(M_N² + 4m_D²))/2` (negative; `m_light = −m_−`). -/
noncomputable def seesawEigenMinus (m_D M_N : ℝ) : ℝ :=
  (M_N - Real.sqrt (M_N ^ 2 + 4 * m_D ^ 2)) / 2

/-- **[Sum of eigenvalues = trace] `m_+ + m_− = M_N`** (Vieta). -/
lemma seesaw_eigen_sum (m_D M_N : ℝ) :
    seesawEigenPlus m_D M_N + seesawEigenMinus m_D M_N = M_N := by
  unfold seesawEigenPlus seesawEigenMinus; ring

/-- **[Product of eigenvalues = determinant] `m_+ · m_− = −m_D²`** (Vieta, the seesaw determinant). -/
lemma seesaw_eigen_prod (m_D M_N : ℝ) :
    seesawEigenPlus m_D M_N * seesawEigenMinus m_D M_N = -m_D ^ 2 := by
  unfold seesawEigenPlus seesawEigenMinus
  have h : Real.sqrt (M_N ^ 2 + 4 * m_D ^ 2) ^ 2 = M_N ^ 2 + 4 * m_D ^ 2 :=
    Real.sq_sqrt (by positivity)
  linear_combination (-1 / 4 : ℝ) * h

/-- **[The heavy eigenvalue is a root of the characteristic polynomial] `m_+² − M_N m_+ − m_D² = 0`.** -/
lemma seesawEigenPlus_root (m_D M_N : ℝ) :
    seesawEigenPlus m_D M_N ^ 2 - M_N * seesawEigenPlus m_D M_N - m_D ^ 2 = 0 := by
  unfold seesawEigenPlus
  have h : Real.sqrt (M_N ^ 2 + 4 * m_D ^ 2) ^ 2 = M_N ^ 2 + 4 * m_D ^ 2 :=
    Real.sq_sqrt (by positivity)
  linear_combination (1 / 4 : ℝ) * h

/-- **[The light eigenvalue is a root of the characteristic polynomial] `m_−² − M_N m_− − m_D² = 0`.** -/
lemma seesawEigenMinus_root (m_D M_N : ℝ) :
    seesawEigenMinus m_D M_N ^ 2 - M_N * seesawEigenMinus m_D M_N - m_D ^ 2 = 0 := by
  unfold seesawEigenMinus
  have h : Real.sqrt (M_N ^ 2 + 4 * m_D ^ 2) ^ 2 = M_N ^ 2 + 4 * m_D ^ 2 :=
    Real.sq_sqrt (by positivity)
  linear_combination (1 / 4 : ℝ) * h

/-- **[The seesaw lever relation] `m_heavy · m_light = m_D²`.** With the light mass `m_light = −m_−` (the
Majorana phase removed), the heavy and light masses multiply to the Dirac mass squared — the exact seesaw
suppression `m_light = m_D²/m_heavy`. This is the determinant relation, holding for *any* `M_N` (the usual
`m_light ≈ m_D²/M_N` is its large-`M_N` limit). -/
lemma seesaw_lever (m_D M_N : ℝ) :
    seesawEigenPlus m_D M_N * (- seesawEigenMinus m_D M_N) = m_D ^ 2 := by
  rw [mul_neg, seesaw_eigen_prod, neg_neg]

/-- **[Yukawa coupling drives the seesaw, assembled].** With the Dirac mass from the Yukawa coupling
`m_D = y_ν v/√2`, the Type-I seesaw matrix `𝓜 = [[0, m_D], [m_D, M_N]]`:

* has trace `M_N` and determinant `−m_D²`;
* its eigenvalues sum to `M_N` and multiply to `−m_D²`;
* the heavy and light masses obey the exact lever `m_heavy · m_light = m_D² = y_ν² v²/2`.

So a small Yukawa coupling `y_ν` and a large Majorana scale `M_N` suppress the light neutrino mass through
the seesaw, with the lever relation fixed exactly by the Yukawa coupling. -/
lemma yukawa_seesaw (y_ν v M_N : ℝ) :
    (seesawMatrix (yukawaMass y_ν v) M_N).trace = M_N
      ∧ (seesawMatrix (yukawaMass y_ν v) M_N).det = -(yukawaMass y_ν v) ^ 2
      ∧ seesawEigenPlus (yukawaMass y_ν v) M_N + seesawEigenMinus (yukawaMass y_ν v) M_N = M_N
      ∧ seesawEigenPlus (yukawaMass y_ν v) M_N * (- seesawEigenMinus (yukawaMass y_ν v) M_N)
          = y_ν ^ 2 * v ^ 2 / 2 := by
  refine ⟨seesawMatrix_trace _ M_N, seesawMatrix_det _ M_N, seesaw_eigen_sum _ M_N, ?_⟩
  rw [seesaw_lever, yukawaMass_sq]

end Physlib.QuantumMechanics.ComplexAction.Yukawa.SeesawMass

end
