module

public import Physlib.QuantumMechanics.ComplexAction.EntropicTime.PapapetrouStachelTorsionTetrad
public import Physlib.Relativity.CliffordAlgebra
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic

/-!
# Algebraic Einstein--Cartan torsion elimination

For a Dirac field the Cartan connection equation is algebraic.  The source is
the canonical axial current `J5^mu = Re(psi^dagger gamma0 gamma^mu gamma5 psi)`
built from Physlib's Dirac-representation gamma matrices.  A reduced
contorsion component `K_mu` with coefficient `kappa` obeys
`K_mu = kappa J5_mu`.  Eliminating that auxiliary connection component produces
the local Hehl--Datta axial-current contact density.
-/

set_option autoImplicit false
open scoped BigOperators Matrix

@[expose] public section

namespace Physlib.QuantumMechanics.ComplexAction.EinsteinCartanAxialTorsion

/-- The canonical four-complex-component Dirac spinor carrier. -/
abbrev ComplexDiracSpinor := Fin 4 → ℂ

/-- The real Dirac axial current
`J5^mu = Re(psi^dagger gamma0 gamma^mu gamma5 psi)` in the canonical Dirac
representation.  Taking the real part makes the real Cartan source explicit. -/
noncomputable def diracAxialCurrent (psi : ComplexDiracSpinor) (mu : Fin 4) : ℝ :=
  (∑ i, star (psi i) *
    (((spaceTime.γ0 * spaceTime.γ mu * spaceTime.γ5) *ᵥ psi) i)).re

/-- One reduced Cartan auxiliary-field density. -/
noncomputable def cartanAuxiliaryDensity (kappa K J5 : ℝ) : ℝ :=
  K ^ 2 / (2 * kappa) - K * J5

/-- The algebraic Cartan equation residual. -/
def cartanResidual (kappa K J5 : ℝ) : ℝ := K - kappa * J5

/-- The spin-sourced contorsion solving the reduced Cartan equation. -/
def sourcedContorsion (kappa J5 : ℝ) : ℝ := kappa * J5

@[simp] theorem sourcedContorsion_solves (kappa J5 : ℝ) :
    cartanResidual kappa (sourcedContorsion kappa J5) J5 = 0 := by
  simp [cartanResidual, sourcedContorsion]

/-- The Dirac-spinor-sourced contorsion field. -/
noncomputable def diracSourcedContorsion
    (kappa : ℝ) (psi : ComplexDiracSpinor) (mu : Fin 4) : ℝ :=
  sourcedContorsion kappa (diracAxialCurrent psi mu)

/-- The contorsion generated by the canonical Dirac axial current solves every
component of the reduced Cartan equation. -/
@[simp] theorem diracSourcedContorsion_solves
    (kappa : ℝ) (psi : ComplexDiracSpinor) (mu : Fin 4) :
    cartanResidual kappa (diracSourcedContorsion kappa psi mu)
      (diracAxialCurrent psi mu) = 0 := by
  exact sourcedContorsion_solves kappa (diracAxialCurrent psi mu)

/-- Eliminating the algebraic contorsion produces the axial-current contact
    density `-(kappa/2) J5^2`. -/
theorem cartanAuxiliaryDensity_at_solution
    (kappa J5 : ℝ) (hkappa : kappa ≠ 0) :
    cartanAuxiliaryDensity kappa (sourcedContorsion kappa J5) J5
      = -(kappa / 2) * J5 ^ 2 := by
  unfold cartanAuxiliaryDensity sourcedContorsion
  field_simp [hkappa]
  ring

/-- Squared norm of a finite axial-current vector. -/
def axialCurrentNormSq {ι : Type*} [Fintype ι] (J5 : ι → ℝ) : ℝ :=
  ∑ i, J5 i ^ 2

/-- The effective Hehl--Datta contact density after eliminating contorsion. -/
noncomputable def hehlDattaContactDensity {ι : Type*} [Fintype ι]
    (kappa : ℝ) (J5 : ι → ℝ) : ℝ :=
  -(kappa / 2) * axialCurrentNormSq J5

/-- Componentwise Cartan elimination equals the finite-dimensional contact
    density. -/
theorem eliminate_cartan_components {ι : Type*} [Fintype ι]
    (kappa : ℝ) (J5 : ι → ℝ) (hkappa : kappa ≠ 0) :
    (∑ i, cartanAuxiliaryDensity kappa (sourcedContorsion kappa (J5 i)) (J5 i))
      = hehlDattaContactDensity kappa J5 := by
  calc
    (∑ i, cartanAuxiliaryDensity kappa (sourcedContorsion kappa (J5 i)) (J5 i))
        = ∑ i, (-(kappa / 2) * J5 i ^ 2) := by
            apply Finset.sum_congr rfl
            intro i _
            exact cartanAuxiliaryDensity_at_solution kappa (J5 i) hkappa
    _ = -(kappa / 2) * ∑ i, J5 i ^ 2 := by
          rw [Finset.mul_sum]
    _ = hehlDattaContactDensity kappa J5 := rfl

/-- Eliminating the contorsion sourced by one canonical four-spinor gives the
Hehl--Datta contact density of that spinor's axial current. -/
theorem eliminate_dirac_cartan_spinor
    (kappa : ℝ) (psi : ComplexDiracSpinor) (hkappa : kappa ≠ 0) :
    (∑ mu, cartanAuxiliaryDensity kappa
      (diracSourcedContorsion kappa psi mu) (diracAxialCurrent psi mu))
      = hehlDattaContactDensity kappa (diracAxialCurrent psi) := by
  exact eliminate_cartan_components kappa (diracAxialCurrent psi) hkappa

/-- The canonical Dirac axial current, its algebraic Cartan equation, and the
eliminated contact interaction as one checked package. -/
theorem dirac_cartan_axial_elimination_assembly
    (kappa : ℝ) (psi : ComplexDiracSpinor) (hkappa : kappa ≠ 0) :
    (∀ mu, cartanResidual kappa (diracSourcedContorsion kappa psi mu)
      (diracAxialCurrent psi mu) = 0)
      ∧ (∑ mu, cartanAuxiliaryDensity kappa
        (diracSourcedContorsion kappa psi mu) (diracAxialCurrent psi mu))
          = hehlDattaContactDensity kappa (diracAxialCurrent psi) :=
  ⟨fun mu => diracSourcedContorsion_solves kappa psi mu,
    eliminate_dirac_cartan_spinor kappa psi hkappa⟩

end Physlib.QuantumMechanics.ComplexAction.EinsteinCartanAxialTorsion
