module

public import Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaFockDensityOperator
public import Mathlib.Analysis.Complex.Trigonometric

/-!
# Unitary dynamics `U(t) = e^{-itH}` of the single mode

The Schrödinger time evolution generated by the harmonic-oscillator Hamiltonian `H = ℏω(N + ½)`.  Because `H`
is diagonal in the number basis (`SciamaFockHamiltonian`), `e^{-itH}` acts diagonally with unit-modulus phases
`e^{-iω(n+½)t}`; it is built here directly as the bounded diagonal multiplier (Mathlib carries no Stone
theorem for unbounded generators, so the one-parameter unitary group is constructed explicitly).

* `evolutionOp ω t` — `U(t) = e^{-itH} : ℓ² →L[ℂ] ℓ²`, a bounded operator.
* `evolutionOp_apply_fockKet` — `U(t)|n⟩ = e^{-iω(n+½)t}|n⟩`: the number states are stationary up to a phase.
* `evolutionOp_zero` — `U(0) = 1`.
* `evolutionOp_comp` — `U(s)U(t) = U(s+t)`: the one-parameter **group law**.
* `evolutionOp_inner` — `⟨U(t)ψ, U(t)φ⟩ = ⟨ψ, φ⟩`: `U(t)` preserves the inner product (it is **unitary**).

Honest scope: the diagonal unitary group with its eigen-phases, group law, and inner-product preservation.
The self-adjoint generator / Stone correspondence is not invoked (Mathlib lacks it).
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaFockUnitaryDynamics

open scoped ENNReal
open RCLike
open Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaFockL2Completion
open Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaFockDensityOperator

local notation "⟪" x ", " y "⟫" => inner ℂ x y

/-- **The evolution phase** `e^{-iω(n+½)t}` (the `n`-th eigenvalue of `U(t) = e^{-itH}`). -/
def evolutionPhase (ω t : ℝ) (n : ℕ) : ℂ :=
  Complex.exp (((-(ω * ((n : ℝ) + 1 / 2) * t) : ℝ) : ℂ) * Complex.I)

/-- **[Unit modulus] `‖e^{-iω(n+½)t}‖ = 1`.** -/
@[simp] theorem norm_evolutionPhase (ω t : ℝ) (n : ℕ) : ‖evolutionPhase ω t n‖ = 1 := by
  rw [evolutionPhase, Complex.norm_exp_ofReal_mul_I]

/-- **[Phase group law] `e^{-iω(n+½)s}·e^{-iω(n+½)t} = e^{-iω(n+½)(s+t)}`.** -/
theorem evolutionPhase_mul (ω s t : ℝ) (n : ℕ) :
    evolutionPhase ω s n * evolutionPhase ω t n = evolutionPhase ω (s + t) n := by
  rw [evolutionPhase, evolutionPhase, evolutionPhase, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- **The evolution phases as a bounded `ℓ^∞` diagonal.** -/
def evolutionDiag (ω t : ℝ) : lp (fun _ : ℕ => ℂ) ∞ :=
  ⟨evolutionPhase ω t, by
    show Memℓp (evolutionPhase ω t) ∞
    rw [memℓp_infty_iff]
    exact ⟨1, by rintro x ⟨n, rfl⟩; simp⟩⟩

@[simp] theorem evolutionDiag_coe (ω t : ℝ) (n : ℕ) :
    (evolutionDiag ω t : ∀ _ : ℕ, ℂ) n = evolutionPhase ω t n := rfl

/-- **The evolution operator** `U(t) = e^{-itH}`: the diagonal multiplier by the evolution phases. -/
def evolutionOp (ω t : ℝ) : FockHilbert →L[ℂ] FockHilbert :=
  lp.holderL 2 (fun _ : ℕ => ContinuousLinearMap.mul ℂ ℂ) mul_norm_le (evolutionDiag ω t)

/-- **[Diagonal action] `(U(t)ψ)_n = e^{-iω(n+½)t} ψ_n`.** -/
theorem evolutionOp_apply_coe (ω t : ℝ) (ψ : FockHilbert) (n : ℕ) :
    (evolutionOp ω t ψ) n = evolutionPhase ω t n * ψ n := by
  simp only [evolutionOp, lp.holderL, LinearMap.mkContinuous₂_apply, lp.holderₗ_apply_apply_coe,
    ContinuousLinearMap.mul_apply', evolutionDiag_coe]

/-- **[Stationary phases] `U(t)|n⟩ = e^{-iω(n+½)t}|n⟩`.**  Number states are energy eigenstates, so they evolve
by a pure phase. -/
theorem evolutionOp_apply_fockKet (ω t : ℝ) (n : ℕ) :
    evolutionOp ω t (fockKet n) = evolutionPhase ω t n • fockKet n := by
  apply lp.ext
  funext i
  rw [evolutionOp_apply_coe, lp.coeFn_smul, Pi.smul_apply, smul_eq_mul, fockKet, lp.coeFn_single]
  rcases eq_or_ne i n with hi | hi
  · subst hi; simp
  · rw [Pi.single_eq_of_ne hi]; ring

/-- **[Identity at `t = 0`] `U(0) = 1`.** -/
theorem evolutionOp_zero (ω : ℝ) : evolutionOp ω 0 = ContinuousLinearMap.id ℂ FockHilbert := by
  ext ψ : 1
  apply lp.ext
  funext n
  rw [evolutionOp_apply_coe, evolutionPhase]
  simp [ContinuousLinearMap.id_apply]

/-- **[One-parameter group law] `U(s) U(t) = U(s+t)`.** -/
theorem evolutionOp_comp (ω s t : ℝ) :
    (evolutionOp ω s).comp (evolutionOp ω t) = evolutionOp ω (s + t) := by
  ext ψ : 1
  apply lp.ext
  funext n
  rw [ContinuousLinearMap.comp_apply, evolutionOp_apply_coe, evolutionOp_apply_coe,
    evolutionOp_apply_coe, ← mul_assoc, evolutionPhase_mul]

/-- **[Unitarity] `⟨U(t)ψ, U(t)φ⟩ = ⟨ψ, φ⟩`.**  Time evolution preserves the inner product — `U(t)` is
unitary (with inverse `U(-t)` from the group law and `U(0) = 1`). -/
theorem evolutionOp_inner (ω t : ℝ) (ψ φ : FockHilbert) :
    ⟪evolutionOp ω t ψ, evolutionOp ω t φ⟫ = ⟪ψ, φ⟫ := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  refine tsum_congr (fun n => ?_)
  rw [evolutionOp_apply_coe, evolutionOp_apply_coe, RCLike.inner_apply, RCLike.inner_apply, map_mul,
    show (evolutionPhase ω t n * φ n) * ((starRingEnd ℂ) (evolutionPhase ω t n) * (starRingEnd ℂ) (ψ n))
      = ((evolutionPhase ω t n) * (starRingEnd ℂ) (evolutionPhase ω t n)) * (φ n * (starRingEnd ℂ) (ψ n))
      from by ring, RCLike.mul_conj, norm_evolutionPhase]
  simp

end Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaFockUnitaryDynamics

end
