module

public import Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaAdSCPTBulkCorrespondence

/-!
# The charge-conjugation monodromy surface operator `M_σ` (Gomis 2507.12467, §4)

Gomis's §4: in any theory with a `C`-symmetry, a **codimension-two** conformal defect `M_σ` is defined by
requiring fields to undergo a nontrivial **charge-conjugation monodromy** when transported around it — a purely
infrared, ultraviolet-independent mechanism (the defect "can be detected from afar").

The holonomy of a loop linking the surface defect is fixed by the loop's **winding number** `n ∈ ℤ` and lands in
the `ℤ/2` generated by `C` (`C² = 1`), so the monodromy representation `π₁ = ℤ → ℤ/2` is

`monodromy(n) = n  (mod 2)`.

* `monodromy_additive` — the holonomy is a **group homomorphism** (winding numbers add);
* `monodromy_single_loop` — a single loop charge-conjugates (`monodromy 1 = 1`): the defect is **nontrivial**,
  detectable from afar;
* `monodromy_double_loop` — two loops are trivial (`monodromy 2 = 0`): the monodromy is exactly `ℤ/2`, matching
  `C² = 1` (`SciamaAdSCPTBulkCorrespondence.bulkC_involutive`);
* `monodromy_trivial_iff_even` — the holonomy detects the **parity of the linking number** (`monodromy n = 0 ↔
  n even`);
* `monodromyElement_single_loop` / `monodromyElement_double_loop` — the bulk realization: an odd-winding loop
  applies the bulk charge-conjugation `bulkC` (`= Ω(−1)^{F_L} R_{456789}`, Eq. 1.2), an even-winding loop the
  identity — the holographic image of `M_σ` as the AdS₅×S⁵ charge-conjugation defect.

So the surface operator's data is the `ℤ → ℤ/2` monodromy carrying the boundary `C` (an outer automorphism of the
gauge group), whose bulk dual is the geometric charge-conjugation transformation `Ω(−1)^{F_L} R_{456789}`.

Honest scope: the `ℤ → ℤ/2` monodromy homomorphism of the codimension-two defect and its bulk `C` element (the
paper's §4 defining structure).  The conformal-defect construction, its large-`N` expansion, and the bubbling
surface-operator geometry are the paper's content, contextualized here.
-/

set_option autoImplicit false

@[expose] public section

namespace Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaAdSCPTMonodromyDefect

open Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaAdSCPTBulkCorrespondence

/-- The **charge-conjugation monodromy** of a loop with winding number `n` around the codimension-two surface
operator `M_σ`: the holonomy `C^n` valued in `ℤ/2` (`C² = 1`). -/
def monodromy (n : ℤ) : ZMod 2 := (n : ZMod 2)

/-- The **bulk** holonomy of a linking loop: the geometric charge-conjugation `bulkC` for odd winding, the
identity for even winding. -/
def monodromyElement (n : ℤ) : BulkTransform := if monodromy n = 1 then bulkC else (0, 0, ∅)

/-- **[The monodromy is a homomorphism] `monodromy(m + n) = monodromy(m) + monodromy(n)`.**  Winding numbers of
composed linking loops add — the holonomy is a representation of `π₁ = ℤ`. -/
theorem monodromy_additive (m n : ℤ) : monodromy (m + n) = monodromy m + monodromy n := by
  simp [monodromy]

/-- **[A single loop charge-conjugates] `monodromy 1 = 1`.**  Transporting a field once around `M_σ` returns it
charge-conjugated — the defect is nontrivial and detectable from afar. -/
theorem monodromy_single_loop : monodromy 1 = 1 := by simp [monodromy]

/-- **[Two loops are trivial] `monodromy 2 = 0`.**  The monodromy is exactly `ℤ/2`, matching `C² = 1`. -/
theorem monodromy_double_loop : monodromy 2 = 0 := by decide

/-- **[The holonomy detects the linking parity] `monodromy n = 0 ↔ n even`.**  A loop is unobstructed iff it
links the surface defect an even number of times. -/
theorem monodromy_trivial_iff_even (n : ℤ) : monodromy n = 0 ↔ Even n := by
  rw [monodromy, ZMod.intCast_zmod_eq_zero_iff_dvd n 2, Int.even_iff]
  omega

/-- **[Bulk `M_σ`: a single loop applies charge conjugation] `monodromyElement 1 = bulkC`.**  An odd-winding
loop around the AdS₅×S⁵ charge-conjugation defect applies the geometric `Ω(−1)^{F_L} R_{456789}` (Eq. 1.2). -/
theorem monodromyElement_single_loop : monodromyElement 1 = bulkC := by
  rw [monodromyElement, if_pos monodromy_single_loop]

/-- **[Bulk `M_σ`: two loops are trivial] `monodromyElement 2 = (0,0,∅)`.**  An even-winding loop applies the
bulk identity — the `ℤ/2` charge-conjugation monodromy of the surface operator. -/
theorem monodromyElement_double_loop : monodromyElement 2 = (0, 0, ∅) := by
  rw [monodromyElement, if_neg]
  rw [monodromy_double_loop]
  decide

end Physlib.QuantumMechanics.ComplexAction.Lorentz.SciamaAdSCPTMonodromyDefect

end
