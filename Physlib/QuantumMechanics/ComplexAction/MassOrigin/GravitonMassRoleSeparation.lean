/-!
# Graviton role versus mass-generation mechanisms

This file records a small but important separation used by the gravity and
Standard Model parts of the repository:

* fermion rest mass is generated by the Higgs/Yukawa relation
  `m_f = y_f v / sqrt 2`;
* a topologically massive Chern-Simons graviton mode inherits its mass from
  the DJT/Chern-Simons topological mass;
* graviton exchange, metric perturbations, and double-copy gravity states are
  modeled as gravitational/curvature carriers, not as particles that give
  Standard Model fermions their masses.

The point is not to add a new physics assumption.  It is to make the category
distinction Lean-checkable and reusable by later files.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.QuantumMechanics.ComplexAction.MassOrigin.GravitonMassRoleSeparation

open Physlib.QuantumMechanics.ComplexAction.ChernSimons.GravitonDoubleCopy
open Physlib.QuantumMechanics.ComplexAction.Lorentz.GravityDoubleCopySuperoperator
open Physlib.QuantumMechanics.ComplexAction.Yukawa.StandardModelYukawaCoupling
open Physlib.QuantumMechanics.ComplexAction.ChernSimons.TopologicalMassDJT
open Physlib.QuantumMechanics.ComplexAction.Yukawa.MassDecoherenceProportionality


/-- Roles in which this repository models a graviton or gravitational excitation. -/
inductive GravitonRole where
  /-- Linearized metric perturbation `h_{μν}`. -/
  | metricPerturbation
  /-- Spin-two gravitational field excitation. -/
  | spinTwoExcitation
  /-- Mediator/carrier of gravitational interaction. -/
  | gravitationalMediator
  /-- Gravity state obtained from a gauge-theory double copy. -/
  | doubleCopyGravityState
  /-- Topologically massive Chern-Simons gravity mode. -/
  | topologicallyMassiveMode
deriving DecidableEq, Repr

/-- Mass mechanisms currently separated by the repository. -/
inductive MassSource where
  /-- Standard Model Higgs/Yukawa mass generation. -/
  | standardModelYukawaHiggs
  /-- Deser-Jackiw-Templeton/Chern-Simons topological mass. -/
  | chernSimonsTopological
  /-- Graviton exchange or a graviton mediator role. -/
  | gravitonExchange
  /-- A purely kinematic mediator description. -/
  | kinematicMediator
deriving DecidableEq, Repr

/--
The repository-level classification of mechanisms that generate a mass
parameter.  Higgs/Yukawa and Chern-Simons topology are mass mechanisms here;
graviton exchange is not.
-/
def SourceGeneratesMass (source : MassSource) : Prop :=
  source = .standardModelYukawaHiggs ∨ source = .chernSimonsTopological

/-- A graviton role is never itself classified as the Standard Model rest-mass generator. -/
def GravitonRole.isRestMassGenerator : GravitonRole → Bool
  | .metricPerturbation => false
  | .spinTwoExcitation => false
  | .gravitationalMediator => false
  | .doubleCopyGravityState => false
  | .topologicallyMassiveMode => false

@[simp] lemma gravitonRole_not_restMassGenerator (role : GravitonRole) :
    role.isRestMassGenerator = false := by
  cases role <;> rfl

@[simp] lemma standardModelYukawaHiggs_generatesMass :
    SourceGeneratesMass .standardModelYukawaHiggs := by
  simp [SourceGeneratesMass]

@[simp] lemma chernSimonsTopological_generatesMass :
    SourceGeneratesMass .chernSimonsTopological := by
  simp [SourceGeneratesMass]

@[simp] lemma gravitonExchange_not_massSource :
    ¬ SourceGeneratesMass .gravitonExchange := by
  simp [SourceGeneratesMass]

@[simp] lemma kinematicMediator_not_massSource :
    ¬ SourceGeneratesMass .kinematicMediator := by
  simp [SourceGeneratesMass]


/-- A fermion mass datum whose mass is generated by the Standard Model Yukawa equation. -/
structure FermionYukawaMassModel where
  /-- Dimensionless Yukawa coupling. -/
  y : ℝ
  /-- Higgs vacuum expectation value. -/
  v : ℝ
  /-- Generated fermion mass. -/
  mass : ℝ
  /-- The Standard Model mass equation `m_f = y_f v / sqrt 2`. -/
  mass_eq_yukawa : mass = yukawaMass y v

/--
The Higgs/Yukawa fermion mass equation and the recovered Higgs-fermion coupling
do not use graviton exchange as a mass source.
-/
lemma fermionYukawaMass_not_from_gravitonExchange
    (M : FermionYukawaMassModel) (hv : M.v ≠ 0) :
    M.mass = yukawaMass M.y M.v ∧
      yukawaCoupling M.mass M.v = M.y ∧
      ¬ SourceGeneratesMass .gravitonExchange := by
  refine ⟨M.mass_eq_yukawa, ?_, gravitonExchange_not_massSource⟩
  rw [M.mass_eq_yukawa]
  exact yukawaCoupling_yukawaMass M.y M.v hv

/--
Equivalently, after electroweak symmetry breaking the physical Higgs-fermion
coupling is `m_f/v = y_f/sqrt 2`, with no graviton-exchange mass source.
-/
lemma higgsFermionCoupling_not_gravitonExchange
    (y v : ℝ) (hv : v ≠ 0) :
    higgsFermionCouplingFromMass (yukawaMass y v) v =
        higgsFermionCouplingFromYukawa y ∧
      ¬ SourceGeneratesMass .gravitonExchange := by
  exact ⟨higgsFermionCouplingFromMass_yukawaMass_eq y v hv,
    gravitonExchange_not_massSource⟩


/--
A topologically massive Chern-Simons graviton mode inherits its mass from the
existing DJT topological mass formula; the mass is not generated by graviton
exchange.
-/
lemma chernSimonsGravitonMass_not_from_gravitonExchange
    (D : ChernSimonsGravitonMassData) :
    D.gravitonMass = topologicalMass D.gaugeData ∧
      0 ≤ D.gravitonMass ∧
      ¬ SourceGeneratesMass .gravitonExchange := by
  exact ⟨D.mass_eq_topologicalMass, chernSimonsGravitonMass_nonneg D,
    gravitonExchange_not_massSource⟩

/--
For nonzero coupling, the Chern-Simons graviton mass vanishes exactly when the
CS level vanishes.  This identifies the mass source as the topological term,
not the graviton mediator role.
-/
lemma chernSimonsGravitonMass_zero_iff_level_zero_not_gravitonExchange
    (D : ChernSimonsGravitonMassData) (he : D.gaugeData.e ≠ 0) :
    (D.gravitonMass = 0 ↔ D.gaugeData.level = 0) ∧
      ¬ SourceGeneratesMass .gravitonExchange := by
  exact ⟨chernSimonsGravitonMass_zero_iff_level_zero D he,
    gravitonExchange_not_massSource⟩


/--
The operator-level gravity model is the curvature/tidal double copy `F²`, while
the mass-source classification still excludes graviton exchange.
-/
lemma gravityDoubleCopyOperator_not_massSource
    (F : Matrix (Fin 4) (Fin 4) ℝ) :
    gravCurvatureGen F = (lorentzGen F).comp (lorentzGen F) ∧
      ¬ SourceGeneratesMass .gravitonExchange := by
  exact ⟨gravCurvatureGen_eq_comp F, gravitonExchange_not_massSource⟩

/--
Main separation theorem: in one checked statement, Standard Model fermion mass
comes from the Yukawa/Higgs equation, a massive Chern-Simons graviton mode gets
its own mass from topological DJT data, and graviton exchange is not a mass
mechanism.
-/
lemma graviton_not_mass_giver_summary
    (y v : ℝ) (hv : v ≠ 0) (D : ChernSimonsGravitonMassData) :
    yukawaCoupling (yukawaMass y v) v = y ∧
      higgsFermionCouplingFromMass (yukawaMass y v) v =
        higgsFermionCouplingFromYukawa y ∧
      D.gravitonMass = topologicalMass D.gaugeData ∧
      0 ≤ D.gravitonMass ∧
      ¬ SourceGeneratesMass .gravitonExchange := by
  exact ⟨yukawaCoupling_yukawaMass y v hv,
    higgsFermionCouplingFromMass_yukawaMass_eq y v hv,
    D.mass_eq_topologicalMass,
    chernSimonsGravitonMass_nonneg D,
    gravitonExchange_not_massSource⟩

/-! ### The underdetermination result: the Yukawa relation cannot fix the mass value -/

/-- **The Yukawa relation is exactly solvable for every mass value**: at any fixed vacuum
value `v ≠ 0`, each mass `m` is realized by exactly one coupling `y = √2·m/v`.  The
relation `m = yv/√2` therefore excludes no mass value — it has no selection power over
`m`.  It is a bijective reparametrization `y ↔ m` at fixed `v`, and throughout this
repository the arrow is read accordingly: the coupling is computed from the mass
(`yukawaCoupling_yukawaMass`, `yukawa_isolated`), never the mass from the coupling. -/
theorem yukawaMass_underdetermined (m v : ℝ) (hv : v ≠ 0) :
    ∃! y : ℝ, yukawaMass y v = m := by
  refine ⟨yukawaCoupling m v, yukawaMass_yukawaCoupling m v hv, ?_⟩
  intro y hy
  calc y = yukawaCoupling (yukawaMass y v) v := (yukawaCoupling_yukawaMass y v hv).symm
    _ = yukawaCoupling m v := by rw [hy]

/-- **Reduction to absurdity, general form: any genuine Yukawa-grounded mass selection is
contradictory.**  Assume the sector selects mass values through a criterion `select` that
(a) admits every mass the Yukawa relation realizes and (b) genuinely excludes at least
one value — the minimal demands on a selection whose only source is the relation
`m = yv/√2`.  Contradiction: the excluded value is itself realized, by the coupling
`√2·m/v`.  A Yukawa-grounded selection must admit everything, hence selects nothing. -/
theorem yukawa_exclusion_absurd (v : ℝ) (hv : v ≠ 0) (select : ℝ → Prop)
    (hrealized : ∀ m, (∃ y, yukawaMass y v = m) → select m)
    (hproper : ∃ m, ¬ select m) : False := by
  obtain ⟨m, hm⟩ := hproper
  exact hm (hrealized m ⟨yukawaCoupling m v, yukawaMass_yukawaCoupling m v hv⟩)

/-- **Reduction to absurdity, pointed form: Yukawa determination of the mass is
contradictory.**  Assume the relation at fixed vacuum value determined the mass — every
realized mass equal to one distinguished value `m₀`.  Then `m₀ + 1` is also realized
(`y = √2(m₀+1)/v`), forcing `m₀ + 1 = m₀`.  Absurd: the Yukawa relation cannot
determine the mass value. -/
theorem yukawa_determination_absurd (v : ℝ) (hv : v ≠ 0) (m₀ : ℝ)
    (hdet : ∀ y m, yukawaMass y v = m → m = m₀) : False := by
  have h2 : m₀ + 1 = m₀ :=
    hdet (yukawaCoupling (m₀ + 1) v) (m₀ + 1)
      (yukawaMass_yukawaCoupling (m₀ + 1) v hv)
  linarith

/-- **The Higgs/Yukawa sector is a mass mechanism that cannot fix the mass value.**  The
two statements together are the sharp claim: the classification records the sector as a
mass *mechanism* — the gauge-invariant parameter relation `m = yv/√2` — while the
underdetermination theorem shows that relation selects no value of `m`: every candidate
mass is exactly realizable, so the value is an input from outside the sector (in this
repository, the Compton-clock anchor; and the same clock has Higgs-free closed forms,
`HiggsClockThreeOrigins.higgs_clock_three_origins`).  This is the value-selection
negative only — it does not refute the electroweak gauge structure. -/
theorem yukawaHiggs_no_mass_value_selection (v : ℝ) (hv : v ≠ 0) :
    (∀ m : ℝ, ∃! y : ℝ, yukawaMass y v = m)
      ∧ SourceGeneratesMass .standardModelYukawaHiggs :=
  ⟨fun m => yukawaMass_underdetermined m v hv,
   standardModelYukawaHiggs_generatesMass⟩

/-! ### Why the mass value must be an external input: dilation-invariant selections
are trivial -/

/-- **A dilation-invariant selection cannot distinguish positive masses.**  If a
criterion respects the dilation symmetry (selecting `m` forces selecting `μm` for every
`μ > 0`) and selects any one positive mass, it selects them all.  The kinematics is
dilation-covariant with definite weights (`bogoliubovEnergy_dilation`,
`foldyConnectionStrength_dilation`, `contourForm_dilation`), so every selection built
from its equations inherits this invariance — and is therefore trivial on positive
masses: all or nothing.  No internal equation of a scale-covariant system can pick the
mass value. -/
theorem dilation_invariant_selection_trivial (select : ℝ → Prop)
    (hsel : ∀ μ m : ℝ, 0 < μ → select m → select (μ * m))
    (m₀ : ℝ) (h₀ : 0 < m₀) (hm₀ : select m₀) :
    ∀ m : ℝ, 0 < m → select m := by
  intro m hm
  have h := hsel (m / m₀) m₀ (div_pos hm h₀) hm₀
  rwa [div_mul_cancel₀ m h₀.ne'] at h

/-- **Reduction to absurdity, covariant form: a scale-covariant theory that both selects
a positive mass and excludes a positive mass is contradictory.**  This is the structural
reason the mass value is an *external input*: the covariant equations cannot exclude any
positive value once they admit one, so the number itself must enter from outside the
covariant system — in this repository, through the Compton-clock anchor, which fixes the
tick to the mass without deriving it. -/
theorem dilation_covariant_determination_absurd (select : ℝ → Prop)
    (hsel : ∀ μ m : ℝ, 0 < μ → select m → select (μ * m))
    (m₀ : ℝ) (h₀ : 0 < m₀) (hm₀ : select m₀)
    (hexcl : ∃ m : ℝ, 0 < m ∧ ¬ select m) : False := by
  obtain ⟨m, hm, hnot⟩ := hexcl
  exact hnot (dilation_invariant_selection_trivial select hsel m₀ h₀ hm₀ m hm)

