module

public import Physlib.QuantumMechanics.ComplexAction.Electromagnetic.EMLorentzCombinedSuperoperator
public import Physlib.QuantumMechanics.ComplexAction.ParametrizedTetradGravity.QuadrupoleEmission
public import Physlib.QuantumMechanics.ComplexAction.ParametrizedTetradGravity.EMParticleDynamics

/-!
# GW quadrupole emission & EM dynamics evaluated through the fused superoperator `emLorentzGenerator`

Links both the **gravitational quadrupole emission** (`ParametrizedTetradGravity.QuadrupoleEmission`, Part 2) and the
**Einstein–Maxwell-particle dynamics** (`ParametrizedTetradGravity.EMParticleDynamics`, Part 1) to the single **fused
Lorentz–EM superoperator** `𝒢_{J,F} = ad_{J+F} = emLorentzGenerator J F` (`Electromagnetic.EMLorentzCombinedSuperoperator`):
the Heisenberg time evolution of *every* observable — the gravitational quadrupole and the electromagnetic
field alike — is generated by `𝒢_{J,F}`, with `J` the Lorentz (gravity) generator and `F` the EM field
strength.

So the third time-derivative in the quadrupole formula is the **third iterate of `emLorentzGenerator`**,

  `Q⃛ = (ad_{J+F})³ Q = 𝒢_{J,F}(𝒢_{J,F}(𝒢_{J,F} Q))`   (`adQuadrupole3`),

and the radiated power is evaluated through it (`gwPowerSuperop = (G/5c⁵)·Q⃛_ij Q⃛^ij`), non-negative
(`gwPowerSuperop_nonneg`), vanishing iff `𝒢_{J,F}` does not accelerate the quadrupole
(`gwPowerSuperop_eq_zero_iff`); the energy balance `dÊ_ADM/dt = −P ≤ 0` is `adm_energy_decreases_superop`.

Crucially, the single drive splits into the **gravity and EM contributions** (`emLorentzGenerator_decompose`):

  `𝒢_{J,F} Q = ad_J Q + ad_F Q`   (`quadrupole_drive_gravity_add_em`),

so the Lorentz/gravity part `ad_J` (Part 2) and the electromagnetic part `ad_F` (Part 1) are the two halves of
the *same* superoperator driving the emission — the Einstein–Maxwell coupling realized at the operator level.

* **§A — the fused superoperator drives the evolution** (`adQuadrupole3`, `quadrupole_drive_gravity_add_em`).
* **§B — the GW power through the superoperator** (`frobeniusSq`, `gwPowerSuperop`, `gwPowerSuperop_nonneg`,
  `gwPowerSuperop_eq_zero_iff`).
* **§C — the energy balance** (`admEnergyRate_superop`, `adm_energy_decreases_superop`).

## References

* D. Alba, L. Lusanna, Can. J. Phys. 90 (2012) 1017 / 1077 (Parts 1–2; the EM-particle dynamics, the
  quadrupole emission).
* Repo carriers: `Electromagnetic.EMLorentzCombinedSuperoperator` (`emLorentzGenerator = ad_{J+F}`,
  `emLorentzGenerator_decompose`), `ParametrizedTetradGravity.QuadrupoleEmission`, `ParametrizedTetradGravity.EMParticleDynamics`.


-/

set_option autoImplicit false

@[expose] public section

namespace Physlib.QuantumMechanics.ComplexAction.ParametrizedTetradGravity.QuadrupoleSuperoperator

open Finset
open Physlib.QuantumMechanics.ComplexAction.CollisionOperatorSl2.CollisionModular
open Physlib.QuantumMechanics.ComplexAction.Electromagnetic.EMFieldSuperoperator
open Physlib.QuantumMechanics.ComplexAction.Electromagnetic.EMLorentzCombinedSuperoperator


/-- **[Third Heisenberg time-derivative via the fused superoperator] `Q⃛ = (ad_{J+F})³ Q`** — the third time
derivative of an observable `Q` under the combined Lorentz–EM Hamiltonian `H = J + F` is the third iterate of
`emLorentzGenerator J F = ad_{J+F}`. -/
noncomputable def adQuadrupole3 (J F Q : Mat) : Mat :=
  emLorentzGenerator J F (emLorentzGenerator J F (emLorentzGenerator J F Q))

/-- **[Gravity + EM split] `𝒢_{J,F} Q = ad_J Q + ad_F Q`** — the single time-evolution drive decomposes into the
Lorentz/gravity superoperator `ad_J` (Part 2) plus the electromagnetic superoperator `ad_F` (Part 1)
(`emLorentzGenerator_decompose`): the two halves of the *same* generator. -/
lemma quadrupole_drive_gravity_add_em (J F Q : Mat) :
    emLorentzGenerator J F Q = emFieldAdjoint J Q + emFieldAdjoint F Q := by
  rw [emLorentzGenerator_decompose, LinearMap.add_apply]


/-- **The Frobenius contraction** `Q_ij Q^ij = Σ_ij (Q_ij)²`. -/
noncomputable def frobeniusSq (X : Mat) : ℝ := ∑ i, ∑ j, X i j ^ 2

/-- **[Einstein quadrupole power through `emLorentzGenerator`] `P = (G/5c⁵)·((ad_{J+F})³Q)_ij ((ad_{J+F})³Q)^ij`**
— the gravitational luminosity evaluated with the third time-derivative computed by the fused Lorentz–EM
superoperator. -/
noncomputable def gwPowerSuperop (G c : ℝ) (J F Q : Mat) : ℝ :=
  (G / (5 * c ^ 5)) * frobeniusSq (adQuadrupole3 J F Q)

/-- **[Energy flows out] `P ≥ 0`** — a Frobenius sum of squares. -/
lemma gwPowerSuperop_nonneg (G c : ℝ) (J F Q : Mat) (hG : 0 ≤ G) (hc : 0 < c) :
    0 ≤ gwPowerSuperop G c J F Q := by
  rw [gwPowerSuperop, frobeniusSq]
  apply mul_nonneg (by positivity)
  exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => sq_nonneg _

/-- **[No emission iff the fused superoperator does not accelerate `Q`] `P = 0 ⟺ (ad_{J+F})³ Q = 0`** — the
source radiates exactly when `𝒢_{J,F}` applied three times is non-zero. -/
lemma gwPowerSuperop_eq_zero_iff (G c : ℝ) (J F Q : Mat) (hG : 0 < G) (hc : 0 < c) :
    gwPowerSuperop G c J F Q = 0 ↔ ∀ i j, adQuadrupole3 J F Q i j = 0 := by
  rw [gwPowerSuperop, frobeniusSq, mul_eq_zero, or_iff_right (by positivity)]
  constructor
  · intro h i j
    have h2 := (Finset.sum_eq_zero_iff_of_nonneg
      (fun i _ => Finset.sum_nonneg fun j _ => sq_nonneg (adQuadrupole3 J F Q i j))).mp
      h i (Finset.mem_univ i)
    have h3 := (Finset.sum_eq_zero_iff_of_nonneg
      (fun j _ => sq_nonneg (adQuadrupole3 J F Q i j))).mp h2 j (Finset.mem_univ j)
    exact pow_eq_zero_iff (by norm_num) |>.mp h3
  · intro h; simp [h]


/-- **[Energy balance] `dÊ_ADM/dt = −P`** evaluated through the fused superoperator. -/
noncomputable def admEnergyRate_superop (G c : ℝ) (J F Q : Mat) : ℝ := -gwPowerSuperop G c J F Q

/-- **[Back-reaction] `dÊ_ADM/dt ≤ 0`** — the conserved ADM energy is carried away by the radiation generated by
`emLorentzGenerator`. -/
lemma adm_energy_decreases_superop (G c : ℝ) (J F Q : Mat) (hG : 0 ≤ G) (hc : 0 < c) :
    admEnergyRate_superop G c J F Q ≤ 0 := by
  rw [admEnergyRate_superop, neg_nonpos]
  exact gwPowerSuperop_nonneg G c J F Q hG hc


/-- **[Einstein–Maxwell radiation from one superoperator] the unification.** A single statement that the one
fused superoperator `𝒢_{J,F} = emLorentzGenerator J F` runs the whole Einstein–Maxwell-particle radiation
problem. For any observable `Q` (with `G ≥ 0`, `c > 0`) it is simultaneously:

1. **the adjoint / Liouville / modular generator** `𝒢_{J,F} Q = [J+F, Q] = collisionStar (J+F) Q` — the same
   `ad = collisionStar` superoperator carried throughout the repo (modular flow, TFD hat-Hamiltonian,
   Misra–Prigogine Liouvillian, complex-Einstein Liouvillian);
2. **the sum of the gravity and electromagnetic drives** `𝒢_{J,F} Q = ad_J Q + ad_F Q` — the Lorentz/gravity
   superoperator (Part 2) plus the EM superoperator (Part 1), the Einstein–Maxwell coupling at the operator
   level;
3. **the generator of the quadrupole's third time-derivative** `Q⃛ = 𝒢_{J,F}(𝒢_{J,F}(𝒢_{J,F} Q))`, whose
   Frobenius norm is the **non-negative** gravitational-wave luminosity `P = (G/5c⁵)·Q⃛_ij Q⃛^ij ≥ 0`;
4. **the source of the back-reaction** `dÊ_ADM/dt = −P ≤ 0` — the conserved ADM energy radiated away as
   gravitational waves.

Gravity and electromagnetism emit gravitational radiation, conserve energy, and evolve in time, all through the
single `ad_{J+F}` superoperator. -/
lemma einsteinMaxwell_radiation_one_superoperator (G c : ℝ) (J F Q : Mat)
    (hG : 0 ≤ G) (hc : 0 < c) :
    emLorentzGenerator J F Q = collisionStar (J + F) Q
      ∧ emLorentzGenerator J F Q = emFieldAdjoint J Q + emFieldAdjoint F Q
      ∧ adQuadrupole3 J F Q
          = emLorentzGenerator J F (emLorentzGenerator J F (emLorentzGenerator J F Q))
      ∧ 0 ≤ gwPowerSuperop G c J F Q
      ∧ admEnergyRate_superop G c J F Q ≤ 0 :=
  ⟨emFieldAdjoint_eq_collisionStar (J + F) Q,
    quadrupole_drive_gravity_add_em J F Q, rfl,
    gwPowerSuperop_nonneg G c J F Q hG hc,
    adm_energy_decreases_superop G c J F Q hG hc⟩

end Physlib.QuantumMechanics.ComplexAction.ParametrizedTetradGravity.QuadrupoleSuperoperator

end
