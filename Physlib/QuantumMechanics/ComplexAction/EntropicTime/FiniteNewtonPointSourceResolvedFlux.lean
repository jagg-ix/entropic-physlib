/-!
# Source-resolved spherical flux for finite Newton point sources

For a finite family of Newtonian point sources, this module assigns a separate positive-radius
round sphere to every source. Each sphere is centered at its own source, so the existing translated
isolated-source flux theorem applies directly. The resulting source-resolved flux is

`∑ i, 4π G Mᵢ = 4π G ∑ i, Mᵢ`.

The distributional finite-source Poisson law can consequently be written with the actual centered
sphere flux of each source as the coefficient of its Dirac delta. This supplies a genuine finite
flux decomposition without postulating an off-center solid-angle identity.

The construction is not the flux of the total superposed field through one enclosing sphere, nor
the flux of that total field through the union of the source-centered spheres: cross-source terms
are not evaluated. A single enclosing-screen theorem requires an off-center Gauss-law or spherical
divergence theorem that is not presently available in the repository.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace
  Physlib.QuantumMechanics.ComplexAction.EntropicTime.FiniteNewtonPointSourceResolvedFlux

open scoped Space
open Physlib
open Physlib.Thermodynamics
open Physlib.QuantumMechanics.ComplexAction.ComptonClock.DistributionalWeakFieldEinstein00
open Physlib.QuantumMechanics.ComplexAction.EntropicTime.FiniteNewtonPointSources
open
  Physlib.QuantumMechanics.ComplexAction.EntropicTime.FiniteNewtonPointSourcesEinstein00
open Physlib.QuantumMechanics.ComplexAction.EntropicTime.HorizonNagaoContourBitEinstein
open Physlib.QuantumMechanics.ComplexAction.EntropicTime.IsolatedNewtonHodgeSphereFlux
open
  Physlib.QuantumMechanics.ComplexAction.NonHermitianComplexAction.EntropicDampingEquivalence
open
  Physlib.QuantumMechanics.ComplexAction.MassOrigin.GravitationalMassHorizonEntropyNoYukawa

/-! ## A. Source-resolved flux -/

/--
The sum of the actual fluxes through a family of round spheres, where sphere `i` is centered at
source `x i`, has radius `r i`, and carries only the exterior field generated by source `i`.
-/
def finiteNewtonSourceResolvedSphereFlux3 {ι : Type*} [Fintype ι]
    (G : ℝ) (M : ι → ℝ) (x : ι → Space 3) (r : ι → ℝ) : ℝ :=
  ∑ i, sphereFluxIntegral3At (x i) (r i)
    (isolatedNewtonExteriorField3At G (M i) (x i))

/-- Every positive-radius source-centered flux contributes its isolated value `4πGMᵢ`. -/
lemma finiteNewtonSourceResolvedSphereFlux3_expanded
    {ι : Type*} [Fintype ι] (G : ℝ) (M : ι → ℝ)
    (x : ι → Space 3) (r : ι → ℝ) (hr : ∀ i, 0 < r i) :
    finiteNewtonSourceResolvedSphereFlux3 G M x r =
      ∑ i, 4 * Real.pi * G * M i := by
  rw [finiteNewtonSourceResolvedSphereFlux3]
  apply Finset.sum_congr rfl
  intro i _
  exact isolatedNewtonExteriorField3At_sphereFlux G (M i) (r i) (x i) (hr i)

/-- The total source-resolved flux is `4πG` times the finite total mass. -/
lemma finiteNewtonSourceResolvedSphereFlux3_eq_totalMass
    {ι : Type*} [Fintype ι] (G : ℝ) (M : ι → ℝ)
    (x : ι → Space 3) (r : ι → ℝ) (hr : ∀ i, 0 < r i) :
    finiteNewtonSourceResolvedSphereFlux3 G M x r =
      4 * Real.pi * G * finiteTotalMass M := by
  rw [finiteNewtonSourceResolvedSphereFlux3_expanded G M x r hr, finiteTotalMass,
    Finset.mul_sum]

/-! ## B. Flux-resolved distributional Poisson law -/

/--
The Dirac-source distribution whose coefficient at source `i` is its actual centered-sphere flux.
-/
def finiteNewtonSourceResolvedFluxDistribution3 {ι : Type*} [Fintype ι]
    (G : ℝ) (M : ι → ℝ) (x : ι → Space 3) (r : ι → ℝ) :
    (Space 3) →d[ℝ] ℝ :=
  ∑ i, sphereFluxIntegral3At (x i) (r i)
      (isolatedNewtonExteriorField3At G (M i) (x i)) •
        Physlib.Distribution.diracDelta ℝ (x i)

/--
For positive source-centered radii, the finite potential's distributional Laplacian is exactly
the Dirac sum weighted by the actual flux measured around each source.
-/
lemma finiteNewtonPotentialDistribution3_laplacian_eq_sourceResolvedFlux
    {ι : Type*} [Fintype ι] (G : ℝ) (M : ι → ℝ)
    (x : ι → Space 3) (r : ι → ℝ) (hr : ∀ i, 0 < r i) :
    Δᵈ (finiteNewtonPotentialDistribution3 G M x) =
      finiteNewtonSourceResolvedFluxDistribution3 G M x r := by
  rw [finiteNewtonPotentialDistribution3_laplacian_expanded,
    finiteNewtonSourceResolvedFluxDistribution3]
  apply Finset.sum_congr rfl
  intro i _
  rw [isolatedNewtonExteriorField3At_sphereFlux G (M i) (r i) (x i) (hr i)]

/-! ## C. Translation covariance -/

/--
A common translation of all source centers leaves the source-resolved scalar flux unchanged.
-/
lemma finiteNewtonSourceResolvedSphereFlux3_translate
    {ι : Type*} [Fintype ι] (a : EuclideanSpace ℝ (Fin 3))
    (G : ℝ) (M : ι → ℝ) (x : ι → Space 3) (r : ι → ℝ)
    (hr : ∀ i, 0 < r i) :
    finiteNewtonSourceResolvedSphereFlux3 G M (translatePointConfiguration3 a x) r =
      finiteNewtonSourceResolvedSphereFlux3 G M x r := by
  rw [finiteNewtonSourceResolvedSphereFlux3_eq_totalMass G M
      (translatePointConfiguration3 a x) r hr,
    finiteNewtonSourceResolvedSphereFlux3_eq_totalMass G M x r hr]

/--
A common translation carries the complete flux-weighted Dirac distribution to the translated
source configuration.
-/
lemma finiteNewtonSourceResolvedFluxDistribution3_translate
    {ι : Type*} [Fintype ι] (a : EuclideanSpace ℝ (Fin 3))
    (G : ℝ) (M : ι → ℝ) (x : ι → Space 3) (r : ι → ℝ)
    (hr : ∀ i, 0 < r i) :
    Space.distTranslate a (finiteNewtonSourceResolvedFluxDistribution3 G M x r) =
      finiteNewtonSourceResolvedFluxDistribution3 G M
        (translatePointConfiguration3 a x) r := by
  rw [finiteNewtonSourceResolvedFluxDistribution3,
    finiteNewtonSourceResolvedFluxDistribution3, map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_smul, Space.distTranslate_diracDelta]
  change sphereFluxIntegral3At (x i) (r i)
      (isolatedNewtonExteriorField3At G (M i) (x i)) •
        Physlib.Distribution.diracDelta ℝ (a +ᵥ x i) =
    sphereFluxIntegral3At (a +ᵥ x i) (r i)
      (isolatedNewtonExteriorField3At G (M i) (a +ᵥ x i)) •
        Physlib.Distribution.diracDelta ℝ (a +ᵥ x i)
  rw [isolatedNewtonExteriorField3At_sphereFlux G (M i) (r i) (x i) (hr i),
    isolatedNewtonExteriorField3At_sphereFlux G (M i) (r i) (a +ᵥ x i) (hr i)]

/-! ## D. Distributional Einstein-to-source-flux-to-screen chain -/

/--
The scalar distributional Einstein equation, source-resolved actual sphere fluxes, and the
total-mass entropic-screen identities coexist in one finite-source chain.

The radii `r i` belong to separate source-centered Gaussian spheres. The holographic screen radius
`R` is a distinct algebraic screen parameter; no claim is made that this one screen encloses the
sources or that the total superposed field has the displayed source-resolved flux through it.
-/
lemma finiteNewtonPointSources_sourceResolvedFlux_distributionalEinstein00_bitCount_chain
    {ι : Type*} [Fintype ι] (S_R G ℏ c N R : ℝ)
    (M : ι → ℝ) (x : ι → Space 3) (r : ι → ℝ)
    (hℏ : ℏ ≠ 0) (hc : c ≠ 0) (hG : G ≠ 0) (hR : 0 < R)
    (hr : ∀ i, 0 < r i)
    (hbits : N = holographicBits (sphereArea R) G ℏ c) :
    DistributionalWeakFieldEinstein00Equation3 G c
        (finiteNewtonPotentialDistribution3 G M x)
        (finitePointMassDistribution3 M x)
      ∧ Δᵈ (finiteNewtonPotentialDistribution3 G M x) =
        finiteNewtonSourceResolvedFluxDistribution3 G M x r
      ∧ finiteNewtonSourceResolvedSphereFlux3 G M x r =
        4 * Real.pi * G * finiteTotalMass M
      ∧ G * finiteTotalMass M / R ^ 2 =
        4 * Real.pi * finiteTotalMass M * c ^ 3 / (ℏ * N)
      ∧ ‖nnPathWeight S_R (horizonImaginaryAction G c (sphereArea R)) ℏ‖ =
        Real.exp (-(N / 4))
      ∧ 8 * Real.pi * G / c ^ 4 =
        8 * Real.pi * (sphereArea R / N) / (ℏ * c) := by
  have hChain :=
    finiteNewtonPointSources_distributionalEinstein00_bitCount_chain
      S_R G ℏ c N R M x hℏ hc hG hR hbits
  exact ⟨hChain.1,
    finiteNewtonPotentialDistribution3_laplacian_eq_sourceResolvedFlux G M x r hr,
    finiteNewtonSourceResolvedSphereFlux3_eq_totalMass G M x r hr,
    hChain.2.2.2.1, hChain.2.2.2.2.1, hChain.2.2.2.2.2⟩

end
  Physlib.QuantumMechanics.ComplexAction.EntropicTime.FiniteNewtonPointSourceResolvedFlux

end
