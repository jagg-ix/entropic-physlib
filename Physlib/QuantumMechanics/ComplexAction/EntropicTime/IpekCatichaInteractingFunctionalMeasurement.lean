/-! ## A. Measurable interacting functional Hamiltonian -/

/-- A measurable configuration-local interacting functional Hamiltonian on `(X, μ)`. -/
structure InteractingFunctionalModel (X : Type*) [MeasurableSpace X] where
  /-- Reference measure on field configurations. -/
  μ : Measure X
  /-- Positive Planck constant. -/
  hbar : ℝ
  /-- Positivity of Planck's constant. -/
  hbar_pos : 0 < hbar
  /-- Free energy in the chosen diagonal representation. -/
  freeEnergy : X → ℝ
  /-- Configuration-local interaction energy. -/
  interactionEnergy : X → ℝ
  /-- Measurability of the free energy. -/
  measurable_freeEnergy : Measurable freeEnergy
  /-- Measurability of the interaction energy. -/
  measurable_interactionEnergy : Measurable interactionEnergy

namespace InteractingFunctionalModel

variable {X : Type*} [MeasurableSpace X] (M : InteractingFunctionalModel X)

/-- The Hilbert space of square-integrable wave functionals. -/
abbrev Hilbert := Lp (α := X) ℂ 2 M.μ

/-- Total free-plus-interaction energy `E₀ + V`. -/
def totalEnergy (x : X) : ℝ := M.freeEnergy x + M.interactionEnergy x

/-- The total interacting energy is measurable. -/
lemma measurable_totalEnergy : Measurable M.totalEnergy := by
  unfold totalEnergy
  exact M.measurable_freeEnergy.add M.measurable_interactionEnergy

/-- The unit-modulus phase generated by the interacting energy. -/
def phase (t : ℝ) (x : X) : ℂ :=
  Complex.exp (-Complex.I * Complex.ofReal (t * M.totalEnergy x / M.hbar))

@[simp] lemma phase_zero (x : X) : M.phase 0 x = 1 := by
  simp [phase]

@[simp] lemma norm_phase (t : ℝ) (x : X) : ‖M.phase t x‖ = 1 := by
  rw [phase, Complex.norm_exp]
  simp [Complex.mul_re]

/-- Interacting phases compose under addition of evolution times. -/
lemma phase_add (s t : ℝ) (x : X) :
    M.phase (s + t) x = M.phase s x * M.phase t x := by
  rw [phase, phase, phase, ← Complex.exp_add]
  congr 1
  push_cast
  ring

lemma aestronglyMeasurable_phase_mul (t : ℝ) (ψ : M.Hilbert) :
    AEStronglyMeasurable (fun x => M.phase t x * ψ x) M.μ := by
  have htotal : Measurable M.totalEnergy := M.measurable_totalEnergy
  have hphase : Measurable (M.phase t) := by
    have hr : Measurable (fun x => t * M.totalEnergy x / M.hbar) :=
      (htotal.const_mul t).div_const M.hbar
    exact (Complex.measurable_ofReal.comp hr).const_mul (-Complex.I) |>.cexp
  exact hphase.aestronglyMeasurable.mul (Lp.aestronglyMeasurable ψ)

lemma memLp_phase_mul (t : ℝ) (ψ : M.Hilbert) :
    MemLp (fun x => M.phase t x * ψ x) 2 M.μ := by
  exact (Lp.memLp ψ).congr_norm
    (M.aestronglyMeasurable_phase_mul t ψ)
    (Filter.Eventually.of_forall fun x => by
      rw [norm_mul, M.norm_phase, one_mul])

/-! ## B. Constructed unitary `C₀` interacting evolution -/

/-- Constructed interacting functional Schrödinger evolution on `L²(X, μ)`. -/
def evolution (t : ℝ) (ψ : M.Hilbert) : M.Hilbert :=
  (M.memLp_phase_mul t ψ).toLp (fun x => M.phase t x * ψ x)

lemma evolution_coeFn (t : ℝ) (ψ : M.Hilbert) :
    M.evolution t ψ =ᵐ[M.μ] fun x => M.phase t x * ψ x :=
  MemLp.coeFn_toLp _

@[simp] lemma evolution_zero (ψ : M.Hilbert) : M.evolution 0 ψ = ψ := by
  apply Lp.ext (μ := M.μ)
  filter_upwards [M.evolution_coeFn 0 ψ] with x hx
  simpa using hx

/-- The interacting evolution is a one-parameter group. -/
lemma evolution_add (s t : ℝ) (ψ : M.Hilbert) :
    M.evolution (s + t) ψ = M.evolution s (M.evolution t ψ) := by
  apply Lp.ext (μ := M.μ)
  filter_upwards [M.evolution_coeFn (s + t) ψ,
    M.evolution_coeFn t ψ, M.evolution_coeFn s (M.evolution t ψ)] with x hst ht hs
  rw [hst, hs, ht, M.phase_add]
  ring

/-- Exact `L²` norm conservation for the interacting evolution. -/
@[simp] lemma norm_evolution (t : ℝ) (ψ : M.Hilbert) :
    ‖M.evolution t ψ‖ = ‖ψ‖ := by
  rw [evolution, Lp.norm_toLp, Lp.norm_def]
  congr 1
  apply eLpNorm_congr_norm_ae
  exact Filter.Eventually.of_forall fun x => by
    rw [norm_mul, M.norm_phase, one_mul]

lemma evolution_map_add (t : ℝ) (ψ χ : M.Hilbert) :
    M.evolution t (ψ + χ) = M.evolution t ψ + M.evolution t χ := by
  apply Lp.ext (μ := M.μ)
  filter_upwards [M.evolution_coeFn t (ψ + χ),
    M.evolution_coeFn t ψ, M.evolution_coeFn t χ,
    Lp.coeFn_add ψ χ, Lp.coeFn_add (M.evolution t ψ) (M.evolution t χ)]
      with x hsum hψ hχ hin hout
  rw [hsum, hin, hout]
  simp only [Pi.add_apply]
  rw [hψ, hχ]
  ring

lemma evolution_map_smul (t : ℝ) (z : ℂ) (ψ : M.Hilbert) :
    M.evolution t (z • ψ) = z • M.evolution t ψ := by
  apply Lp.ext (μ := M.μ)
  filter_upwards [M.evolution_coeFn t (z • ψ), M.evolution_coeFn t ψ,
    Lp.coeFn_smul z ψ, Lp.coeFn_smul z (M.evolution t ψ)]
      with x hevol hψ hin hout
  rw [hevol, hin, hout]
  simp only [Pi.smul_apply]
  rw [hψ]
  ring

/-- The measurable real-energy evolution as a bundled complex-linear unitary operator.
Its inverse is the evolution at negative time. -/
def evolutionLinearIsometryEquiv (t : ℝ) : M.Hilbert ≃ₗᵢ[ℂ] M.Hilbert where
  toFun := M.evolution t
  invFun := M.evolution (-t)
  left_inv ψ := by
    rw [← M.evolution_add, neg_add_cancel, M.evolution_zero]
  right_inv ψ := by
    rw [← M.evolution_add, add_neg_cancel, M.evolution_zero]
  map_add' := M.evolution_map_add t
  map_smul' := M.evolution_map_smul t
  norm_map' := M.norm_evolution t

@[simp] lemma evolutionLinearIsometryEquiv_apply (t : ℝ) (ψ : M.Hilbert) :
    M.evolutionLinearIsometryEquiv t ψ = M.evolution t ψ := rfl

private lemma evolution_error_sq_integral_tendsto_zero (ψ : M.Hilbert) :
    Tendsto (fun t : ℝ => ∫ x, ‖M.phase t x * ψ x - ψ x‖ ^ 2 ∂M.μ)
      (𝓝 0) (𝓝 0) := by
  let F : ℝ → X → ℝ := fun t x => ‖M.phase t x * ψ x - ψ x‖ ^ 2
  have hF_meas : ∀ᶠ t : ℝ in 𝓝 0, AEStronglyMeasurable (F t) M.μ := by
    filter_upwards [] with t
    exact (((M.aestronglyMeasurable_phase_mul t ψ).sub
      (Lp.aestronglyMeasurable ψ)).norm.pow 2)
  have hbound : ∀ᶠ t : ℝ in 𝓝 0, ∀ᵐ x ∂M.μ, ‖F t x‖ ≤ 4 * ‖ψ x‖ ^ 2 := by
    filter_upwards [] with t
    exact Filter.Eventually.of_forall fun x => by
      dsimp [F]
      rw [abs_of_nonneg (sq_nonneg _)]
      have hn : ‖M.phase t x * ψ x - ψ x‖ ≤ 2 * ‖ψ x‖ := by
        calc
          _ ≤ ‖M.phase t x * ψ x‖ + ‖ψ x‖ := norm_sub_le _ _
          _ = 2 * ‖ψ x‖ := by rw [norm_mul, M.norm_phase]; ring
      calc
        _ ≤ (2 * ‖ψ x‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hn 2
        _ = 4 * ‖ψ x‖ ^ 2 := by ring
  have hbound_integrable : Integrable (fun x => 4 * ‖ψ x‖ ^ 2) M.μ :=
    ((Lp.memLp ψ).integrable_norm_pow two_ne_zero).const_mul 4
  have hlim : ∀ᵐ x ∂M.μ, Tendsto (fun t : ℝ => F t x) (𝓝 0) (𝓝 0) := by
    filter_upwards [] with x
    have hp : Tendsto (fun t : ℝ => M.phase t x) (𝓝 0) (𝓝 1) := by
      rw [← M.phase_zero x]
      have hc : Continuous (fun t : ℝ => M.phase t x) := by
        unfold phase
        fun_prop
      exact hc.continuousAt
    dsimp [F]
    convert (((hp.mul_const (ψ x)).sub tendsto_const_nhds).norm.pow 2) using 1
    simp
  simpa [F] using tendsto_integral_filter_of_dominated_convergence
    (fun x => 4 * ‖ψ x‖ ^ 2) hF_meas hbound hbound_integrable hlim

private lemma norm_sq_evolution_sub_eq_integral (t : ℝ) (ψ : M.Hilbert) :
    ‖M.evolution t ψ - ψ‖ ^ 2 =
      ∫ x, ‖M.phase t x * ψ x - ψ x‖ ^ 2 ∂M.μ := by
  rw [norm_sq_eq_re_inner (𝕜 := ℂ), MeasureTheory.L2.inner_def,
    ← integral_re (MeasureTheory.L2.integrable_inner
      (M.evolution t ψ - ψ) (M.evolution t ψ - ψ))]
  apply integral_congr_ae
  filter_upwards [Lp.coeFn_sub (M.evolution t ψ) ψ,
    M.evolution_coeFn t ψ] with x hsub hevol
  rw [hsub]
  change RCLike.re (inner ℂ (M.evolution t ψ x - ψ x)
    (M.evolution t ψ x - ψ x)) = ‖M.phase t x * ψ x - ψ x‖ ^ 2
  rw [hevol, inner_self_eq_norm_sq]

/-- Strong continuity at zero of the interacting `L²` evolution. -/
lemma evolution_tendsto_zero (ψ : M.Hilbert) :
    Tendsto (fun t : ℝ => M.evolution t ψ) (𝓝 0) (𝓝 ψ) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hsq : Tendsto (fun t : ℝ => ‖M.evolution t ψ - ψ‖ ^ 2)
      (𝓝 0) (𝓝 0) := by
    simpa only [M.norm_sq_evolution_sub_eq_integral] using
      M.evolution_error_sq_integral_tendsto_zero ψ
  have he := hsq.eventually (Iio_mem_nhds (sq_pos_of_pos hε))
  filter_upwards [he] with t ht
  rw [dist_eq_norm]
  nlinarith [norm_nonneg (M.evolution t ψ - ψ)]

/-- Strong continuity of the measurable real-energy evolution at every real time. -/
lemma evolution_tendsto (t₀ : ℝ) (ψ : M.Hilbert) :
    Tendsto (fun t : ℝ => M.evolution t ψ) (𝓝 t₀) (𝓝 (M.evolution t₀ ψ)) := by
  have hshift : Tendsto (fun t : ℝ => t - t₀) (𝓝 t₀) (𝓝 0) := by
    rw [← sub_self t₀]
    exact (continuous_id.sub continuous_const).continuousAt
  have hzero := (M.evolution_tendsto_zero ψ).comp hshift
  change Tendsto (fun t : ℝ => M.evolution (t - t₀) ψ)
    (𝓝 t₀) (𝓝 ψ) at hzero
  have hout := Filter.Tendsto.comp
    (M.evolutionLinearIsometryEquiv t₀).continuous.continuousAt hzero
  change Tendsto
    (fun t : ℝ => M.evolutionLinearIsometryEquiv t₀
      (M.evolution (t - t₀) ψ))
    (𝓝 t₀) (𝓝 (M.evolutionLinearIsometryEquiv t₀ ψ)) at hout
  have hfun :
      (fun t : ℝ => M.evolution t ψ) =
        fun t => M.evolutionLinearIsometryEquiv t₀ (M.evolution (t - t₀) ψ) := by
    funext t
    rw [M.evolutionLinearIsometryEquiv_apply, ← M.evolution_add]
    congr 2
    ring
  rw [hfun]
  simpa using hout

/-- The configuration-local real-energy flow packaged as the repository's bounded-operator
`C₀` group.  The energy may be unbounded; each time-slice multiplier is nevertheless unitary. -/
noncomputable def evolutionC0Group :
    QuantumMechanics.LindbladDrivenLeads.ComplexC0Semigroup (K := M.Hilbert) where
  operator := fun t => (M.evolutionLinearIsometryEquiv t).toContinuousLinearEquiv.toContinuousLinearMap
  operator_zero := by
    ext ψ
    simp
  operator_add := by
    intro s t
    apply ContinuousLinearMap.ext
    intro ψ
    change M.evolution (s + t) ψ = M.evolution s (M.evolution t ψ)
    exact M.evolution_add s t ψ
  strong_continuous := by
    intro ψ
    rw [continuous_iff_continuousAt]
    intro t₀
    exact M.evolution_tendsto t₀ ψ

/-- Capstone certificate for the constructed interacting unitary `C₀` group. -/
lemma evolution_unitaryC0 (ψ : M.Hilbert) :
    M.evolution 0 ψ = ψ ∧
    (∀ s t, M.evolution (s + t) ψ = M.evolution s (M.evolution t ψ)) ∧
    (∀ t, ‖M.evolution t ψ‖ = ‖ψ‖) ∧
    Tendsto (fun t : ℝ => M.evolution t ψ) (𝓝 0) (𝓝 ψ) :=
  ⟨M.evolution_zero ψ, fun s t => M.evolution_add s t ψ,
    fun t => M.norm_evolution t ψ, M.evolution_tendsto_zero ψ⟩

/-! ## C. Pointwise interacting Schrödinger equation -/

/-- A pointwise representative of the constructed interacting evolution. -/
def pointwiseEvolution (ψ : X → ℂ) (t : ℝ) (x : X) : ℂ :=
  M.phase t x * ψ x

/-- The constructed phase solves the free-plus-interaction functional Schrödinger equation at
every configuration point. -/
lemma pointwiseEvolution_schrodinger (ψ : X → ℂ) (t : ℝ) (x : X) :
    Complex.I * (M.hbar : ℂ) * deriv (fun τ => M.pointwiseEvolution ψ τ x) t =
      (M.totalEnergy x : ℂ) * M.pointwiseEvolution ψ t x := by
  have harg : HasDerivAt
      (fun τ : ℝ => -Complex.I * Complex.ofReal (τ * M.totalEnergy x / M.hbar))
      (-Complex.I * Complex.ofReal (M.totalEnergy x / M.hbar)) t := by
    have hlin :
        (fun τ : ℝ => -Complex.I * Complex.ofReal (τ * M.totalEnergy x / M.hbar)) =
          fun τ : ℝ => (-Complex.I * Complex.ofReal (M.totalEnergy x / M.hbar)) * (τ : ℂ) := by
      funext τ
      push_cast
      ring
    rw [hlin]
    simpa using (Complex.ofRealCLM.hasDerivAt (x := t)).const_mul
      (-Complex.I * Complex.ofReal (M.totalEnergy x / M.hbar))
  have hphase : HasDerivAt (fun τ => M.phase τ x)
      (M.phase t x * (-Complex.I * Complex.ofReal (M.totalEnergy x / M.hbar))) t := by
    simpa [phase] using harg.cexp
  have hwave : HasDerivAt (fun τ => M.pointwiseEvolution ψ τ x)
      (M.phase t x * (-Complex.I * Complex.ofReal (M.totalEnergy x / M.hbar)) * ψ x) t := by
    simpa [pointwiseEvolution] using hphase.mul_const (ψ x)
  rw [hwave.deriv, pointwiseEvolution]
  push_cast
  field_simp [M.hbar_pos.ne']
  simp [pow_two, Complex.I_mul_I]

/-! ## D. Constructed Born probability measure -/

/-- Born density of an `L²` wave functional. -/
def bornDensity (ψ : M.Hilbert) (x : X) : ℝ := ‖ψ x‖ ^ 2

/-- Born measure `|ψ|² μ` on configuration space. -/
def bornMeasure (ψ : M.Hilbert) : Measure X :=
  M.μ.withDensity (fun x => ENNReal.ofReal (M.bornDensity ψ x))

lemma integrable_bornDensity (ψ : M.Hilbert) : Integrable (M.bornDensity ψ) M.μ :=
  (Lp.memLp ψ).integrable_norm_pow two_ne_zero

/-- Total mass of the constructed Born measure is the integrated Born density. -/
lemma bornMeasure_univ (ψ : M.Hilbert) :
    M.bornMeasure ψ Set.univ = ENNReal.ofReal (∫ x, M.bornDensity ψ x ∂M.μ) := by
  rw [bornMeasure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  exact (ofReal_integral_eq_lintegral_ofReal (M.integrable_bornDensity ψ)
    (Filter.Eventually.of_forall fun x => sq_nonneg ‖ψ x‖)).symm

/-- A normalized wave functional as an actual probability measure, not merely a pointwise density. -/
def bornProbability (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) : ProbabilityMeasure X :=
  ⟨M.bornMeasure ψ, ⟨by rw [M.bornMeasure_univ, hnorm]; simp⟩⟩

/-- The interacting configuration-local phase preserves Born density almost everywhere. -/
lemma bornDensity_evolution_ae (t : ℝ) (ψ : M.Hilbert) :
    M.bornDensity (M.evolution t ψ) =ᵐ[M.μ] M.bornDensity ψ := by
  filter_upwards [M.evolution_coeFn t ψ] with x hx
  rw [bornDensity, bornDensity, hx, norm_mul, M.norm_phase, one_mul]

/-- The constructed Born measure is conserved by the interacting evolution. -/
lemma bornMeasure_evolution (t : ℝ) (ψ : M.Hilbert) :
    M.bornMeasure (M.evolution t ψ) = M.bornMeasure ψ := by
  unfold bornMeasure
  apply withDensity_congr_ae
  filter_upwards [M.bornDensity_evolution_ae t ψ] with x hx
  rw [hx]

/-- **[Caticha unitary evolution does not advance the information-loss clock]** the remaining
measure-theoretic KL clock relative to any fixed reference measure is exactly conserved because the
configuration-local real evolution preserves the full Born measure. -/
theorem bornMeasure_remainingClock_evolution
    (γ t : ℝ) (ψ : M.Hilbert) (ν : Measure X) :
    measureRemainingClock γ (M.bornMeasure (M.evolution t ψ)) ν =
      measureRemainingClock γ (M.bornMeasure ψ) ν := by
  rw [M.bornMeasure_evolution]

lemma integral_bornDensity_evolution (t : ℝ) (ψ : M.Hilbert) :
    ∫ x, M.bornDensity (M.evolution t ψ) x ∂M.μ =
      ∫ x, M.bornDensity ψ x ∂M.μ :=
  integral_congr_ae (M.bornDensity_evolution_ae t ψ)

/-! ## E. Continuum detector and time-dependent outcome law -/

/-- A measurable continuum detector maps configurations to outcomes. -/
structure ContinuumDetector (Ω : Type*) [MeasurableSpace Ω] where
  /-- Detector readout/coarse-graining map. -/
  readout : X → Ω
  /-- Measurability of the detector readout. -/
  measurable_readout : Measurable readout

namespace ContinuumDetector

variable {Ω : Type*} [MeasurableSpace Ω] (D : ContinuumDetector (X := X) Ω)

/-- Detector outcome law as the pushforward of the constructed Born probability. -/
def outcomeLaw (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) : ProbabilityMeasure Ω :=
  (M.bornProbability ψ hnorm).map D.measurable_readout.aemeasurable

/-- A measurable outcome event is evaluated by integrating the Born density over the
configurations that trigger that detector event. -/
lemma outcomeLaw_apply (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    {B : Set Ω} (hB : MeasurableSet B) :
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) B =
      M.bornMeasure ψ (D.readout ⁻¹' B) := by
  exact (M.bornProbability ψ hnorm).map_apply'
    D.measurable_readout.aemeasurable hB

/-- Detector outcome law at time `t` under interacting functional evolution. -/
def outcomeLawAt (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) (t : ℝ) : ProbabilityMeasure Ω :=
  outcomeLaw M D (M.evolution t ψ) (M.integral_bornDensity_evolution t ψ ▸ hnorm)

/-- A configuration-local real interaction changes phase but not a detector depending only on the
instantaneous configuration. Thus its continuum detector law is conserved. -/
lemma outcomeLawAt_eq (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) (t : ℝ) :
    outcomeLawAt M D ψ hnorm t = outcomeLaw M D ψ hnorm := by
  apply ProbabilityMeasure.toMeasure_injective
  change (M.bornMeasure (M.evolution t ψ)).map D.readout =
    (M.bornMeasure ψ).map D.readout
  rw [M.bornMeasure_evolution]

/-- **[Continuum detector data processing]** a measurable Caticha detector cannot increase the
remaining KL clock between two normalized Born states. This is the repository's continuum
functional-measure realization of the abstract measurable-map clock theorem. -/
theorem outcomeLaw_remainingClock_le [StandardBorelSpace X] [Nonempty X]
    (γ : ℝ) (hγ : 0 ≤ γ) (ψ φ : M.Hilbert)
    (hψ : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hφ : ∫ x, M.bornDensity φ x ∂M.μ = 1)
    (hfin : klDiv ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) ≠ ⊤) :
    measureRemainingClock γ
        ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
        ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω) ≤
      measureRemainingClock γ
        ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
        ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) := by
  simpa only [outcomeLaw, ProbabilityMeasure.toMeasure_map] using
    (measureRemainingClock_map_le γ hγ D.measurable_readout
      ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) hfin)

/-- **[Continuum detector amplitude recovery]** detector coarse-graining cannot decrease the master
complex-action modulus calibrated by distinguishability of two normalized Caticha Born states. -/
theorem outcomeLaw_complexWeight_norm_mono [StandardBorelSpace X] [Nonempty X]
    (S_Rconfiguration S_Routcome ħ γ : ℝ) (hħ : ħ ≠ 0) (hγ : 0 ≤ γ)
    (ψ φ : M.Hilbert)
    (hψ : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hφ : ∫ x, M.bornDensity φ x ∂M.μ = 1)
    (hfin : klDiv ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) ≠ ⊤) :
    ‖measureRemainingClockComplexWeight S_Rconfiguration ħ γ
        ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
        ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X)‖ ≤
      ‖measureRemainingClockComplexWeight S_Routcome ħ γ
        ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
        ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω)‖ := by
  simpa only [outcomeLaw, ProbabilityMeasure.toMeasure_map] using
    (measureRemainingClockComplexWeight_norm_map_mono
      S_Rconfiguration S_Routcome ħ γ hħ hγ D.measurable_readout
      ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) hfin)

end ContinuumDetector

/-! ## F. Stochastic continuum detectors and cascades -/

/-- A stochastic continuum detector assigns a probability law of outcomes to every field
configuration.  This strictly extends a deterministic measurable readout: detector noise and
classical post-processing are represented by a Markov kernel. -/
structure StochasticContinuumDetector (Ω : Type*) [MeasurableSpace Ω] where
  /-- Conditional detector response `P(dω | x)`. -/
  response : Kernel X Ω
  /-- Every conditional response has total mass one. -/
  isMarkov_response : IsMarkovKernel response

namespace StochasticContinuumDetector

variable {Ω : Type*} [MeasurableSpace Ω]
    (D : StochasticContinuumDetector (X := X) Ω)

instance : IsMarkovKernel D.response := D.isMarkov_response

/-- Embed a measurable deterministic readout into the stochastic detector API as its Dirac response
kernel.  This adapter makes the earlier `ContinuumDetector` a genuine special case rather than a
parallel measurement abstraction. -/
def ofContinuumDetector (D₀ : ContinuumDetector (X := X) Ω) :
    StochasticContinuumDetector (X := X) Ω where
  response := Kernel.deterministic D₀.readout D₀.measurable_readout
  isMarkov_response := by infer_instance

/-- The stochastic detector outcome probability obtained by composing its response kernel with the
normalized Caticha Born measure. -/
def outcomeLaw (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) : ProbabilityMeasure Ω :=
  ⟨D.response ∘ₘ ((M.bornProbability ψ hnorm : ProbabilityMeasure X) : Measure X), inferInstance⟩

/-- The stochastic outcome law of the Dirac-response adapter is exactly the original deterministic
pushforward law. -/
theorem outcomeLaw_ofContinuumDetector (D₀ : ContinuumDetector (X := X) Ω)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) :
    outcomeLaw M (ofContinuumDetector D₀) ψ hnorm =
      ContinuumDetector.outcomeLaw M D₀ ψ hnorm := by
  apply ProbabilityMeasure.toMeasure_injective
  change Kernel.deterministic D₀.readout D₀.measurable_readout ∘ₘ M.bornMeasure ψ =
    (M.bornMeasure ψ).map D₀.readout
  exact Measure.deterministic_comp_eq_map D₀.measurable_readout

@[simp]
lemma outcomeLaw_toMeasure (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) :
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) =
      D.response ∘ₘ M.bornMeasure ψ := by
  rfl

/-- Stochastic detector law after the interacting functional evolution. -/
def outcomeLawAt (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) (t : ℝ) : ProbabilityMeasure Ω :=
  outcomeLaw M D (M.evolution t ψ) (M.integral_bornDensity_evolution t ψ ▸ hnorm)

/-- Real configuration-local functional evolution changes only phase, hence it also preserves every
stochastic detector outcome law. -/
theorem outcomeLawAt_eq (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) (t : ℝ) :
    outcomeLawAt M D ψ hnorm t = outcomeLaw M D ψ hnorm := by
  apply ProbabilityMeasure.toMeasure_injective
  change D.response ∘ₘ M.bornMeasure (M.evolution t ψ) = D.response ∘ₘ M.bornMeasure ψ
  rw [M.bornMeasure_evolution]

/-- **[Stochastic Caticha detector data processing]** detector noise represented by an arbitrary
Markov response kernel cannot increase the remaining KL clock between normalized Born states. -/
theorem outcomeLaw_remainingClock_le [StandardBorelSpace X] [Nonempty X]
    (γ : ℝ) (hγ : 0 ≤ γ) (ψ φ : M.Hilbert)
    (hψ : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hφ : ∫ x, M.bornDensity φ x ∂M.μ = 1)
    (hfin : klDiv ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) ≠ ⊤) :
    measureRemainingClock γ
        ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
        ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω) ≤
      measureRemainingClock γ
        ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
        ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) := by
  exact measureRemainingClock_comp_le γ hγ D.response
    ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
    ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) hfin

/-- **[Stochastic detector amplitude recovery]** an arbitrary classical detector response channel
cannot decrease the master complex-action modulus calibrated by Born-state distinguishability. -/
theorem outcomeLaw_complexWeight_norm_mono [StandardBorelSpace X] [Nonempty X]
    (S_Rconfiguration S_Routcome ħ γ : ℝ) (hħ : ħ ≠ 0) (hγ : 0 ≤ γ)
    (ψ φ : M.Hilbert)
    (hψ : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hφ : ∫ x, M.bornDensity φ x ∂M.μ = 1)
    (hfin : klDiv ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) ≠ ⊤) :
    ‖measureRemainingClockComplexWeight S_Rconfiguration ħ γ
        ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
        ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X)‖ ≤
      ‖measureRemainingClockComplexWeight S_Routcome ħ γ
        ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
        ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω)‖ := by
  exact measureRemainingClockComplexWeight_norm_comp_mono
    S_Rconfiguration S_Routcome ħ γ hħ hγ D.response
    ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
    ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) hfin

/-- Cascade a stochastic detector with a second stochastic response channel. -/
def cascade {Γ : Type*} [MeasurableSpace Γ]
    (E : StochasticContinuumDetector (X := Ω) Γ) :
    StochasticContinuumDetector (X := X) Γ where
  response := E.response ∘ₖ D.response
  isMarkov_response := by infer_instance

/-- **[Exact detector cascade]** applying a cascaded detector is exactly successive integration of
the two conditional response laws. -/
theorem outcomeLaw_cascade {Γ : Type*} [MeasurableSpace Γ]
    (E : StochasticContinuumDetector (X := Ω) Γ)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) :
    (((outcomeLaw M (D.cascade E) ψ hnorm : ProbabilityMeasure Γ) : Measure Γ)) =
      E.response ∘ₘ ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) := by
  exact Measure.comp_assoc.symm

/-- **[Cascaded detector clock chain]** every stage of a stochastic detector cascade can only
discard distinguishability: the output clock is below the intermediate detector clock, which is
below the original Caticha Born-state clock. -/
theorem outcomeLaw_cascade_remainingClock_chain
    {Γ : Type*} [MeasurableSpace Γ]
    [StandardBorelSpace X] [Nonempty X] [StandardBorelSpace Ω] [Nonempty Ω]
    (E : StochasticContinuumDetector (X := Ω) Γ)
    (γ : ℝ) (hγ : 0 ≤ γ) (ψ φ : M.Hilbert)
    (hψ : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hφ : ∫ x, M.bornDensity φ x ∂M.μ = 1)
    (hfin : klDiv ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
      ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) ≠ ⊤) :
    measureRemainingClock γ
        ((outcomeLaw M (D.cascade E) ψ hψ : ProbabilityMeasure Γ) : Measure Γ)
        ((outcomeLaw M (D.cascade E) φ hφ : ProbabilityMeasure Γ) : Measure Γ) ≤
      measureRemainingClock γ
        ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
        ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω) ∧
    measureRemainingClock γ
        ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
        ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω) ≤
      measureRemainingClock γ
        ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
        ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X) := by
  have hD := Physlib.Thermodynamics.BoltzmannHTheorem.klDiv_comp_le D.response
    ((M.bornProbability ψ hψ : ProbabilityMeasure X) : Measure X)
    ((M.bornProbability φ hφ : ProbabilityMeasure X) : Measure X)
  have hfinD : klDiv
      ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
      ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω) ≠ ⊤ :=
    ne_top_of_le_ne_top hfin hD
  constructor
  · rw [outcomeLaw_cascade M D E ψ hψ, outcomeLaw_cascade M D E φ hφ]
    exact measureRemainingClock_comp_le γ hγ E.response
      ((outcomeLaw M D ψ hψ : ProbabilityMeasure Ω) : Measure Ω)
      ((outcomeLaw M D φ hφ : ProbabilityMeasure Ω) : Measure Ω) hfinD
  · exact D.outcomeLaw_remainingClock_le M γ hγ ψ φ hψ hφ hfin

/-! ### Detector-time Markov evolution -/

/-- Evolve a stochastic Caticha detector law through a positive-time Markov response semigroup on
its outcome space. -/
def outcomeLawUnder
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (t : NNReal) : ProbabilityMeasure Ω :=
  ⟨S.measureAt ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) t, by
    unfold MeasureKernelPositiveTimeSemigroup.measureAt
    infer_instance⟩

/-- Detector-time evolution starts at the stochastic Born outcome law. -/
@[simp]
theorem outcomeLawUnder_zero
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1) :
    outcomeLawUnder M D S ψ hnorm 0 = outcomeLaw M D ψ hnorm := by
  apply ProbabilityMeasure.toMeasure_injective
  exact S.measureAt_zero _

/-- The detector-time semigroup law holds exactly on the constructed Caticha outcome measure. -/
theorem outcomeLawUnder_add
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (s t : NNReal) :
    ((outcomeLawUnder M D S ψ hnorm (s + t) : ProbabilityMeasure Ω) : Measure Ω) =
      S.measureAt
        ((outcomeLawUnder M D S ψ hnorm t : ProbabilityMeasure Ω) : Measure Ω) s := by
  exact S.measureAt_add _ s t

/-- **[Caticha detector-time H-theorem]** relative-entropy distinguishability of a constructed
stochastic Born outcome law from a stationary detector reference is antitone in positive detector
time. -/
theorem outcomeLawUnder_remainingClock_antitone
    [StandardBorelSpace Ω] [Nonempty Ω]
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (γ : ℝ) (hγ : 0 ≤ γ)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) [IsFiniteMeasure ν]
    (hfix : S.IsFixedReference ν)
    (hfin : klDiv
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν ≠ ⊤) :
    Antitone (fun t => measureRemainingClock γ
      ((outcomeLawUnder M D S ψ hnorm t : ProbabilityMeasure Ω) : Measure Ω) ν) := by
  exact S.remainingClockAt_antitone γ hγ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν hfix hfin

/-- **[Caticha detector-time amplitude Lyapunov law]** the norm of the complex-action weight
calibrated by detector distinguishability is monotone along the outcome Markov semigroup. -/
theorem outcomeLawUnder_complexWeight_norm_monotone
    [StandardBorelSpace Ω] [Nonempty Ω]
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (S_R ħ γ : ℝ) (hħ : ħ ≠ 0) (hγ : 0 ≤ γ)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) [IsFiniteMeasure ν]
    (hfix : S.IsFixedReference ν)
    (hfin : klDiv
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν ≠ ⊤) :
    Monotone (fun t => ‖measureRemainingClockComplexWeight S_R ħ γ
      ((outcomeLawUnder M D S ψ hnorm t : ProbabilityMeasure Ω) : Measure Ω) ν‖) := by
  exact S.remainingClockComplexWeightAt_norm_monotone S_R ħ γ hħ hγ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν hfix hfin

/-- Clock produced by stochastic detector dynamics over an outcome-time interval. -/
noncomputable def detectorIntervalClockGain
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (γ : ℝ) (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) (s t : NNReal) : ℝ :=
  S.intervalClockGain γ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν s t

/-- Detector interval-clock production is nonnegative relative to a stationary reference. -/
theorem detectorIntervalClockGain_nonneg
    [StandardBorelSpace Ω] [Nonempty Ω]
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (γ : ℝ) (hγ : 0 ≤ γ)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) [IsFiniteMeasure ν]
    (hfix : S.IsFixedReference ν)
    (hfin : klDiv
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν ≠ ⊤)
    {s t : NNReal} (hst : s ≤ t) :
    0 ≤ detectorIntervalClockGain M D S γ ψ hnorm ν s t := by
  exact S.intervalClockGain_nonneg γ hγ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν hfix hfin hst

/-- Detector interval production obeys the exact adjacent-interval cocycle. -/
theorem detectorIntervalClockGain_cocycle
    (S : MeasureKernelPositiveTimeSemigroup Ω)
    (γ : ℝ) (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) (s t u : NNReal) :
    detectorIntervalClockGain M D S γ ψ hnorm ν s t +
        detectorIntervalClockGain M D S γ ψ hnorm ν t u =
      detectorIntervalClockGain M D S γ ψ hnorm ν s u := by
  exact S.intervalClockGain_cocycle γ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν s t u

/-! ### Weakly continuous detector time and differential production -/

/-- A weakly continuous detector semigroup recovers every initial bounded-observable expectation
of the constructed stochastic Caticha outcome law. -/
theorem outcomeLawUnderC0_initial_observable_recovery
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    (S : MeasureKernelC0Semigroup Ω)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (f : BoundedContinuousFunction Ω ℝ) :
    Filter.Tendsto
      (fun t => ∫ ω, f ω ∂
        (outcomeLawUnder M D S.toMeasureKernelPositiveTimeSemigroup ψ hnorm t :
          ProbabilityMeasure Ω))
      (nhds 0)
      (nhds (∫ ω, f ω ∂(outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω))) := by
  simpa [outcomeLawUnder, MeasureKernelC0Semigroup.observableExpectation,
    MeasureKernelC0Semigroup.probabilityAt] using
    (S.initial_observable_recovery (outcomeLaw M D ψ hnorm) f)

/-- If the constructed detector outcome is stationary, every identified weak observable generator
annihilates it. -/
theorem detectorObservableGenerator_eq_zero_of_fixedOutcome
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    (S : MeasureKernelC0Semigroup Ω)
    (A : ProbabilityMeasure Ω → BoundedContinuousFunction Ω ℝ → ℝ)
    (hgen : S.HasObservableGenerator A)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hfix : S.toMeasureKernelPositiveTimeSemigroup.IsFixedReference
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω))
    (f : BoundedContinuousFunction Ω ℝ) :
    A (outcomeLaw M D ψ hnorm) f = 0 :=
  S.observableGenerator_eq_zero_of_fixedReference A hgen (outcomeLaw M D ψ hnorm) hfix f

/-- The right differential production predicate specialized to the constructed stochastic Caticha
outcome law. -/
def HasDetectorRightClockProductionRate
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    (S : MeasureKernelC0Semigroup Ω)
    (γ : ℝ) (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) (rate : ℝ) : Prop :=
  S.HasRightClockProductionRate γ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν rate

/-- **[Differential Caticha detector H-theorem]** an existing right production rate for weakly
continuous detector time is nonnegative relative to a stationary reference. -/
theorem detectorRightClockProductionRate_nonneg
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    [StandardBorelSpace Ω] [Nonempty Ω]
    (S : MeasureKernelC0Semigroup Ω)
    (γ : ℝ) (hγ : 0 ≤ γ)
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (ν : Measure Ω) [IsFiniteMeasure ν]
    (hfix : S.toMeasureKernelPositiveTimeSemigroup.IsFixedReference ν)
    (hfin : klDiv
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) ν ≠ ⊤)
    (rate : ℝ) (hrate : HasDetectorRightClockProductionRate M D S γ ψ hnorm ν rate) :
    0 ≤ rate :=
  S.rightClockProductionRate_nonneg γ hγ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω)
    ν hfix hfin rate hrate

/-- The concrete identity `C₀` detector semigroup preserves the constructed Caticha outcome law at
every detector time, not only at time zero. -/
theorem outcomeLawUnder_identity
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    (ψ : M.Hilbert) (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (t : NNReal) :
    outcomeLawUnder M D
      (MeasureKernelC0Semigroup.identity Ω).toMeasureKernelPositiveTimeSemigroup
      ψ hnorm t = outcomeLaw M D ψ hnorm := by
  apply ProbabilityMeasure.toMeasure_injective
  simp [outcomeLawUnder, MeasureKernelPositiveTimeSemigroup.measureAt,
    MeasureKernelC0Semigroup.identity]

/-- Stationarity of a constructed Caticha outcome law constructs its zero right clock-production
rate; rate existence is not an additional premise in the equilibrium sector. -/
theorem fixedOutcome_hasDetectorRightClockProductionRate_zero
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    (S : MeasureKernelC0Semigroup Ω)
    (γ : ℝ) (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hfix : S.toMeasureKernelPositiveTimeSemigroup.IsFixedReference
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω)) :
    HasDetectorRightClockProductionRate M D S γ ψ hnorm
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) 0 :=
  S.fixedReference_hasRightClockProductionRate_zero γ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) hfix

/-- Any right clock-production rate assigned to a stationary Caticha outcome law equals zero. -/
theorem detectorRightClockProductionRate_eq_zero_of_fixedOutcome
    [TopologicalSpace Ω] [OpensMeasurableSpace Ω]
    (S : MeasureKernelC0Semigroup Ω)
    (γ : ℝ) (ψ : M.Hilbert)
    (hnorm : ∫ x, M.bornDensity ψ x ∂M.μ = 1)
    (hfix : S.toMeasureKernelPositiveTimeSemigroup.IsFixedReference
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω))
    (rate : ℝ)
    (hrate : HasDetectorRightClockProductionRate M D S γ ψ hnorm
      ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) rate) :
    rate = 0 :=
  S.rightClockProductionRate_eq_zero_of_fixedReference γ
    ((outcomeLaw M D ψ hnorm : ProbabilityMeasure Ω) : Measure Ω) hfix rate hrate

end StochasticContinuumDetector
