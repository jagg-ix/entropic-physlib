module

public import Physlib.QuantumMechanics.OpenSystems.LindbladDrivenLeads.Basic
public import QuantumInfo.States.Pure.Qubit

/-!
# One-level LDDL channel

The loss/gain dynamics of one discretized lead level has a finite-time
realization as a generalized amplitude-damping channel. This file constructs
its four Kraus operators explicitly, packages them with the repository's
`CPTPMap.of_kraus_CPTPMap` constructor, and proves the exact finite-time
occupation relaxation law.
-/

@[expose] public section

noncomputable section

namespace QuantumMechanics
namespace LindbladDrivenLeads

open Complex
open scoped Matrix

/-- Parameters of a generalized amplitude-damping channel: target excitation
and total damping probability. -/
structure OneLevelChannelData where
  /-- Target excited-state occupation. -/
  occupation : ℝ
  /-- Probability of relaxation during the finite time step. -/
  damping : ℝ
  occupation_nonneg : 0 ≤ occupation
  occupation_le_one : occupation ≤ 1
  damping_nonneg : 0 ≤ damping
  damping_le_one : damping ≤ 1

/-- Finite-time damping probability generated by the one-level rate equation. -/
def RateData.dampingProbability (r : RateData) (t : ℝ) : ℝ :=
  1 - Real.exp (-2 * r.gamma * t)

/-- Construct channel parameters from the LDDL rates at nonnegative time. -/
def OneLevelChannelData.ofRateTime (r : RateData) (t : ℝ) (ht : 0 ≤ t) :
    OneLevelChannelData where
  occupation := r.occupation
  damping := r.dampingProbability t
  occupation_nonneg := r.occupation_nonneg
  occupation_le_one := r.occupation_le_one
  damping_nonneg := by
    apply sub_nonneg.mpr
    rw [Real.exp_le_one_iff]
    nlinarith [r.gamma_pos]
  damping_le_one := by
    exact sub_le_self 1 (Real.exp_pos _).le

/-- Survival probability of the excited state. -/
def OneLevelChannelData.survival (d : OneLevelChannelData) : ℝ :=
  1 - d.damping

@[simp]
theorem OneLevelChannelData.survival_nonneg (d : OneLevelChannelData) :
    0 ≤ d.survival :=
  sub_nonneg.mpr d.damping_le_one

/-- First generalized-amplitude-damping Kraus operator. -/
def oneLevelKraus0 (d : OneLevelChannelData) : Matrix Qubit Qubit ℂ :=
  (Real.sqrt (1 - d.occupation) : ℂ) •
    !![(1 : ℂ), 0; 0, (Real.sqrt d.survival : ℂ)]

/-- Second generalized-amplitude-damping Kraus operator. -/
def oneLevelKraus1 (d : OneLevelChannelData) : Matrix Qubit Qubit ℂ :=
  ((Real.sqrt (1 - d.occupation) * Real.sqrt d.damping : ℝ) : ℂ) •
    !![(0 : ℂ), 1; 0, 0]

/-- Third generalized-amplitude-damping Kraus operator. -/
def oneLevelKraus2 (d : OneLevelChannelData) : Matrix Qubit Qubit ℂ :=
  (Real.sqrt d.occupation : ℂ) •
    !![(Real.sqrt d.survival : ℂ), 0; 0, 1]

/-- Fourth generalized-amplitude-damping Kraus operator. -/
def oneLevelKraus3 (d : OneLevelChannelData) : Matrix Qubit Qubit ℂ :=
  ((Real.sqrt d.occupation * Real.sqrt d.damping : ℝ) : ℂ) •
    !![(0 : ℂ), 0; 1, 0]

/-- The four Kraus operators of the one-level finite-time channel. -/
def oneLevelKraus (d : OneLevelChannelData) : Fin 4 → Matrix Qubit Qubit ℂ :=
  ![oneLevelKraus0 d, oneLevelKraus1 d, oneLevelKraus2 d, oneLevelKraus3 d]

/-- The generalized-amplitude-damping Kraus operators satisfy the completeness
relation `Σ Kᵢ†Kᵢ = I`. -/
theorem oneLevelKraus_complete (d : OneLevelChannelData) :
    ∑ k, (oneLevelKraus d k)ᴴ * oneLevelKraus d k = 1 := by
  have hoc : Real.sqrt (1 - d.occupation) ^ 2 = 1 - d.occupation :=
    Real.sq_sqrt (sub_nonneg.mpr d.occupation_le_one)
  have ho : Real.sqrt d.occupation ^ 2 = d.occupation :=
    Real.sq_sqrt d.occupation_nonneg
  have hd : Real.sqrt d.damping ^ 2 = d.damping :=
    Real.sq_sqrt d.damping_nonneg
  have hs : Real.sqrt d.survival ^ 2 = d.survival :=
    Real.sq_sqrt d.survival_nonneg
  have hs' : Real.sqrt (1 - d.damping) ^ 2 = 1 - d.damping :=
    Real.sq_sqrt (sub_nonneg.mpr d.damping_le_one)
  matrix_expand [oneLevelKraus, oneLevelKraus0, oneLevelKraus1,
    oneLevelKraus2, oneLevelKraus3, OneLevelChannelData.survival,
    Fin.sum_univ_four, hoc, ho, hd, hs, hs']; ring

/-- The finite-time one-level LDDL evolution as a bundled quantum channel. -/
def oneLevelChannel (d : OneLevelChannelData) : CPTPMap Qubit Qubit :=
  CPTPMap.of_kraus_CPTPMap (oneLevelKraus d) (oneLevelKraus_complete d)

set_option maxHeartbeats 800000 in
/-- Explicit action of the generalized-amplitude-damping channel on a qubit
matrix. -/
theorem oneLevelChannel_map_eq (d : OneLevelChannelData)
    (rho : Matrix Qubit Qubit ℂ) :
    (oneLevelChannel d).map rho =
      !![
        (((1 - d.occupation * d.damping : ℝ) : ℂ) * rho 0 0 +
          (((1 - d.occupation) * d.damping : ℝ) : ℂ) * rho 1 1),
        ((Real.sqrt d.survival : ℝ) : ℂ) * rho 0 1;
        ((Real.sqrt d.survival : ℝ) : ℂ) * rho 1 0,
        (((d.occupation * d.damping : ℝ) : ℂ) * rho 0 0 +
          ((1 - (1 - d.occupation) * d.damping : ℝ) : ℂ) * rho 1 1)
      ] := by
  have hoc : Real.sqrt (1 - d.occupation) ^ 2 = 1 - d.occupation :=
    Real.sq_sqrt (sub_nonneg.mpr d.occupation_le_one)
  have ho : Real.sqrt d.occupation ^ 2 = d.occupation :=
    Real.sq_sqrt d.occupation_nonneg
  have hd : Real.sqrt d.damping ^ 2 = d.damping :=
    Real.sq_sqrt d.damping_nonneg
  have hs : Real.sqrt d.survival ^ 2 = d.survival :=
    Real.sq_sqrt d.survival_nonneg
  have hocC : ((Real.sqrt (1 - d.occupation) : ℝ) : ℂ) ^ 2 =
      ((1 - d.occupation : ℝ) : ℂ) := by exact_mod_cast hoc
  have hoC : ((Real.sqrt d.occupation : ℝ) : ℂ) ^ 2 =
      (d.occupation : ℂ) := by exact_mod_cast ho
  have hdC : ((Real.sqrt d.damping : ℝ) : ℂ) ^ 2 =
      (d.damping : ℂ) := by exact_mod_cast hd
  have hsC : ((Real.sqrt d.survival : ℝ) : ℂ) ^ 2 =
      (d.survival : ℂ) := by exact_mod_cast hs
  have hs' : Real.sqrt (1 - d.damping) ^ 2 = 1 - d.damping :=
    Real.sq_sqrt (sub_nonneg.mpr d.damping_le_one)
  have hs'C : ((Real.sqrt (1 - d.damping) : ℝ) : ℂ) ^ 2 =
      ((1 - d.damping : ℝ) : ℂ) := by exact_mod_cast hs'
  change (∑ k, oneLevelKraus d k * rho * (oneLevelKraus d k)ᴴ) = _
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [oneLevelKraus, oneLevelKraus0, oneLevelKraus1,
      oneLevelKraus2, oneLevelKraus3, OneLevelChannelData.survival,
      Fin.sum_univ_four, Matrix.vecMul, dotProduct, Matrix.mul_apply,
      Fin.sum_univ_two]
  all_goals
    ring_nf
    simp only [hocC, hoC, hdC, hs'C]
    push_cast
    ring

/-- For a trace-one matrix, the excited-state occupation evolves by the affine
law `N' = (1-d)N + d f`. -/
theorem oneLevelChannel_excitedOccupation (d : OneLevelChannelData)
    (rho : Matrix Qubit Qubit ℂ) (htrace : rho.trace = 1) :
    (oneLevelChannel d).map rho 1 1 =
      (d.survival : ℂ) * rho 1 1 +
        ((d.damping * d.occupation : ℝ) : ℂ) := by
  rw [oneLevelChannel_map_eq]
  change
    ((d.occupation * d.damping : ℝ) : ℂ) * rho 0 0 +
        ((1 - (1 - d.occupation) * d.damping : ℝ) : ℂ) * rho 1 1 = _
  have htrace' : rho 0 0 + rho 1 1 = 1 := by
    simpa [Matrix.trace] using htrace
  calc
    ((d.occupation * d.damping : ℝ) : ℂ) * rho 0 0 +
        ((1 - (1 - d.occupation) * d.damping : ℝ) : ℂ) * rho 1 1 =
      (d.survival : ℂ) * rho 1 1 +
        ((d.damping * d.occupation : ℝ) : ℂ) * (rho 0 0 + rho 1 1) := by
          simp [OneLevelChannelData.survival]
          ring
    _ = (d.survival : ℂ) * rho 1 1 +
        ((d.damping * d.occupation : ℝ) : ℂ) := by rw [htrace', mul_one]

/-- The rate-derived finite-time one-level channel. -/
def RateData.oneLevelChannelAt (r : RateData) (t : ℝ) (ht : 0 ≤ t) :
    CPTPMap Qubit Qubit :=
  oneLevelChannel (OneLevelChannelData.ofRateTime r t ht)

/-- The rate-derived damping probability is zero at time zero. -/
@[simp]
theorem RateData.dampingProbability_zero (r : RateData) :
    r.dampingProbability 0 = 0 := by
  simp [RateData.dampingProbability]

/-- The survival factor generated by the rate equation is `exp(-2γt)`. -/
theorem OneLevelChannelData.survival_ofRateTime (r : RateData) (t : ℝ)
    (ht : 0 ≤ t) :
    (OneLevelChannelData.ofRateTime r t ht).survival =
      Real.exp (-2 * r.gamma * t) := by
  simp [OneLevelChannelData.ofRateTime, OneLevelChannelData.survival,
    RateData.dampingProbability]

/-- The rate-derived CPTP channel reproduces the exact finite-time solution
`N(t) = f + (N(0)-f) exp(-2γt)` of Eq. (37). -/
theorem RateData.oneLevelChannelAt_excitedOccupation (r : RateData)
    (t : ℝ) (ht : 0 ≤ t) (rho : Matrix Qubit Qubit ℂ)
    (htrace : rho.trace = 1) :
    (r.oneLevelChannelAt t ht).map rho 1 1 =
      (r.occupation : ℂ) +
        (rho 1 1 - (r.occupation : ℂ)) *
          Real.exp (-2 * r.gamma * t) := by
  change
    (oneLevelChannel (OneLevelChannelData.ofRateTime r t ht)).map rho 1 1 = _
  rw [oneLevelChannel_excitedOccupation _ rho htrace]
  rw [OneLevelChannelData.survival_ofRateTime]
  simp [OneLevelChannelData.ofRateTime, RateData.dampingProbability]
  ring

end LindbladDrivenLeads
end QuantumMechanics
