module

public import Physlib.QuantumMechanics.OpenSystems.LiouvilleSecondQuantization
public import Physlib.QuantumMechanics.OpenSystems.LindbladDrivenLeads.Basic
public import Mathlib.Analysis.InnerProductSpace.WeakOperatorTopology
public import Mathlib.Analysis.Calculus.Deriv.Slope
meta import Zil

/-!
# Infinite Hilbert--Schmidt kernel semigroups

This file closes the bounded continuum-generator gap between the finite-dimensional
Lindblad-driven-leads generator and the repository's genuine continuum Liouville carrier.
The carrier is

`L²(X × X, μ × μ; ℂ)`,

the Hilbert space of square-integrable density kernels.  It is infinite-dimensional whenever
the underlying measure space is; no finite matrix carrier is renamed as a continuum.

For every bounded generator on that carrier the operator exponential constructs a strongly
continuous semigroup, and its right difference quotient converges to the supplied generator.
Bounded left/right reservoir factors compose to a reservoir sandwich.  Operator-norm convergence
of generators and sandwich factors propagates to their evolutions and hence to Mathlib's genuine
weak-operator topology.  A fixed two-sided sandwich also preserves WOT convergence of its middle
operator.

The file additionally packages the existing `LinearPMap` closure of a densely-defined closable
continuum generator.  This proves that its closure is densely defined, closed, and extends the
original operator.  It deliberately does **not** claim that every such closed operator generates a
semigroup: an unbounded GKLS generator still needs an appropriate Hille--Yosida/maximal-dissipative
certificate.  Likewise, the `L²` kernel representation is not identified here with every
basis-independent Hilbert--Schmidt operator or with the trace-class state cone.
-/

@[expose] public section

noncomputable section

open Filter Set NormedSpace
open scoped Topology InnerProductSpace

namespace QuantumMechanics.LindbladDrivenLeads

variable {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-! ## Bounded-generator `C₀` semigroups -/

/-- A strongly continuous complex-linear semigroup indexed by real time.

The structure permits negative time because bounded exponentials form a group; applications that
only use positive time can restrict its laws to `0 ≤ t`. -/
structure ComplexC0Semigroup where
  operator : ℝ → K →L[ℂ] K
  operator_zero : operator 0 = ContinuousLinearMap.id ℂ K
  operator_add : ∀ s t, operator (s + t) = (operator s).comp (operator t)
  strong_continuous : ∀ x, Continuous fun t => operator t x

namespace ComplexC0Semigroup

/-- The right strong difference quotient identifies `A` as the infinitesimal generator of `S`. -/
def HasInfinitesimalGenerator (S : ComplexC0Semigroup (K := K))
    (A : K →L[ℂ] K) : Prop :=
  ∀ x, Tendsto (fun t : ℝ => t⁻¹ • (S.operator t x - x))
    (nhdsWithin 0 (Ioi 0)) (nhds (A x))

end ComplexC0Semigroup

/-- Exponential evolution generated by a bounded operator. -/
noncomputable def boundedEvolution (A : K →L[ℂ] K) (t : ℝ) : K →L[ℂ] K :=
  exp (t • A)

@[simp]
theorem boundedEvolution_zero (A : K →L[ℂ] K) :
    boundedEvolution A 0 = ContinuousLinearMap.id ℂ K := by
  change exp ((0 : ℝ) • A) = (1 : K →L[ℂ] K)
  simp

/-- The bounded exponential has the exact additive-time composition law. -/
theorem boundedEvolution_add (A : K →L[ℂ] K) (s t : ℝ) :
    boundedEvolution A (s + t) =
      (boundedEvolution A s).comp (boundedEvolution A t) := by
  haveI : NormedAlgebra ℚ (K →L[ℂ] K) := NormedAlgebra.restrictScalars ℚ ℂ _
  unfold boundedEvolution
  change exp ((s + t) • A) = exp (s • A) * exp (t • A)
  rw [add_smul,
    exp_add_of_commute (((Commute.refl A).smul_left s).smul_right t)]

/-- Every bounded exponential orbit is strongly continuous. -/
theorem boundedEvolution_continuous (A : K →L[ℂ] K) (x : K) :
    Continuous (fun t : ℝ => boundedEvolution A t x) := by
  letI : NormedAlgebra ℚ (K →L[ℂ] K) := NormedAlgebra.restrictScalars ℚ ℂ _
  apply Continuous.clm_apply
  · unfold boundedEvolution
    exact NormedSpace.exp_continuous.comp
      (continuous_id.smul continuous_const)
  · exact continuous_const

/-- Every bounded continuum generator constructs a concrete `C₀` semigroup. -/
noncomputable def boundedGeneratorC0Semigroup (A : K →L[ℂ] K) :
    ComplexC0Semigroup (K := K) where
  operator := boundedEvolution A
  operator_zero := boundedEvolution_zero A
  operator_add := boundedEvolution_add A
  strong_continuous := boundedEvolution_continuous A

/-- The right strong difference quotient of `exp(tA)` converges to `A`. -/
theorem boundedEvolution_slope_tendsto (A : K →L[ℂ] K) (x : K) :
    Tendsto (fun t : ℝ => t⁻¹ • (boundedEvolution A t x - x))
      (nhdsWithin 0 (Ioi 0)) (nhds (A x)) := by
  letI : NormedAlgebra ℝ (K →L[ℂ] K) := NormedAlgebra.restrictScalars ℝ ℂ _
  have hop : HasDerivAt (fun t : ℝ => boundedEvolution A t) A 0 := by
    unfold boundedEvolution
    simpa using (hasDerivAt_exp_smul_const' (𝕂 := ℝ) A (0 : ℝ))
  have hs := hop.tendsto_slope_zero_right
  have happ :=
    (((ContinuousLinearMap.apply ℂ K) x).continuous.continuousAt.tendsto).comp hs
  simpa [Function.comp_def, boundedEvolution_zero] using happ

/-- The supplied bounded operator is the infinitesimal generator of its exponential semigroup. -/
theorem boundedGenerator_hasInfinitesimalGenerator (A : K →L[ℂ] K) :
    (boundedGeneratorC0Semigroup A).HasInfinitesimalGenerator A := by
  intro x
  exact boundedEvolution_slope_tendsto A x

/-! ## Reservoir sandwiches -/

/-- A bounded reservoir sandwich: first apply `R`, then `L`. -/
def reservoirSandwich (L R : K →L[ℂ] K) : K →L[ℂ] K :=
  L * R

omit [CompleteSpace K] in
@[simp]
theorem reservoirSandwich_apply (L R : K →L[ℂ] K) (x : K) :
    reservoirSandwich L R x = L (R x) := rfl

/-- Exponential evolution generated by a bounded reservoir sandwich. -/
noncomputable def reservoirEvolution (L R : K →L[ℂ] K) (t : ℝ) :
    K →L[ℂ] K :=
  boundedEvolution (reservoirSandwich L R) t

/-- A bounded reservoir sandwich is the generator of its concrete `C₀` semigroup. -/
theorem reservoirEvolution_hasGenerator (L R : K →L[ℂ] K) :
    (boundedGeneratorC0Semigroup (reservoirSandwich L R)).HasInfinitesimalGenerator
      (reservoirSandwich L R) :=
  boundedGenerator_hasInfinitesimalGenerator _

/-! ## Weak-operator limit API -/

/-- View an operator-norm continuous linear map in Mathlib's weak-operator topology. -/
def toWOT (A : K →L[ℂ] K) : K →WOT[ℂ] K :=
  ContinuousLinearMapWOT.ofCLM A

omit [CompleteSpace K] in
/-- Operator-norm convergence implies weak-operator convergence. -/
theorem norm_tendsto_implies_WOT
    {ι : Type*} {l : Filter ι} {Aι : ι → K →L[ℂ] K} {A : K →L[ℂ] K}
    (h : Tendsto Aι l (nhds A)) :
    Tendsto (fun i => toWOT (Aι i)) l (nhds (toWOT A)) := by
  exact ContinuousLinearMapWOT.continuous_ofCLM.continuousAt.tendsto.comp h

/-- WOT convergence is exactly convergence of every matrix element. -/
theorem WOT_tendsto_iff_inner
    {ι : Type*} {l : Filter ι} {Aι : ι → K →L[ℂ] K} {A : K →L[ℂ] K} :
    Tendsto (fun i => toWOT (Aι i)) l (nhds (toWOT A)) ↔
      ∀ x y, Tendsto (fun i => ⟪y, Aι i x⟫_ℂ) l (nhds ⟪y, A x⟫_ℂ) := by
  exact ContinuousLinearMapWOT.tendsto_iff_forall_inner_apply_tendsto

/-- Operator-norm convergence of both reservoir factors implies convergence of the sandwich. -/
theorem reservoirSandwich_tendsto
    {ι : Type*} {l : Filter ι}
    {Lι Rι : ι → K →L[ℂ] K} {L R : K →L[ℂ] K}
    (hL : Tendsto Lι l (nhds L)) (hR : Tendsto Rι l (nhds R)) :
    Tendsto (fun i => reservoirSandwich (Lι i) (Rι i)) l
      (nhds (reservoirSandwich L R)) := by
  simpa [reservoirSandwich] using hL.mul hR

/-- Norm-convergent reservoir sandwiches converge in WOT. -/
theorem reservoirSandwich_WOT_tendsto
    {ι : Type*} {l : Filter ι}
    {Lι Rι : ι → K →L[ℂ] K} {L R : K →L[ℂ] K}
    (hL : Tendsto Lι l (nhds L)) (hR : Tendsto Rι l (nhds R)) :
    Tendsto (fun i => toWOT (reservoirSandwich (Lι i) (Rι i))) l
      (nhds (toWOT (reservoirSandwich L R))) :=
  norm_tendsto_implies_WOT (reservoirSandwich_tendsto hL hR)

/-- A fixed bounded two-sided reservoir sandwich preserves WOT convergence of its middle
operator.  This uses the Hilbert adjoint to move the fixed left factor to the test vector. -/
theorem fixed_reservoir_sandwich_WOT_tendsto
    {ι : Type*} {l : Filter ι}
    {Aι : ι → K →L[ℂ] K} {A L R : K →L[ℂ] K}
    (hA : Tendsto (fun i => toWOT (Aι i)) l (nhds (toWOT A))) :
    Tendsto (fun i => toWOT (L * Aι i * R)) l
      (nhds (toWOT (L * A * R))) := by
  rw [WOT_tendsto_iff_inner] at hA ⊢
  intro x y
  simpa only [mul_apply_eq_comp,
    ← ContinuousLinearMap.adjoint_inner_left] using hA (R x) (L.adjoint y)

/-- Operator-norm convergence of bounded generators propagates through the exponential at fixed
time. -/
theorem boundedEvolution_tendsto_of_generator
    {ι : Type*} {l : Filter ι} {Aι : ι → K →L[ℂ] K} {A : K →L[ℂ] K}
    (hA : Tendsto Aι l (nhds A)) (t : ℝ) :
    Tendsto (fun i => boundedEvolution (Aι i) t) l
      (nhds (boundedEvolution A t)) := by
  unfold boundedEvolution
  letI : NormedAlgebra ℚ (K →L[ℂ] K) := NormedAlgebra.restrictScalars ℚ ℂ _
  exact NormedSpace.exp_continuous.continuousAt.tendsto.comp
    (tendsto_const_nhds.smul hA)

/-- Simultaneous norm convergence of the generator and time parameter propagates through the
bounded exponential. -/
theorem boundedEvolution_tendsto_of_generator_time
    {ι : Type*} {l : Filter ι} {Aι : ι → K →L[ℂ] K} {A : K →L[ℂ] K}
    {tι : ι → ℝ} {t : ℝ}
    (hA : Tendsto Aι l (nhds A)) (ht : Tendsto tι l (nhds t)) :
    Tendsto (fun i => boundedEvolution (Aι i) (tι i)) l
      (nhds (boundedEvolution A t)) := by
  unfold boundedEvolution
  letI : NormedAlgebra ℚ (K →L[ℂ] K) := NormedAlgebra.restrictScalars ℚ ℂ _
  exact NormedSpace.exp_continuous.continuousAt.tendsto.comp (ht.smul hA)

/-- Norm-convergent bounded generators have WOT-convergent evolutions at fixed time. -/
theorem boundedEvolution_WOT_tendsto_of_generator
    {ι : Type*} {l : Filter ι} {Aι : ι → K →L[ℂ] K} {A : K →L[ℂ] K}
    (hA : Tendsto Aι l (nhds A)) (t : ℝ) :
    Tendsto (fun i => toWOT (boundedEvolution (Aι i) t)) l
      (nhds (toWOT (boundedEvolution A t))) :=
  norm_tendsto_implies_WOT (boundedEvolution_tendsto_of_generator hA t)

/-- Simultaneous generator/time convergence also yields WOT convergence. -/
theorem boundedEvolution_WOT_tendsto_of_generator_time
    {ι : Type*} {l : Filter ι} {Aι : ι → K →L[ℂ] K} {A : K →L[ℂ] K}
    {tι : ι → ℝ} {t : ℝ}
    (hA : Tendsto Aι l (nhds A)) (ht : Tendsto tι l (nhds t)) :
    Tendsto (fun i => toWOT (boundedEvolution (Aι i) (tι i))) l
      (nhds (toWOT (boundedEvolution A t))) :=
  norm_tendsto_implies_WOT (boundedEvolution_tendsto_of_generator_time hA ht)

/-- Norm-convergent reservoir factors have norm-convergent evolutions. -/
theorem reservoirEvolution_tendsto
    {ι : Type*} {l : Filter ι}
    {Lι Rι : ι → K →L[ℂ] K} {L R : K →L[ℂ] K}
    (hL : Tendsto Lι l (nhds L)) (hR : Tendsto Rι l (nhds R)) (t : ℝ) :
    Tendsto (fun i => reservoirEvolution (Lι i) (Rι i) t) l
      (nhds (reservoirEvolution L R t)) :=
  boundedEvolution_tendsto_of_generator (reservoirSandwich_tendsto hL hR) t

/-- Norm-convergent reservoir factors have WOT-convergent continuum evolutions. -/
theorem reservoirEvolution_WOT_tendsto
    {ι : Type*} {l : Filter ι}
    {Lι Rι : ι → K →L[ℂ] K} {L R : K →L[ℂ] K}
    (hL : Tendsto Lι l (nhds L)) (hR : Tendsto Rι l (nhds R)) (t : ℝ) :
    Tendsto (fun i => toWOT (reservoirEvolution (Lι i) (Rι i) t)) l
      (nhds (toWOT (reservoirEvolution L R t))) :=
  norm_tendsto_implies_WOT (reservoirEvolution_tendsto hL hR t)

/-! ## Genuine continuum Hilbert--Schmidt kernel specialization -/

open MeasureTheory

/-- The genuine continuum Hilbert--Schmidt kernel representation `L²(X × X)`, reusing the
Liouville second-quantization carrier. -/
abbrev InfiniteHilbertSchmidtKernel (X : Type*) [MeasurableSpace X] (μ : Measure X) :=
  LiouvilleSecondQuantization.ContinuumKernelSpace X μ

/-- Bounded generators on the continuum Hilbert--Schmidt kernel representation. -/
abbrev ContinuumHSGenerator (X : Type*) [MeasurableSpace X] (μ : Measure X) :=
  InfiniteHilbertSchmidtKernel X μ →L[ℂ] InfiniteHilbertSchmidtKernel X μ

/-- The WOT carrier for continuum Hilbert--Schmidt-kernel evolutions. -/
abbrev ContinuumHSWOT (X : Type*) [MeasurableSpace X] (μ : Measure X) :=
  InfiniteHilbertSchmidtKernel X μ →WOT[ℂ] InfiniteHilbertSchmidtKernel X μ

/-- A densely-defined closable generator on the infinite Hilbert--Schmidt kernel carrier. -/
structure ClosableContinuumHSGenerator (X : Type*) [MeasurableSpace X]
    (μ : Measure X) where
  operator :
    InfiniteHilbertSchmidtKernel X μ →ₗ.[ℂ] InfiniteHilbertSchmidtKernel X μ
  dense_domain : operator.HasDenseDomain
  closable : operator.IsClosable

namespace ClosableContinuumHSGenerator

/-- The graph closure of a closable continuum generator. -/
def closedOperator {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (A : ClosableContinuumHSGenerator X μ) :
    InfiniteHilbertSchmidtKernel X μ →ₗ.[ℂ] InfiniteHilbertSchmidtKernel X μ :=
  A.operator.closure

/-- Closure extends the original densely-defined generator. -/
theorem operator_le_closedOperator {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (A : ClosableContinuumHSGenerator X μ) :
    A.operator ≤ A.closedOperator :=
  A.operator.le_closure

/-- Graph closure preserves dense definition. -/
theorem closedOperator_hasDenseDomain {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (A : ClosableContinuumHSGenerator X μ) :
    A.closedOperator.HasDenseDomain :=
  A.dense_domain.closure

/-- The graph closure is a closed continuum generator. -/
theorem closedOperator_isClosed {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (A : ClosableContinuumHSGenerator X μ) :
    A.closedOperator.IsClosed :=
  A.closable.closure_isClosed

/-- The canonical closure simultaneously extends the original generator, remains densely
defined, and is closed. -/
theorem closedOperator_closure_certificate
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (A : ClosableContinuumHSGenerator X μ) :
    A.operator ≤ A.closedOperator ∧
      A.closedOperator.HasDenseDomain ∧ A.closedOperator.IsClosed :=
  ⟨A.operator_le_closedOperator, A.closedOperator_hasDenseDomain,
    A.closedOperator_isClosed⟩

end ClosableContinuumHSGenerator

/-- The bounded continuum reservoir generator `L ∘ R`. -/
def continuumReservoirGenerator {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) : ContinuumHSGenerator X μ :=
  reservoirSandwich L R

/-- The concrete continuum reservoir `C₀` semigroup on `L²(X × X)`. -/
noncomputable def continuumReservoirSemigroup
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) :
    ComplexC0Semigroup (K := InfiniteHilbertSchmidtKernel X μ) :=
  boundedGeneratorC0Semigroup (continuumReservoirGenerator L R)

@[simp]
theorem continuumReservoirSemigroup_zero
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) :
    (continuumReservoirSemigroup L R).operator 0 =
      ContinuousLinearMap.id ℂ (InfiniteHilbertSchmidtKernel X μ) :=
  (continuumReservoirSemigroup L R).operator_zero

/-- The infinite-kernel reservoir evolution composes at additive times. -/
theorem continuumReservoirSemigroup_add
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) (s t : ℝ) :
    (continuumReservoirSemigroup L R).operator (s + t) =
      ((continuumReservoirSemigroup L R).operator s).comp
        ((continuumReservoirSemigroup L R).operator t) :=
  (continuumReservoirSemigroup L R).operator_add s t

/-- Every infinite-kernel reservoir orbit is strongly continuous. -/
theorem continuumReservoirSemigroup_strongContinuous
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) (ρ : InfiniteHilbertSchmidtKernel X μ) :
    Continuous (fun t => (continuumReservoirSemigroup L R).operator t ρ) :=
  (continuumReservoirSemigroup L R).strong_continuous ρ

/-- The bounded reservoir sandwich is the infinitesimal generator of the concrete
infinite-dimensional continuum semigroup. -/
theorem continuumReservoirSemigroup_hasGenerator
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) :
    (continuumReservoirSemigroup L R).HasInfinitesimalGenerator
      (continuumReservoirGenerator L R) :=
  boundedGenerator_hasInfinitesimalGenerator _

/-- Norm-convergent continuum reservoir approximants converge in WOT after exponentiation. -/
theorem continuumReservoirEvolution_WOT_tendsto
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {ι : Type*} {l : Filter ι}
    {Lι Rι : ι → ContinuumHSGenerator X μ}
    {L R : ContinuumHSGenerator X μ}
    (hL : Tendsto Lι l (nhds L)) (hR : Tendsto Rι l (nhds R)) (t : ℝ) :
    Tendsto
      (fun i => toWOT ((continuumReservoirSemigroup (Lι i) (Rι i)).operator t))
      l
      (nhds (toWOT ((continuumReservoirSemigroup L R).operator t))) :=
  reservoirEvolution_WOT_tendsto hL hR t

/-- Capstone for the constructive bounded continuum closure: identity, additive composition,
strong continuity, and identification of the reservoir sandwich as generator. -/
theorem infiniteHilbertSchmidt_continuumSemigroupClosure
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (L R : ContinuumHSGenerator X μ) :
    (continuumReservoirSemigroup L R).operator 0 =
        ContinuousLinearMap.id ℂ (InfiniteHilbertSchmidtKernel X μ)
      ∧ (∀ s t, (continuumReservoirSemigroup L R).operator (s + t) =
          ((continuumReservoirSemigroup L R).operator s).comp
            ((continuumReservoirSemigroup L R).operator t))
      ∧ (∀ ρ, Continuous fun t => (continuumReservoirSemigroup L R).operator t ρ)
      ∧ (continuumReservoirSemigroup L R).HasInfinitesimalGenerator
          (continuumReservoirGenerator L R) :=
  ⟨continuumReservoirSemigroup_zero L R,
    continuumReservoirSemigroup_add L R,
    continuumReservoirSemigroup_strongContinuous L R,
    continuumReservoirSemigroup_hasGenerator L R⟩

end QuantumMechanics.LindbladDrivenLeads

end

