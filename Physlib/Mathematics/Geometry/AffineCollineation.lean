module

public import Mathlib.Algebra.Order.Archimedean.Real.Hom
public import Mathlib.LinearAlgebra.AffineSpace.AffineEquiv
import Mathlib.Tactic

/-!
# Affine reconstruction from line incidence

This file isolates the real fundamental theorem of affine geometry in the form needed by
incidence-geometric applications.  A bijection between real vector spaces of dimension at
least two which maps every complete affine line exactly onto the line through the image
endpoints is induced by an affine equivalence.

The proof first reconstructs additivity from affine parallelograms.  Incidence on every
one-dimensional subspace then produces a field endomorphism of `ℝ`; the uniqueness of real
ring endomorphisms makes that endomorphism the identity, giving real homogeneity.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.Mathematics.AffineCollineation

variable {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]

/-! # A. Affine lines and independent pairs -/

/-- The complete affine line based at `p` with direction `v`. -/
def affineLine (p v : V) : Set V := {q | ∃ a : ℝ, q = p + a • v}

/-- The complete affine plane based at `p` and generated by the ordered directions
`u` and `v`. The definition does not require the directions to be independent. -/
def affinePlane (p u v : V) : Set V :=
  {q | ∃ a b : ℝ, q = p + a • u + b • v}

/-- Two ordered vectors form an independent pair when the first is nonzero and the second
is not a scalar multiple of it. -/
def PairIndependent (x y : V) : Prop := x ≠ 0 ∧ ∀ a : ℝ, y ≠ a • x

private lemma PairIndependent.second_ne {x y : V} (h : PairIndependent x y) : y ≠ 0 := by
  intro hy
  exact h.2 0 (by simp [hy])

private lemma PairIndependent.symm {x y : V} (h : PairIndependent x y) :
    PairIndependent y x := by
  refine ⟨h.second_ne, fun a ha => ?_⟩
  by_cases ha0 : a = 0
  · subst a
    exact h.1 (by simpa using ha)
  · apply h.2 a⁻¹
    calc
      y = a⁻¹ • (a • y) := by rw [smul_smul, inv_mul_cancel₀ ha0, one_smul]
      _ = a⁻¹ • x := by rw [← ha]

private lemma PairIndependent.coefficients_eq {x y : V} (h : PairIndependent x y)
    {a b c d : ℝ} (hab : a • x + b • y = c • x + d • y) : a = c ∧ b = d := by
  have hrel : (a - c) • x = (d - b) • y := by
    calc
      (a - c) • x = (a • x + b • y) - (c • x + b • y) := by module
      _ = (c • x + d • y) - (c • x + b • y) := by rw [hab]
      _ = (d - b) • y := by module
  have hdb : d - b = 0 := by
    by_contra hdb
    apply h.2 ((d - b)⁻¹ * (a - c))
    apply smul_right_injective V hdb
    change (d - b) • y = (d - b) • (((d - b)⁻¹ * (a - c)) • x)
    rw [smul_smul, ← hrel]
    congr 1
    field_simp
  have hbd : b = d := by linarith
  have hac : a = c := by
    have hz : (a - c) • x = 0 := by rw [hrel, hdb, zero_smul]
    exact sub_eq_zero.mp ((smul_eq_zero.mp hz).resolve_right h.1)
  exact ⟨hac, hbd⟩

private lemma PairIndependent.map_of_line_images
    {f : V → W} (hf : Function.Bijective f)
    (hline : ∀ p v, v ≠ 0 →
      f '' affineLine p v = affineLine (f p) (f (p + v) - f p))
    {x y : V} (hxy : PairIndependent x y) :
    PairIndependent (f x - f 0) (f y - f 0) := by
  have hxImage : f x - f 0 ≠ 0 := sub_ne_zero.mpr (hf.1.ne hxy.1)
  refine ⟨hxImage, fun a ha => ?_⟩
  have hyMem : f y ∈ affineLine (f 0) (f x - f 0) := ⟨a, by
    calc
      f y = f 0 + (f y - f 0) := by abel
      _ = f 0 + a • (f x - f 0) := by rw [ha]⟩
  have hyImage : f y ∈ f '' affineLine 0 x := by
    rw [hline 0 x hxy.1]
    simpa only [zero_add] using hyMem
  rcases hyImage with ⟨z, ⟨b, hz⟩, hfzy⟩
  have hzy : z = y := hf.1 (hfzy.trans rfl)
  apply hxy.2 b
  rw [← hzy, hz]
  simp

/-! # B. Normalized collineations -/

omit [Module ℝ V] [Module ℝ W] in
private lemma normalized_bijective {f : V → W} (hf : Function.Bijective f) :
    Function.Bijective (fun x => f x - f 0) := by
  exact (Equiv.subRight (f 0)).bijective.comp hf

private lemma normalized_line_image
    {f : V → W}
    (hline : ∀ p v, v ≠ 0 →
      f '' affineLine p v = affineLine (f p) (f (p + v) - f p))
    (p v : V) (hv : v ≠ 0) :
    (fun x => f x - f 0) '' affineLine p v =
      affineLine (f p - f 0) ((f (p + v) - f 0) - (f p - f 0)) := by
  ext q
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hfx : f x ∈ affineLine (f p) (f (p + v) - f p) := by
      rw [← hline p v hv]
      exact ⟨x, hx, rfl⟩
    rcases hfx with ⟨a, ha⟩
    refine ⟨a, ?_⟩
    change f x - f 0 = f p - f 0 + a • (f (p + v) - f 0 - (f p - f 0))
    rw [ha]
    module
  · rintro ⟨a, ha⟩
    have htarget : q + f 0 ∈ affineLine (f p) (f (p + v) - f p) := by
      refine ⟨a, ?_⟩
      rw [ha]
      module
    rw [← hline p v hv] at htarget
    rcases htarget with ⟨x, hx, hfx⟩
    refine ⟨x, hx, ?_⟩
    change f x - f 0 = q
    rw [hfx]
    abel

omit [Module ℝ V] [Module ℝ W] in
private lemma normalized_zero (f : V → W) : f 0 - f 0 = 0 := sub_self _

private lemma mem_axis_of_line_image
    {F : V → W} (hF0 : F 0 = 0)
    (hline : ∀ p v, v ≠ 0 →
      F '' affineLine p v = affineLine (F p) (F (p + v) - F p))
    {x : V} (hx : x ≠ 0) (a : ℝ) : ∃ b : ℝ, F (a • x) = b • F x := by
  have hsource : a • x ∈ affineLine 0 x := ⟨a, by simp⟩
  have himage : F (a • x) ∈ affineLine (F 0) (F (0 + x) - F 0) := by
    rw [← hline 0 x hx]
    exact ⟨a • x, hsource, rfl⟩
  rcases himage with ⟨b, hb⟩
  refine ⟨b, ?_⟩
  simpa [hF0] using hb

private lemma image_plane_subset
    {F : V → W} (hF0 : F 0 = 0)
    (hline : ∀ p v, v ≠ 0 →
      F '' affineLine p v = affineLine (F p) (F (p + v) - F p))
    {x y : V} (hxy : PairIndependent x y)
    {z : V} (hz : ∃ a b : ℝ, z = a • x + b • y) :
    ∃ a b : ℝ, F z = a • F x + b • F y := by
  rcases hz with ⟨a, b, rfl⟩
  by_cases hz0 : a • x + b • y = 0
  · rw [hz0, hF0]
    exact ⟨0, 0, by simp⟩
  obtain ⟨ax, hax⟩ := mem_axis_of_line_image hF0 hline hxy.1 (2 * a)
  obtain ⟨ay, hay⟩ := mem_axis_of_line_image hF0 hline hxy.second_ne (2 * b)
  let p := (2 * a) • x
  let q := (2 * b) • y
  have hpq : q - p ≠ 0 := by
    intro hpq0
    have heq : q = p := sub_eq_zero.mp hpq0
    apply hxy.2 (a / b)
    by_cases hb0 : b = 0
    · subst b
      simp [q] at heq
      have ha0 : a = 0 := by
        by_contra ha0
        exact hxy.1 (smul_eq_zero.mp heq.symm |>.resolve_left (by norm_num [ha0]))
      exact (hz0 (by simp [ha0])).elim
    · have h2b : (2 * b : ℝ) ≠ 0 := by positivity
      apply smul_right_injective V h2b
      change (2 * b) • y = (2 * b) • ((a / b) • x)
      rw [smul_smul]
      have hcoef : 2 * b * (a / b) = 2 * a := by field_simp
      rw [hcoef]
      simpa [p, q] using heq
  have hmid : a • x + b • y = p + (2 : ℝ)⁻¹ • (q - p) := by
    dsimp [p, q]
    module
  have hsource : a • x + b • y ∈ affineLine p (q - p) := ⟨2⁻¹, hmid⟩
  have himage : F (a • x + b • y) ∈ affineLine (F p) (F (p + (q - p)) - F p) := by
    rw [← hline p (q - p) hpq]
    exact ⟨a • x + b • y, hsource, rfl⟩
  rcases himage with ⟨c, hc⟩
  have hp : F p = ax • F x := by simpa [p] using hax
  have hq : F q = ay • F y := by simpa [q] using hay
  refine ⟨(1 - c) * ax, c * ay, ?_⟩
  rw [hc]
  have hpq' : p + (q - p) = q := by abel
  rw [hpq', hp, hq]
  module

private lemma translated_direction_parallel
    {F : V → W} (hF0 : F 0 = 0) (hF : Function.Bijective F)
    (hline : ∀ p v, v ≠ 0 →
      F '' affineLine p v = affineLine (F p) (F (p + v) - F p))
    {x y : V} (hxy : PairIndependent x y) :
    ∃ a : ℝ, F (x + y) - F x = a • F y := by
  obtain ⟨a, b, hab⟩ := image_plane_subset hF0 hline hxy
    (z := x + y) ⟨1, 1, by simp⟩
  have hx0 : F x ≠ 0 := by
    rw [← hF0]
    exact hF.1.ne hxy.1
  by_cases ha1 : a = 1
  · refine ⟨b, ?_⟩
    rw [hab, ha1, one_smul]
    abel
  · exfalso
    let r := -((a - 1)⁻¹ * b)
    let s := -(a - 1)⁻¹
    have hintersect : r • F y = F x + s • (F (x + y) - F x) := by
      have ha0 : a - 1 ≠ 0 := sub_ne_zero.mpr ha1
      have hxcoef : 1 + s * (a - 1) = 0 := by
        dsimp [s]
        field_simp
        ring
      have hycoef : s * b = r := by
        dsimp [r, s]
        ring
      rw [hab]
      calc
        r • F y = (0 : ℝ) • F x + r • F y := by simp
        _ = (1 + s * (a - 1)) • F x + (s * b) • F y := by
          rw [hxcoef, hycoef]
        _ = F x + s • (a • F x + b • F y - F x) := by module
    have hrMem : r • F y ∈ affineLine 0 (F y) := ⟨r, by simp⟩
    have hsMem : F x + s • (F (x + y) - F x) ∈
        affineLine (F x) (F (x + y) - F x) := ⟨s, rfl⟩
    have hrImage : r • F y ∈ F '' affineLine 0 y := by
      have : r • F y ∈ affineLine (F 0) (F (0 + y) - F 0) := by
        simpa [hF0] using hrMem
      simpa only [zero_add] using (hline 0 y hxy.second_ne).symm ▸ this
    have hsImage : F x + s • (F (x + y) - F x) ∈ F '' affineLine x y := by
      exact (hline x y hxy.second_ne).symm ▸ hsMem
    rcases hrImage with ⟨u, hu, hFu⟩
    rcases hsImage with ⟨v, hv, hFv⟩
    have huv : u = v := hF.1 (hFu.trans (hintersect.trans hFv.symm))
    rcases hu with ⟨c, huc⟩
    rcases hv with ⟨d, hvd⟩
    apply hxy.symm.2 (c - d)
    rw [huc, hvd] at huv
    calc
      x = (x + d • y) - d • y := by abel
      _ = (0 + c • y) - d • y := by rw [← huv]
      _ = (c - d) • y := by module

private lemma add_of_pairIndependent
    {F : V → W} (hF0 : F 0 = 0) (hF : Function.Bijective F)
    (hline : ∀ p v, v ≠ 0 →
      F '' affineLine p v = affineLine (F p) (F (p + v) - F p))
    {x y : V} (hxy : PairIndependent x y) : F (x + y) = F x + F y := by
  obtain ⟨a, ha⟩ := translated_direction_parallel hF0 hF hline hxy
  obtain ⟨b, hb⟩ := translated_direction_parallel hF0 hF hline hxy.symm
  have himage : PairIndependent (F x) (F y) := by
    simpa [hF0] using PairIndependent.map_of_line_images hF hline hxy
  have ha' : F (x + y) = F x + a • F y := by
    calc
      F (x + y) = F x + (F (x + y) - F x) := by abel
      _ = F x + a • F y := by rw [ha]
  have hb' : F (x + y) = b • F x + F y := by
    calc
      F (x + y) = F (y + x) := by rw [add_comm]
      _ = F y + (F (y + x) - F y) := by abel
      _ = F y + b • F x := by rw [hb]
      _ = b • F x + F y := by abel
  have heq : (1 : ℝ) • F x + a • F y = b • F x + (1 : ℝ) • F y := by
    simpa only [one_smul] using ha'.symm.trans hb'
  have hcoeff := himage.coefficients_eq heq
  rw [ha', hcoeff.2, one_smul]

private lemma exists_independent_auxiliary
    (hDim : ∃ u v : V, PairIndependent u v) {x : V} (hx : x ≠ 0) :
    ∃ z : V, PairIndependent x z := by
  rcases hDim with ⟨u, v, huv⟩
  by_cases hxu : ∃ a : ℝ, u = a • x
  · rcases hxu with ⟨a, ha⟩
    refine ⟨v, hx, fun b hb => ?_⟩
    apply huv.2 (b / a)
    have ha0 : a ≠ 0 := by
      intro ha0
      subst a
      exact huv.1 (by simpa using ha)
    rw [ha, hb, smul_smul]
    congr 1
    field_simp
  · exact ⟨u, hx, fun a ha => hxu ⟨a, ha⟩⟩

private lemma add_of_line_images
    {F : V → W} (hF0 : F 0 = 0) (hF : Function.Bijective F)
    (hDim : ∃ u v : V, PairIndependent u v)
    (hline : ∀ p v, v ≠ 0 →
      F '' affineLine p v = affineLine (F p) (F (p + v) - F p)) :
    ∀ x y, F (x + y) = F x + F y := by
  have hneg : ∀ x : V, F (-x) = -F x := by
    intro x
    by_cases hx : x = 0
    · subst x
      simp [hF0]
    obtain ⟨z, hxz⟩ := exists_independent_auxiliary hDim hx
    have hxzAdd := add_of_pairIndependent hF0 hF hline hxz
    have hpair : PairIndependent (-x) (x + z) := by
      refine ⟨neg_ne_zero.mpr hx, fun a ha => hxz.2 (-(a + 1)) ?_⟩
      calc
        z = (x + z) - x := by abel
        _ = a • (-x) - x := by rw [ha]
        _ = -(a + 1) • x := by module
    have hpairAdd := add_of_pairIndependent hF0 hF hline hpair
    have hsum : -x + (x + z) = z := by abel
    rw [hsum, hxzAdd] at hpairAdd
    have hcancel : F (-x) + F x + F z = 0 + F z := by
      simpa [add_assoc] using hpairAdd.symm
    exact eq_neg_of_add_eq_zero_left (add_right_cancel hcancel)
  intro x y
  by_cases hx : x = 0
  · subst x
    simp [hF0]
  by_cases hy : y = 0
  · subst y
    simp [hF0]
  by_cases hxy : PairIndependent x y
  · exact add_of_pairIndependent hF0 hF hline hxy
  have hyx : ∃ a : ℝ, y = a • x := by
    simpa [PairIndependent, hx] using
      not_forall.mp (not_and_or.mp hxy |>.resolve_left (not_not.mpr hx))
  rcases hyx with ⟨a, rfl⟩
  by_cases ha : 1 + a = 0
  · have hax : a • x = -x := by
      have : a = -1 := by linarith
      rw [this, neg_one_smul]
    rw [hax]
    simp [hF0, hneg]
  · obtain ⟨z, hxz⟩ := exists_independent_auxiliary hDim hx
    have haz : PairIndependent (a • x) z := by
      have ha0 : a ≠ 0 := by
        intro ha0
        subst a
        exact hy (by simp)
      refine ⟨smul_ne_zero ha0 hx, fun b hb => hxz.2 (b * a) ?_⟩
      simpa only [smul_smul] using hb
    have hsumz : PairIndependent ((1 + a) • x) z := by
      refine ⟨smul_ne_zero ha hx, fun b hb => hxz.2 (b * (1 + a)) ?_⟩
      simpa only [smul_smul] using hb
    have hxy_z := add_of_pairIndependent hF0 hF hline hsumz
    have hx_az : PairIndependent x (a • x + z) := by
      refine ⟨hx, fun b hb => hxz.2 (b - a) ?_⟩
      calc
        z = (a • x + z) - a • x := by abel
        _ = b • x - a • x := by rw [hb]
        _ = (b - a) • x := by module
    have hxaz := add_of_pairIndependent hF0 hF hline hx_az
    have hazAdd := add_of_pairIndependent hF0 hF hline haz
    rw [hazAdd] at hxaz
    have hsame : x + (a • x + z) = (1 + a) • x + z := by module
    rw [hsame, hxy_z] at hxaz
    have hleft : F ((1 + a) • x) = F (x + a • x) := by congr 1; module
    rw [hleft] at hxaz
    exact add_right_cancel (by simpa [add_assoc] using hxaz)

/-! # C. Fundamental theorem over the real numbers -/

/-- **Fundamental theorem of real affine geometry, line-image form.**  A bijection between
real vector spaces of dimension at least two which maps each complete affine line exactly
onto the line through the corresponding image endpoints is represented by an affine
equivalence. -/
theorem exists_affineEquiv_of_affineLine_images
    {f : V → W} (hf : Function.Bijective f)
    (hDim : ∃ u v : V, PairIndependent u v)
    (hline : ∀ p v, v ≠ 0 →
      f '' affineLine p v = affineLine (f p) (f (p + v) - f p)) :
    ∃ e : V ≃ᵃ[ℝ] W, ∀ x, e x = f x := by
  let F : V → W := fun x => f x - f 0
  have hF0 : F 0 = 0 := normalized_zero f
  have hF : Function.Bijective F := normalized_bijective hf
  have hFline : ∀ p v, v ≠ 0 →
      F '' affineLine p v = affineLine (F p) (F (p + v) - F p) :=
    normalized_line_image hline
  have hFadd : ∀ x y, F (x + y) = F x + F y :=
    add_of_line_images hF0 hF hDim hFline
  have hFsmul : ∀ a : ℝ, ∀ x : V, F (a • x) = a • F x := by
    intro a x
    by_cases hx : x = 0
    · subst x
      simp [hF0]
    obtain ⟨u, hxu⟩ := exists_independent_auxiliary hDim hx
    let σ : ℝ → ℝ := fun r => Classical.choose (mem_axis_of_line_image hF0 hFline hx r)
    have hσ (r : ℝ) : F (r • x) = σ r • F x :=
      Classical.choose_spec (mem_axis_of_line_image hF0 hFline hx r)
    have hσindependent : ∀ {y : V}, PairIndependent x y → ∀ r : ℝ,
        F (r • y) = σ r • F y := by
      intro y hxy r
      obtain ⟨c, hc⟩ := mem_axis_of_line_image hF0 hFline hxy.second_ne r
      obtain ⟨d, hd⟩ := mem_axis_of_line_image hF0 hFline
        (show x + y ≠ 0 by
          intro h
          apply hxy.2 (-1)
          calc y = -x := eq_neg_of_add_eq_zero_right h
            _ = (-1 : ℝ) • x := by simp) r
      have hscaled := hFadd (r • x) (r • y)
      have hbase := hFadd x y
      have heq : d • F x + d • F y = σ r • F x + c • F y := by
        have hscaled' : F (r • (x + y)) = F (r • x) + F (r • y) := by
          rw [smul_add]
          exact hscaled
        rw [hd, hbase, hσ, hc] at hscaled'
        simpa [smul_add] using hscaled'
      have himage : PairIndependent (F x) (F y) := by
        simpa [hF0] using PairIndependent.map_of_line_images hF hFline hxy
      have hcoeff := himage.coefficients_eq heq
      rw [hc, ← hcoeff.2, hcoeff.1]
    have hσu (r : ℝ) : F (r • u) = σ r • F u := hσindependent hxu r
    have hσadd (r s : ℝ) : σ (r + s) = σ r + σ s := by
      have h := hFadd (r • x) (s • x)
      rw [← add_smul, hσ, hσ, hσ] at h
      apply smul_left_injective ℝ (show F x ≠ 0 by
        rw [← hF0]
        exact hF.1.ne hx)
      simpa [add_smul] using h
    have hσone : σ 1 = 1 := by
      have h := hσ 1
      apply smul_left_injective ℝ (show F x ≠ 0 by rw [← hF0]; exact hF.1.ne hx)
      simpa only [one_smul] using h.symm
    have hσmul (r s : ℝ) : σ (r * s) = σ r * σ s := by
      have hxsu : PairIndependent x (s • x + u) := by
        refine ⟨hx, fun a ha => hxu.2 (a - s) ?_⟩
        calc
          u = (s • x + u) - s • x := by abel
          _ = a • x - s • x := by rw [ha]
          _ = (a - s) • x := by module
      have hz := hσindependent hxsu r
      have heq : σ (r * s) • F x + σ r • F u =
          (σ r * σ s) • F x + σ r • F u := by
        rw [smul_add, smul_smul, hFadd, hσ, hσu] at hz
        rw [hFadd, hσ, smul_add, smul_smul] at hz
        exact hz
      have himage : PairIndependent (F x) (F u) := by
        simpa [hF0] using PairIndependent.map_of_line_images hF hFline hxu
      exact (himage.coefficients_eq heq).1
    let σHom : ℝ →+* ℝ :=
      { toFun := σ
        map_one' := hσone
        map_mul' := hσmul
        map_zero' := by simpa using hσadd 0 0
        map_add' := hσadd }
    rw [hσ]
    change σHom a • F x = a • F x
    rw [Real.ringHom_apply]
  let L : V →ₗ[ℝ] W :=
    { toFun := F
      map_add' := hFadd
      map_smul' := hFsmul }
  have hL : Function.Bijective L := hF
  let E : V ≃ₗ[ℝ] W := LinearEquiv.ofBijective L hL
  let e : V ≃ᵃ[ℝ] W := E.toAffineEquiv.trans (AffineEquiv.constVAdd ℝ W (f 0))
  refine ⟨e, fun x => ?_⟩
  simp [e, E, L, F]

end Physlib.Mathematics.AffineCollineation
