module

public import Physlib.Mathematics.LovelockRund.ContinuumVariational
public import Physlib.QFT.Wick.Consistency

/-!
# Complex variational residuals and entropic time

This module packages the real and imaginary first-variation equations of a
complex action into one pointwise complex Euler--Lagrange residual. It also
identifies the imaginary residual divided by `hbar` as the local entropic-time
gradient.

The key distinction is explicit:

* stationarity of the complex action requires both real and imaginary
  Euler--Lagrange residuals to vanish;
* the imaginary residual controls the derivative of entropic time;
* the modulus of the pointwise complex-action weight is
  `exp (-E_I / hbar)`.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.Mathematics.LovelockRund

open Physlib.QFT.Wick.Consistency

variable {d : ℕ}

/-- Pointwise complex Euler--Lagrange residual `E_R + i E_I`. -/
def complexEulerLagrange
    (eulerRe eulerIm : Space d → ℝ) : Space d → ℂ :=
  fun x => (eulerRe x : ℂ) + Complex.I * (eulerIm x : ℂ)

/-- The complex Euler--Lagrange residual vanishes at a point exactly when its
real and imaginary residuals both vanish there. -/
theorem complexEulerLagrange_apply_eq_zero_iff
    (eulerRe eulerIm : Space d → ℝ) (x : Space d) :
    complexEulerLagrange eulerRe eulerIm x = 0 ↔
      eulerRe x = 0 ∧ eulerIm x = 0 := by
  constructor
  · intro h
    have hre := congrArg Complex.re h
    have him := congrArg Complex.im h
    simp [complexEulerLagrange] at hre him
    exact ⟨hre, him⟩
  · rintro ⟨hre, him⟩
    simp [complexEulerLagrange, hre, him]

/-- Functional vanishing of the complex residual is equivalent to functional
vanishing of both components. -/
theorem complexEulerLagrange_eq_zero_iff
    (eulerRe eulerIm : Space d → ℝ) :
    complexEulerLagrange eulerRe eulerIm = 0 ↔
      eulerRe = 0 ∧ eulerIm = 0 := by
  constructor
  · intro h
    constructor
    · funext x
      exact (complexEulerLagrange_apply_eq_zero_iff
        eulerRe eulerIm x).mp (congrFun h x) |>.1
    · funext x
      exact (complexEulerLagrange_apply_eq_zero_iff
        eulerRe eulerIm x).mp (congrFun h x) |>.2
  · rintro ⟨hre, him⟩
    funext x
    exact (complexEulerLagrange_apply_eq_zero_iff
      eulerRe eulerIm x).mpr
      ⟨congrFun hre x, congrFun him x⟩

/-- Weak stationarity of a complex action means weak stationarity of both its
real and imaginary variational gradients. -/
def IsComplexWeakExtremal
    (eulerRe eulerIm : Space d → ℝ) : Prop :=
  IsWeakExtremal eulerRe ∧ IsWeakExtremal eulerIm

/-- For continuous residuals, complex weak stationarity is equivalent to the
pointwise complex Euler--Lagrange equation. -/
theorem isComplexWeakExtremal_iff_complexEulerLagrange_eq_zero
    (eulerRe eulerIm : Space d → ℝ)
    (hRe : Continuous eulerRe) (hIm : Continuous eulerIm) :
    IsComplexWeakExtremal eulerRe eulerIm ↔
      complexEulerLagrange eulerRe eulerIm = 0 := by
  unfold IsComplexWeakExtremal
  rw [isWeakExtremal_iff_eq_zero eulerRe hRe,
    isWeakExtremal_iff_eq_zero eulerIm hIm,
    complexEulerLagrange_eq_zero_iff]

/-- Local entropic-time gradient generated by the imaginary Euler--Lagrange
residual. -/
def entropicTimeGradient
    (eulerIm : Space d → ℝ) (hbar : ℝ) : Space d → ℝ :=
  fun x => eulerIm x / hbar

/-- For nonzero `hbar`, vanishing entropic-time gradient is equivalent to
stationarity of the imaginary action. -/
theorem entropicTimeGradient_apply_eq_zero_iff
    (eulerIm : Space d → ℝ) (hbar : ℝ) (hhbar : hbar ≠ 0)
    (x : Space d) :
    entropicTimeGradient eulerIm hbar x = 0 ↔ eulerIm x = 0 := by
  unfold entropicTimeGradient
  constructor
  · intro h
    exact (div_eq_zero_iff.mp h).resolve_right hhbar
  · intro h
    simp [h]

/-- Functional form of the same equivalence. -/
theorem entropicTimeGradient_eq_zero_iff
    (eulerIm : Space d → ℝ) (hbar : ℝ) (hhbar : hbar ≠ 0) :
    entropicTimeGradient eulerIm hbar = 0 ↔ eulerIm = 0 := by
  constructor
  · intro h
    funext x
    exact (entropicTimeGradient_apply_eq_zero_iff
      eulerIm hbar hhbar x).mp (congrFun h x)
  · intro h
    funext x
    exact (entropicTimeGradient_apply_eq_zero_iff
      eulerIm hbar hhbar x).mpr (congrFun h x)

/-- Pointwise complex-action weight associated with the two variational
residuals. -/
def variationalComplexWeight
    (eulerRe eulerIm : Space d → ℝ) (hbar : ℝ) : Space d → ℂ :=
  fun x => complexActionWeight (eulerRe x) (eulerIm x) hbar

/-- The modulus of the variational complex weight is the exponential of minus
the local entropic-time gradient. -/
theorem norm_variationalComplexWeight
    (eulerRe eulerIm : Space d → ℝ) (hbar : ℝ) (x : Space d) :
    ‖variationalComplexWeight eulerRe eulerIm hbar x‖ =
      Real.exp (-(entropicTimeGradient eulerIm hbar x)) := by
  unfold variationalComplexWeight entropicTimeGradient
  exact norm_complexActionWeight (eulerRe x) (eulerIm x) hbar

end Physlib.Mathematics.LovelockRund

end
