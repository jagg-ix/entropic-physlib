module

public import Physlib.ClassicalMechanics.HamiltonsEquations
public import Physlib.QFT.Wick.Consistency

/-!
# Hamilton--Jacobi equations and complex action

This module formalizes the Hamilton--Jacobi layer developed in
Lovelock--Rund Section 6.2.  The configuration space `Q` is an arbitrary real
Hilbert space and therefore may be infinite dimensional.

For a Hamiltonian `H(t,q,p)` and principal function `S(t,q)`, the residual is

`∂ₜS + H(t,q,∇S)`.

The module also records a split complex-action version.  Its real and
imaginary residuals must vanish separately, while the imaginary residual
scaled by `1 / hbar` is the local Hamilton--Jacobi entropic-time rate.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace Physlib.Mathematics.LovelockRund

open InnerProductSpace
open Physlib.QFT.Wick.Consistency

variable {Q : Type*}
  [NormedAddCommGroup Q] [InnerProductSpace ℝ Q] [CompleteSpace Q]

/-- Momentum field generated by Hamilton's principal function. -/
def hamiltonJacobiMomentum
    (S : ℝ → Q → ℝ) (t : ℝ) (q : Q) : Q :=
  gradient (S t) q

/-- Time-dependent Hamilton--Jacobi residual
`∂ₜS + H(t,q,∇S)`. -/
def hamiltonJacobiResidual
    (H : ℝ → Q → Q → ℝ)
    (S : ℝ → Q → ℝ) : ℝ → Q → ℝ :=
  fun t q =>
    deriv (fun τ => S τ q) t +
      H t q (hamiltonJacobiMomentum S t q)

/-- Pointwise expansion of the Hamilton--Jacobi residual. -/
theorem hamiltonJacobiResidual_apply
    (H : ℝ → Q → Q → ℝ)
    (S : ℝ → Q → ℝ) (t : ℝ) (q : Q) :
    hamiltonJacobiResidual H S t q =
      deriv (fun τ => S τ q) t +
        H t q (gradient (S t) q) :=
  rfl

/-- A principal function solves the Hamilton--Jacobi equation when the
residual vanishes identically. -/
def IsHamiltonJacobiSolution
    (H : ℝ → Q → Q → ℝ)
    (S : ℝ → Q → ℝ) : Prop :=
  hamiltonJacobiResidual H S = 0

/-- Pointwise characterization of the Hamilton--Jacobi equation. -/
theorem isHamiltonJacobiSolution_iff
    (H : ℝ → Q → Q → ℝ)
    (S : ℝ → Q → ℝ) :
    IsHamiltonJacobiSolution H S ↔
      ∀ t q,
        deriv (fun τ => S τ q) t =
          -H t q (gradient (S t) q) := by
  constructor
  · intro h t q
    have hx := congrFun (congrFun h t) q
    unfold hamiltonJacobiResidual at hx
    dsimp [hamiltonJacobiMomentum] at hx
    linarith
  · intro h
    funext t q
    unfold hamiltonJacobiResidual
    dsimp [hamiltonJacobiMomentum]
    linarith [h t q]

/-- Stationary Hamilton--Jacobi residual `H(q,∇W)-E`. -/
def stationaryHamiltonJacobiResidual
    (H : Q → Q → ℝ) (W : Q → ℝ) (energy : ℝ) : Q → ℝ :=
  fun q => H q (gradient W q) - energy

/-- Pointwise stationary Hamilton--Jacobi equation. -/
theorem stationaryHamiltonJacobiResidual_eq_zero_iff
    (H : Q → Q → ℝ) (W : Q → ℝ) (energy : ℝ) :
    stationaryHamiltonJacobiResidual H W energy = 0 ↔
      ∀ q, H q (gradient W q) = energy := by
  constructor
  · intro h q
    have hq := congrFun h q
    simpa [stationaryHamiltonJacobiResidual, sub_eq_zero] using hq
  · intro h
    funext q
    simp [stationaryHamiltonJacobiResidual, h q]

/-- Split complex Hamilton--Jacobi residual.  This represents a complex action
whose real and imaginary sectors are supplied independently. -/
def splitComplexHamiltonJacobiResidual
    (HRe HIm : ℝ → Q → Q → ℝ)
    (SRe SIm : ℝ → Q → ℝ) : ℝ → Q → ℂ :=
  fun t q =>
    (hamiltonJacobiResidual HRe SRe t q : ℂ) +
      Complex.I * (hamiltonJacobiResidual HIm SIm t q : ℂ)

/-- The split complex Hamilton--Jacobi equation vanishes at a point exactly
when both real equations vanish there. -/
theorem splitComplexHamiltonJacobiResidual_apply_eq_zero_iff
    (HRe HIm : ℝ → Q → Q → ℝ)
    (SRe SIm : ℝ → Q → ℝ) (t : ℝ) (q : Q) :
    splitComplexHamiltonJacobiResidual HRe HIm SRe SIm t q = 0 ↔
      hamiltonJacobiResidual HRe SRe t q = 0 ∧
        hamiltonJacobiResidual HIm SIm t q = 0 := by
  constructor
  · intro h
    have hre := congrArg Complex.re h
    have him := congrArg Complex.im h
    simp [splitComplexHamiltonJacobiResidual] at hre him
    exact ⟨hre, him⟩
  · rintro ⟨hre, him⟩
    simp [splitComplexHamiltonJacobiResidual, hre, him]

/-- Functional vanishing of the split complex residual is equivalent to
functional vanishing of the two real residuals. -/
theorem splitComplexHamiltonJacobiResidual_eq_zero_iff
    (HRe HIm : ℝ → Q → Q → ℝ)
    (SRe SIm : ℝ → Q → ℝ) :
    splitComplexHamiltonJacobiResidual HRe HIm SRe SIm = 0 ↔
      hamiltonJacobiResidual HRe SRe = 0 ∧
        hamiltonJacobiResidual HIm SIm = 0 := by
  constructor
  · intro h
    constructor
    · funext t q
      exact (splitComplexHamiltonJacobiResidual_apply_eq_zero_iff
        HRe HIm SRe SIm t q).mp (congrFun (congrFun h t) q) |>.1
    · funext t q
      exact (splitComplexHamiltonJacobiResidual_apply_eq_zero_iff
        HRe HIm SRe SIm t q).mp (congrFun (congrFun h t) q) |>.2
  · rintro ⟨hre, him⟩
    funext t q
    exact (splitComplexHamiltonJacobiResidual_apply_eq_zero_iff
      HRe HIm SRe SIm t q).mpr
      ⟨congrFun (congrFun hre t) q, congrFun (congrFun him t) q⟩

/-- Entropic-time rate generated by the imaginary Hamilton--Jacobi residual. -/
def hamiltonJacobiEntropicRate
    (HIm : ℝ → Q → Q → ℝ)
    (SIm : ℝ → Q → ℝ) (hbar : ℝ) : ℝ → Q → ℝ :=
  fun t q => hamiltonJacobiResidual HIm SIm t q / hbar

/-- For nonzero `hbar`, a zero entropic-time rate is equivalent to the
imaginary Hamilton--Jacobi equation. -/
theorem hamiltonJacobiEntropicRate_eq_zero_iff
    (HIm : ℝ → Q → Q → ℝ)
    (SIm : ℝ → Q → ℝ) (hbar : ℝ) (hhbar : hbar ≠ 0) :
    hamiltonJacobiEntropicRate HIm SIm hbar = 0 ↔
      hamiltonJacobiResidual HIm SIm = 0 := by
  constructor
  · intro h
    funext t q
    have htq := congrFun (congrFun h t) q
    exact (div_eq_zero_iff.mp htq).resolve_right hhbar
  · intro h
    funext t q
    simp [hamiltonJacobiEntropicRate,
      congrFun (congrFun h t) q]

/-- Complex-action weight built from the real and imaginary Hamilton--Jacobi
residuals. -/
def hamiltonJacobiComplexWeight
    (HRe HIm : ℝ → Q → Q → ℝ)
    (SRe SIm : ℝ → Q → ℝ) (hbar : ℝ) : ℝ → Q → ℂ :=
  fun t q => complexActionWeight
    (hamiltonJacobiResidual HRe SRe t q)
    (hamiltonJacobiResidual HIm SIm t q) hbar

/-- The modulus of the Hamilton--Jacobi complex weight is the exponential of
minus the entropic rate. -/
theorem norm_hamiltonJacobiComplexWeight
    (HRe HIm : ℝ → Q → Q → ℝ)
    (SRe SIm : ℝ → Q → ℝ) (hbar : ℝ)
    (t : ℝ) (q : Q) :
    ‖hamiltonJacobiComplexWeight HRe HIm SRe SIm hbar t q‖ =
      Real.exp (-(hamiltonJacobiEntropicRate HIm SIm hbar t q)) := by
  unfold hamiltonJacobiComplexWeight hamiltonJacobiEntropicRate
  exact norm_complexActionWeight
    (hamiltonJacobiResidual HRe SRe t q)
    (hamiltonJacobiResidual HIm SIm t q) hbar

/-- Existing Hamilton equations are exposed as the trajectory equation paired
with Hamilton--Jacobi theory. -/
theorem hamiltonEqOp_zero_iff
    {Q₀ : Type} [NormedAddCommGroup Q₀] [InnerProductSpace ℝ Q₀]
    [CompleteSpace Q₀]
    (H : Time → Q₀ → Q₀ → ℝ)
    (p q : Time → Q₀) :
    ClassicalMechanics.hamiltonEqOp H p q = 0 ↔
      (∀ t, Time.deriv q t =
        gradient (fun x => H t x (q t)) (p t)) ∧
      (∀ t, Time.deriv p t =
        -gradient (fun x => H t (p t) x) (q t)) :=
  ClassicalMechanics.hamiltonEqOp_eq_zero_iff_hamiltons_equations H p q

end Physlib.Mathematics.LovelockRund

end
